---
import Layout from '../layouts/Layout.astro';
import { honoraires, site, parrainage } from '../data/site';

const tableaux = [
  { titre: 'Mandat de vente, honoraires à la charge du vendeur', lignes: honoraires.vente },
  { titre: "Mandat de recherche, honoraires à la charge de l'acquéreur", lignes: honoraires.chasse },
  { titre: 'Mandat de gestion, honoraires à la charge du bailleur', lignes: honoraires.gestion },
];
---
<Layout
  titre="Honoraires maximum | Trudaines, agence immobilière Paris"
  description="Barème maximum des honoraires de Trudaines : mandat de vente, mandat de recherche, gestion locative. Montants TTC et charge du paiement indiquée."
  filAriane={[{ nom: 'Honoraires' }]}
>
  <section class="section pt-10">
    <div class="conteneur max-w-3xl">
      <p class="surtitre">Honoraires</p>
      <h1 class="titre-1 mt-6">Nos honoraires : un plafond, pas un tarif</h1>
      <p class="chapo mt-8">
        Les taux ci-dessous sont des maximums. Celui de votre mandat se fixe avec vous, après l'estimation : il peut
        être inférieur, jamais supérieur. Rien n'est dû tant que la vente, l'achat ou la location n'est pas signé.
      </p>
      <p class="mt-6 text-sm text-[color:var(--color-ardoise)]">
        Barème maximum au sens de l'arrêté du 26 janvier 2022. En mandat exclusif, le plafond de chaque tranche baisse
        d'un point. Le taux retenu figure en toutes lettres dans le mandat, toutes taxes comprises.
      </p>
    </div>
  </section>

  <section class="section pt-0">
    <div class="conteneur">
      {tableaux.map((t) => (
        <div class="mb-16">
          <h2 class="titre-2">{t.titre}</h2>
          <div class="mt-8 overflow-x-auto">
            <table class="w-full border-collapse text-left text-sm">
              <thead>
                <tr class="border-b border-[color:var(--color-encre)]">
                  <th scope="col" class="py-4 pr-6 font-semibold">Tranche</th>
                  {t.lignes.some((l) => l.exclusif) && <th scope="col" class="py-4 pr-6 font-semibold">Mandat exclusif, au plus</th>}
                  <th scope="col" class="py-4 pr-6 font-semibold">{t.lignes.some((l) => l.exclusif) ? 'Mandat simple, au plus' : 'Honoraires, au plus'}</th>
                  <th scope="col" class="py-4 font-semibold">Minimum</th>
                </tr>
              </thead>
              <tbody>
                {t.lignes.map((l) => (
                  <tr class="border-b border-[color:var(--color-trait)]">
                    <th scope="row" class="py-4 pr-6 font-medium">{l.tranche}</th>
                    {t.lignes.some((ligne) => ligne.exclusif) && <td class="py-4 pr-6">{l.exclusif}</td>}
                    <td class="py-4 pr-6">{l.taux}</td>
                    <td class="py-4 text-[color:var(--color-ardoise)]">{l.minimum ?? 'Sans minimum'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}

      <div class="max-w-3xl border-t border-[color:var(--color-trait)] pt-8 text-sm text-[color:var(--color-ardoise)]">
        <p>
          Les honoraires de vente sont calculés sur le prix de vente hors honoraires. Lorsqu'ils sont à la charge de
          l'acquéreur, le prix affiché dans l'annonce est indiqué honoraires inclus et hors honoraires, conformément
          à la réglementation.
        </p>
        <p class="mt-4">
          Vous connaissez quelqu'un qui vend, achète ou loue ? Avec {parrainage.nom}, {Math.round(parrainage.part * 100)} % de nos
          honoraires hors taxes vous reviennent.{' '}
          <a href="/recommander" class="lien-souligne">Calculer votre prime</a>.
        </p>
        <p class="mt-4">
          {site.nomLong}, {site.legal.rcs}. Carte professionnelle {site.legal.carteT}. Garantie financière
          {' '}{site.legal.garantie}, {site.legal.garantieMontant}. {site.legal.detentionFonds}
          {' '}Médiateur de la consommation : {site.legal.mediateur.nom}, {site.legal.mediateur.adresse},{' '}
          <a href={site.legal.mediateur.site} class="lien-souligne" rel="noopener">{site.legal.mediateur.libelleSite}</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>
