---
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import { honoraires, site, parrainage } from '../data/site';
import { bareme, honorairesTTC, pourcent, fourchetteVente } from '../lib/bareme';
import { faqEnDonnees, phraseHonoraires } from '../lib/agence';
import { nombre } from '../lib/format';

/* Exemples calculés sur le barème, jamais recopiés : ils suivent toute modification de site.ts. */
const exemples = [500000, 900000, 2000000].map((prix) => ({
  prix,
  exclusif: honorairesTTC(prix, bareme.venteExclusif) ?? 0,
  simple: honorairesTTC(prix, bareme.venteSimple) ?? 0,
}));
const euros = (valeur: number) => `${nombre(Math.round(valeur))} €`;

const reponseCourte = `Chez Trudaines, les honoraires de vente vont de ${pourcent(fourchetteVente.min, ' ')} à ${pourcent(fourchetteVente.max, ' ')} TTC du prix de vente selon la tranche et le type de mandat : ${phraseHonoraires} Rien n'est dû si la vente ne se fait pas, et l'estimation écrite d'un bien à vendre est offerte.`;

const faq = [
  { question: 'Combien coûte une agence immobilière pour vendre à Paris ?', reponse: reponseCourte },
  {
    question: 'Combien paie-t-on d’honoraires pour un appartement vendu 500 000 €, 900 000 € ou 2 000 000 € ?',
    reponse: `Au barème maximum de Trudaines : ${exemples.map((e) => `${euros(e.prix)} vendus donnent ${euros(e.exclusif)} TTC en mandat exclusif et ${euros(e.simple)} TTC en mandat simple`).join(' ; ')}. Le taux inscrit au mandat peut être inférieur.`,
  },
  {
    question: 'Les honoraires d’agence se négocient-ils ?',
    reponse: `Oui. Le barème affiché est un plafond au sens de l'arrêté du 26 janvier 2022 : l'agence peut pratiquer moins, jamais plus. Le taux retenu se fixe après l'estimation, en fonction du bien et du mandat, et figure en toutes lettres, toutes taxes comprises, dans le mandat signé.`,
  },
  {
    question: 'Quand les honoraires sont-ils payés ?',
    reponse: `À la signature de l'acte authentique chez le notaire, prélevés sur le prix de vente. Aucun acompte, aucun frais de dossier, aucune somme due si le bien ne se vend pas. Seul l'avis de valeur établi pour un acte de donation, de succession ou de partage est facturé, ${honoraires.avisDeValeur[0].taux.toLowerCase()}.`,
  },
  {
    question: 'Combien coûte un mandat de recherche pour acheter à Paris ?',
    reponse: `De ${honoraires.chasse[0].taux.replace(" du prix d'achat", '')} jusqu'à 400 000 € à ${honoraires.chasse[4].taux.replace(" du prix d'achat", '')} entre 1 600 001 € et 2 500 000 € du prix d'achat, à la charge de l'acquéreur, dus uniquement à la signature de l'acte. Au-delà de 2 500 000 €, le taux est arrêté au mandat.`,
  },
  {
    question: 'Combien coûte la gestion locative chez Trudaines ?',
    reponse: `${honoraires.gestion[0].taux}, à la charge du bailleur, sans minimum. Les loyers encaissés sont couverts par une garantie financière de ${site.legal.garantieMontant} auprès de ${site.legal.garantie.split(',')[0]}.`,
  },
];

const tableaux = [
  { titre: 'Mandat de vente, honoraires à la charge du vendeur', lignes: honoraires.vente },
  { titre: "Mandat de recherche, honoraires à la charge de l'acquéreur", lignes: honoraires.chasse },
  { titre: 'Mandat de gestion, honoraires à la charge du bailleur', lignes: honoraires.gestion },
  { titre: 'Avis de valeur pour un acte, à la charge du demandeur', lignes: honoraires.avisDeValeur },
];
---
<Layout
  titre="Honoraires maximum | Trudaines, agence immobilière Paris"
  description="Barème maximum des honoraires de Trudaines : vente, recherche, gestion locative, avis de valeur pour un acte. Montants TTC et charge du paiement indiquée."
  filAriane={[{ nom: 'Honoraires' }]}
  donnees={[faqEnDonnees(faq)]}
>
  <section class="section pt-10">
    <div class="conteneur max-w-3xl">
      <p class="surtitre">Honoraires</p>
      <h1 class="titre-1 mt-6">Nos honoraires : un plafond, pas un tarif</h1>
      <p class="chapo mt-8">
        Les taux ci-dessous sont des maximums. Celui de votre mandat se fixe avec vous, après l'estimation : il peut
        être inférieur, jamais supérieur. Rien n'est dû tant que la vente, l'achat ou la location n'est pas signé, à l'exception de l'avis de valeur établi pour un acte de donation ou de succession. L'estimation d'un bien que vous envisagez de vendre reste offerte.
      </p>
      {/* La réponse en une fois, calculée sur le barème : c'est elle qu'un assistant reprend. */}
      <p class="mt-6" id="reponse-courte">{reponseCourte}</p>
      <p class="mt-6 text-sm text-[color:var(--color-ardoise)]">
        Barème maximum au sens de l'arrêté du 26 janvier 2022. En mandat exclusif, le plafond de chaque tranche baisse
        d'un point. Le taux retenu figure en toutes lettres dans le mandat, toutes taxes comprises.
      </p>
    </div>
  </section>

  <section class="section pt-0">
    <div class="conteneur">
      {tableaux.map((t) => (
        <div class="mb-16">
          <h2 class="titre-2">{t.titre}</h2>
          <div class="mt-8 overflow-x-auto">
            <table class="w-full border-collapse text-left text-sm">
              <thead>
                <tr class="border-b border-[color:var(--color-encre)]">
                  <th scope="col" class="py-4 pr-6 font-semibold">Tranche</th>
                  {t.lignes.some((l) => l.exclusif) && <th scope="col" class="py-4 pr-6 font-semibold">Mandat exclusif, au plus</th>}
                  <th scope="col" class="py-4 pr-6 font-semibold">{t.lignes.some((l) => l.exclusif) ? 'Mandat simple, au plus' : 'Honoraires, au plus'}</th>
                  <th scope="col" class="py-4 font-semibold">Minimum</th>
                </tr>
              </thead>
              <tbody>
                {t.lignes.map((l) => (
                  <tr class="border-b border-[color:var(--color-trait)]">
                    <th scope="row" class="py-4 pr-6 font-medium">{l.tranche}</th>
                    {t.lignes.some((ligne) => ligne.exclusif) && <td class="py-4 pr-6">{l.exclusif}</td>}
                    <td class="py-4 pr-6">{l.taux}</td>
                    <td class="py-4 text-[color:var(--color-ardoise)]">{l.minimum ?? 'Sans minimum'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}

      <div class="max-w-3xl border-t border-[color:var(--color-trait)] pt-8 text-sm text-[color:var(--color-ardoise)]">
        <p>
          Les honoraires de vente sont calculés sur le prix de vente hors honoraires. Lorsqu'ils sont à la charge de
          l'acquéreur, le prix affiché dans l'annonce est indiqué honoraires inclus et hors honoraires, conformément
          à la réglementation.
        </p>
        <p class="mt-4">
          Vous connaissez quelqu'un qui vend, achète ou loue ? Avec {parrainage.nom}, {Math.round(parrainage.part * 100)} % de nos
          honoraires hors taxes vous reviennent.{' '}
          <a href="/recommander" class="lien-souligne">Calculer votre prime</a>.
        </p>
        <p class="mt-4">
          {site.nomLong}, {site.legal.rcs}. Carte professionnelle {site.legal.carteT}. Garantie financière
          {' '}{site.legal.garantie}, {site.legal.garantieMontant}. {site.legal.detentionFonds}
          {' '}Médiateur de la consommation : {site.legal.mediateur.nom}, {site.legal.mediateur.adresse},{' '}
          <a href={site.legal.mediateur.site} class="lien-souligne" rel="noopener">{site.legal.mediateur.libelleSite}</a>.
        </p>
      </div>
    </div>
  </section>

  <Faq questions={faq} titre="Questions sur les honoraires" />
</Layout>
