---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { dateFr, cabinet } from '../data/site';

const retombees = (await getCollection('presse'))
  .filter((p) => p.data.publie)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base
  title="La presse parle de Trudaines | Retombées et citations"
  description="Les articles de presse consacrés au cabinet Trudaines et à son fondateur Samy Santamarina, avec les citations et les liens vers les publications d'origine."
  ariane={[{ nom: 'Presse', url: '/presse' }]}
>
  <section class="border-b border-ligne">
    <div class="conteneur py-16 lg:py-20">
      <p class="surtitre">Presse</p>
      <h1 class="mt-6 max-w-3xl text-3xl leading-tight lg:text-4xl">Ce que la presse écrit sur le cabinet</h1>
      <p class="mt-6 max-w-2xl text-lg text-gris">
        Les citations reproduites ici sont extraites telles quelles des articles d'origine, avec le lien pour les lire en entier.
      </p>
    </div>
  </section>

  <section class="conteneur py-16 lg:py-24">
    {retombees.length > 0 ? (
      <div class="divide-y divide-ligne border-t border-ligne">
        {retombees.map((p) => (
          <article class="grid gap-8 py-10 lg:grid-cols-[200px_1fr]">
            <div>
              {p.data.logo && <img src={p.data.logo} alt={p.data.media} width="140" height="32" loading="lazy" class="h-8 w-auto" />}
              <p class="mt-3 text-sm text-gris">{dateFr(p.data.date)}</p>
            </div>
            <div>
              <h2 class="text-xl">{p.data.titre}</h2>
              <blockquote class="mt-4 border-l-2 border-encre pl-6 font-titre text-lg">{p.data.citation}</blockquote>
              {p.data.lien && (
                <p class="mt-4"><a href={p.data.lien} rel="noopener" target="_blank" class="lien-souligne text-sm">Lire l'article sur {p.data.media}</a></p>
              )}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="border border-ligne p-10">
        <h2 class="text-xl">Espace presse</h2>
        <p class="mt-4 max-w-2xl text-gris">
          Journalistes, pour toute demande d'interview, de chiffre de marché sur le 9e nord ou de visuel,
          écrivez à <a href={`mailto:${cabinet.email}`} class="lien-souligne">{cabinet.email}</a> ou appelez le
          <a href={`tel:${cabinet.telephoneLien}`} class="lien-souligne" data-evenement="clic_telephone"> {cabinet.telephone}</a>.
          Nous répondons le jour même.
        </p>
      </div>
    )}
  </section>
</Base>
