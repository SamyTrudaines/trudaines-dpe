---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { dateFr } from '../lib/format';

const presse = (await getCollection('presse')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Layout
  titre="Presse | Trudaines, cabinet immobilier Paris 9e et Montmartre"
  description="Les retombées presse du cabinet Trudaines et de son fondateur Samy Santamarina : interviews, citations et analyses du marché parisien."
  filAriane={[{ nom: 'Presse' }]}
>
  <section class="section pt-10">
    <div class="conteneur max-w-3xl">
      <p class="surtitre">Presse</p>
      <h1 class="titre-1 mt-6">Ils ont parlé de Trudaines</h1>
      <p class="chapo mt-8">
        Interviews, citations et analyses de marché. Pour toute demande presse, écrivez directement au fondateur.
      </p>
    </div>
  </section>

  <section class="section pt-0">
    <div class="conteneur">
      {presse.length === 0 ? (
        <p class="text-[color:var(--color-ardoise)]">Les retombées presse seront publiées ici.</p>
      ) : (
        <ul class="divide-y divide-[color:var(--color-trait)] border-y border-[color:var(--color-trait)]">
          {presse.map((p) => (
            <li class="grid gap-6 py-10 md:grid-cols-[180px_1fr] md:items-start">
              <div>
                {p.data.logo ? (
                  <img src={p.data.logo} alt={p.data.media} width="160" height="48" loading="lazy" decoding="async" class="h-12 w-auto object-contain object-left" />
                ) : (
                  <p class="font-[family-name:var(--font-titre)] text-lg">{p.data.media}</p>
                )}
                <p class="mt-3 text-xs uppercase tracking-[0.12em] text-[color:var(--color-ardoise)]">{dateFr(p.data.date)}</p>
              </div>
              <div>
                <h2 class="titre-3">{p.data.titre}</h2>
                {p.data.citation && (
                  <blockquote class="mt-4 border-l-2 border-[color:var(--color-nuit)] pl-6 font-[family-name:var(--font-titre)] text-lg">
                    {p.data.citation}
                  </blockquote>
                )}
                {p.data.signature && (
                  <p class="mt-3 text-sm text-[color:var(--color-ardoise)]">{p.data.signature}</p>
                )}
                {p.data.photo && (
                  <figure class="mt-6">
                    <img
                      src={p.data.photo}
                      alt={p.data.photoAlt || p.data.titre}
                      width="620"
                      height="349"
                      loading="lazy"
                      decoding="async"
                      class="w-full max-w-xl"
                    />
                    {p.data.credit && (
                      <figcaption class="mt-2 text-xs text-[color:var(--color-ardoise)]">{p.data.credit}</figcaption>
                    )}
                  </figure>
                )}
                {p.data.audio && (
                  <div class="mt-6 max-w-xl">
                    <audio controls preload="none" class="w-full" src={p.data.audio}>
                      Votre navigateur ne lit pas l'audio.{' '}
                      <a href={p.data.ecouter || p.data.lien}>Écouter l'épisode sur le site du média</a>.
                    </audio>
                    <p class="mt-2 text-xs text-[color:var(--color-ardoise)]">
                      Épisode produit par {p.data.media}. Écoute mise à disposition avec la source, l'émission
                      complète est sur le site du média.
                    </p>
                  </div>
                )}
                <p class="mt-5 flex flex-wrap gap-x-8 gap-y-2 text-sm">
                  {p.data.ecouter && (
                    <a href={p.data.ecouter} rel="noopener" target="_blank" data-evt="clic_podcast" class="lien-souligne">
                      Écouter l'épisode{p.data.duree ? `, ${p.data.duree}` : ''}
                    </a>
                  )}
                  {p.data.lien && p.data.lien !== p.data.ecouter && (
                    <a href={p.data.lien} rel="noopener" target="_blank" class="lien-souligne">Lire l'article sur {p.data.media}</a>
                  )}
                </p>
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Layout>
