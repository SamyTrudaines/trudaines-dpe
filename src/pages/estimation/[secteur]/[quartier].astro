---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import CadreMoulure from '../../../components/CadreMoulure.astro';
import FormulaireEstimation from '../../../components/FormulaireEstimation.astro';
import BoutonCreneau from '../../../components/BoutonCreneau.astro';
import Faq from '../../../components/Faq.astro';
import Avis from '../../../components/Avis.astro';
import { avisCommentés, agrégatAvis, trierAvis } from '../../../lib/avis';
import { secteurs } from '../../../data/secteurs';
import { estimationsQuartiers, type EstimationQuartier } from '../../../data/estimations-quartiers';
import { distance, memeVoie, position, ruesDuQuartier, type Point } from '../../../lib/quartiers';
import { rues, periode, type Rue } from '../../../lib/rues';
import { prix, nombre } from '../../../lib/format';
import { evt } from '../../../lib/entonnoir';
import { arrondissementParCodePostal, donneesDeRattachement, lieuEnDonnees, rattachementsEstimations } from '../../../data/lieux';

/**
 * Estimation d'un quartier : textes dans src/data/estimations-quartiers.ts,
 * prix tirés des ventes de rues.json, rues retenues par la zone du quartier
 * publié ou par distance au centre de ses voies repères.
 */
interface Props { page: EstimationQuartier }

export const getStaticPaths: GetStaticPaths = () =>
  estimationsQuartiers.map((page) => ({ params: { secteur: page.secteur, quartier: page.slug }, props: { page } }));

const { page } = Astro.props;
const secteur = secteurs.find((s) => s.slug === page.secteur)!;
const arrondissement = secteur.nom.replace('Paris ', '');

function ruesDeLaPage(p: EstimationQuartier): Rue[] {
  if (p.zone) return ruesDuQuartier(p.zone);
  const points = (p.reperes ?? []).map((slug) => rues.find((r) => r.slug === slug)).map((r) => (r ? position(r) : null)).filter((x): x is Point => x !== null);
  if (!points.length) throw new Error(`[estimation] ${p.slug} : aucune voie repère géocodée`);
  const centre = { lon: points.reduce((s, x) => s + x.lon, 0) / points.length, lat: points.reduce((s, x) => s + x.lat, 0) / points.length };
  return rues.filter((r) => {
    const point = position(r);
    return r.codePostal === p.codePostal && point !== null && distance(point, centre) <= (p.rayon ?? 450);
  });
}

const brutes = ruesDeLaPage(page);
/* Une voie écrite de deux façons dans la base foncière ne compte qu'une fois : on garde la série la plus fournie. */
const liste = brutes.filter((r) => !memeVoie(r).some((autre) => brutes.includes(autre) && (autre.ventes > r.ventes || (autre.ventes === r.ventes && autre.slug < r.slug))));
if (liste.length < 3) throw new Error(`[estimation] ${page.slug} : ${liste.length} voies mesurées, trop peu pour publier`);

const ventes = liste.reduce((s, r) => s + r.ventes, 0);
/* Médiane pondérée : la médiane de voie au rang de la moitié des ventes, voies classées par prix. */
const parPrix = [...liste].sort((a, b) => a.mediane - b.mediane);
let cumul = 0;
const mediane = parPrix.find((r) => (cumul += r.ventes) >= ventes / 2)!.mediane;
const moinsChere = parPrix[0];
const plusChere = parPrix[parPrix.length - 1];
const tableau = [...liste].sort((a, b) => b.ventes - a.ventes).slice(0, 12);

const titre = `Estimation immobilière ${page.nom}, ${secteur.nom} | Trudaines`;
const description = `Estimation gratuite ${page.dans}, ${secteur.nom} : ${prix(Math.round(mediane / 10) * 10)} le m² médian sur ${nombre(ventes)} ventes signées. Avis de valeur écrit sous 48 h.`;

const faq = [
  {
    question: `Quel est le prix au mètre carré ${page.dans} ?`,
    reponse: `Sur les ${liste.length} voies que nous mesurons ${page.dans}, ${nombre(ventes)} ventes d'appartements ont été signées de ${periode}. La médiane pondérée par les ventes ressort à ${prix(Math.round(mediane / 10) * 10)} le mètre carré. Selon la rue, elle va de ${prix(moinsChere.mediane)} (${moinsChere.nom}) à ${prix(plusChere.mediane)} (${plusChere.nom}).`,
  },
  {
    question: 'Comment estimez-vous mon appartement ?',
    reponse: "Nous partons des ventes signées dans votre rue et dans les rues voisines, publiées par l'administration fiscale, puis nous visitons. L'étage, la lumière, l'état, la copropriété et le plan ajustent le prix. Vous recevez un avis de valeur écrit sous 48 heures, qui explique chaque ajustement.",
  },
  {
    question: "L'estimation m'engage-t-elle ?",
    reponse: "Non. L'estimation et l'avis de valeur sont gratuits et sans engagement. Vous gardez le document, même si vous vendez plus tard ou avec une autre agence.",
  },
];

const avis = trierAvis((await avisCommentés()).filter((a) => !a.data.secteur || a.data.secteur === secteur.slug)).slice(0, 3);
const agregat = await agrégatAvis();
const voisines = estimationsQuartiers.filter((q) => q.slug !== page.slug);

const donnees = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((q) => ({ '@type': 'Question', name: q.question, acceptedAnswer: { '@type': 'Answer', text: q.reponse } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Estimation immobilière ${page.nom}, ${secteur.nom}`,
    serviceType: 'Estimation immobilière',
    provider: { '@id': 'https://www.trudaines.com/#agence' },
    areaServed: {
      '@type': 'Place',
      name: `${page.nom}, ${secteur.nomLong}`,
      ...(arrondissementParCodePostal[page.codePostal] ? { containedInPlace: lieuEnDonnees(arrondissementParCodePostal[page.codePostal]) } : {}),
      ...donneesDeRattachement(rattachementsEstimations[page.slug] ?? {}),
    },
  },
];
---
<Layout
  titre={titre}
  description={description}
  filAriane={[{ nom: 'Estimation', href: '/estimation' }, { nom: secteur.nom, href: `/estimation/${secteur.slug}` }, { nom: page.nom }]}
  donnees={donnees}
>
  <CadreMoulure enTete>
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-start">
      <div>
        <p class="surtitre">Estimation · {secteur.nom} · {page.nom}</p>
        <h1 class="titre-1 mt-6">Estimation immobilière {page.nom}, {secteur.nom}</h1>
        <p class="chapo mt-8">{page.chapo}</p>
        <div class="mt-10 border-t border-[color:var(--color-encre)] pt-6">
          <p class="surtitre">Ventes signées {page.dans}</p>
          <p class="mt-3 text-lg">{prix(Math.round(mediane / 10) * 10)} le m², médiane pondérée</p>
          <p class="mt-2 text-sm text-[color:var(--color-ardoise)]">
            {nombre(ventes)} ventes d'appartements sur {liste.length} voies, de {periode}.
          </p>
        </div>
        <BoutonCreneau
          class="mt-10"
          evt={evt('estimation', 'creneau', page.slug)}
          intro="Vous préférez choisir le jour et l'heure de la visite d'estimation ?"
        />
      </div>
      <FormulaireEstimation
        secteur={secteur.slug}
        quartier={page.nom}
        identifiant={`estimation-${page.slug}`}
        origine={`Estimation ${page.nom}, ${secteur.nom}`}
      />
    </div>
  </CadreMoulure>

  <section class="section filet" aria-labelledby="methode">
    <div class="conteneur max-w-3xl">
      <h2 id="methode" class="titre-2">Ce qui fait le prix {page.dans}</h2>
      {page.paragraphes.map((p) => <p class="mt-6">{p}</p>)}
    </div>
  </section>

  <section class="section filet" aria-labelledby="prix-des-rues">
    <div class="conteneur">
      <h2 id="prix-des-rues" class="titre-2">Prix des rues {page.dans}</h2>
      <p class="mt-4 text-sm text-[color:var(--color-ardoise)]">
        Médianes des ventes d'appartements de {periode}, base des valeurs foncières (DVF). Les voies les plus actives.
      </p>
      <table class="mt-8 w-full text-left text-sm">
        <thead>
          <tr class="border-b border-[color:var(--color-encre)]">
            <th class="py-3 font-normal">Rue</th>
            <th class="py-3 text-right font-normal">Prix médian au m²</th>
            <th class="py-3 text-right font-normal">Ventes</th>
          </tr>
        </thead>
        <tbody>
          {tableau.map((r) => (
            <tr class="border-b border-[color:var(--color-trait)]">
              <td class="py-3"><a href={`/prix-immobilier/${r.slug}`}>{r.nom}</a></td>
              <td class="py-3 text-right">{prix(r.mediane)}</td>
              <td class="py-3 text-right">{r.ventes}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <Faq questions={faq} titre={`Questions des vendeurs ${page.dans}`} />

  <Avis avis={avis} agregat={agregat} titre="Des ventes racontées par leurs propriétaires" />

  <section class="section filet" aria-labelledby="ailleurs">
    <div class="conteneur">
      <h2 id="ailleurs" class="titre-2">Continuer</h2>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        <a href={`/estimation/${secteur.slug}`} class="bloc no-underline">
          <span class="titre-3 block">Estimation {secteur.nom}</span>
          <span class="mt-3 block text-sm text-[color:var(--color-ardoise)]">Tout le {arrondissement}</span>
        </a>
        <a href={page.lien.href} class="bloc no-underline">
          <span class="titre-3 block">{page.lien.libelle}</span>
        </a>
        {voisines.map((q) => (
          <a href={`/estimation/${q.secteur}/${q.slug}`} class="bloc no-underline">
            <span class="titre-3 block">Estimation {q.nom}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
