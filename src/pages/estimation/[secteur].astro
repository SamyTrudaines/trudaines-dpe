---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CadreMoulure from '../../components/CadreMoulure.astro';
import FormulaireEstimation from '../../components/FormulaireEstimation.astro';
import BoutonCreneau from '../../components/BoutonCreneau.astro';
import TableauPrix from '../../components/TableauPrix.astro';
import PrixParTaille from '../../components/PrixParTaille.astro';
import Faq from '../../components/Faq.astro';
import Avis from '../../components/Avis.astro';
import { avisCommentés, agrégatAvis, preuveAvis, trierAvis } from '../../lib/avis';
import { secteurs, fourchetteSecteur, type Secteur } from '../../data/secteurs';
import { estimationsQuartiers } from '../../data/estimations-quartiers';
import { mesureQuartier } from '../../lib/estimation-quartier';
import { arrondissements, periode, libellePieces, millesime, rues } from '../../lib/rues';
import { prix, nombre, dateFr } from '../../lib/format';
import { evt } from '../../lib/entonnoir';
const preuve = await preuveAvis();

interface Props { secteur: Secteur }

export const getStaticPaths: GetStaticPaths = () =>
  secteurs.map((s) => ({ params: { secteur: s.slug }, props: { secteur: s } }));

const { secteur } = Astro.props;
/* Le prix médian dans l'extrait Google : un chiffre vérifiable fait cliquer plus qu'une promesse. */
const chiffres = arrondissements[secteur.arrondissement];
const tousQuartiers = await getCollection('quartiers');
const quartiers = tousQuartiers
  .filter((q) => secteur.quartiers.includes(q.id))
  .sort((a, b) => a.data.ordre - b.data.ordre);
const avisSecteur = trierAvis(
  (await avisCommentés()).filter((a) => !a.data.secteur || a.data.secteur === secteur.slug),
).slice(0, 3);
const agregatAvis = await agrégatAvis();
/* Les quartiers visés d'abord : ce sont eux que les vendeurs cherchent (Search Console). */
const PRIORITE = ['montmartre', 'trudaine-maubeuge', 'martyrs-lorette', 'batignolles', 'clichy-trinite', 'saint-georges', 'abbesses', 'lamarck', 'pigalle'];
const rang = (slug: string) => (PRIORITE.includes(slug) ? PRIORITE.indexOf(slug) : PRIORITE.length);
const pagesQuartiers = estimationsQuartiers.filter((q) => q.secteur === secteur.slug).sort((a, b) => rang(a.slug) - rang(b.slug));
const autresSecteurs = secteurs.filter((s) => s.slug !== secteur.slug);

/* Prix selon la taille : la question que posent les vendeurs, et les assistants pour eux. */
const typologies = chiffres?.typologies ?? [];
const taille = (pieces: number) => typologies.find((t) => t.pieces === pieces);
const deux = taille(2);
const trois = taille(3);
const reponseCourte = chiffres
  ? `À ${secteur.nom}, les appartements se sont vendus ${prix(chiffres.mediane)} le m² en médiane, sur ${nombre(chiffres.ventes)} ventes signées de ${periode} (base DVF de la DGFiP).${
      deux && trois
        ? ` Un deux pièces de ${deux.surface} m² s'est vendu autour de ${prix(deux.prix)}, un trois pièces de ${trois.surface} m² autour de ${prix(trois.prix)}.`
        : ''
    } Trudaines estime votre appartement en ligne en moins d'une minute, ou par un avis de valeur écrit après visite, remis sous 48 heures, gratuit et sans engagement.`
  : '';
const faqTailles = typologies.length > 1
  ? [
      {
        question: `Combien vaut un appartement à ${secteur.nom} selon sa taille ?`,
        reponse: `Sur les ventes signées de ${periode} : ${typologies
          .map((t) => `${libellePieces(t.pieces).toLowerCase()}, ${t.surface} m² et ${prix(t.prix)} en médiane (${prix(t.mediane)} le m², ${nombre(t.ventes)} ventes)`)
          .join(' ; ')}. Votre rue, l'étage, l'ascenseur et l'état du bien déplacent ce prix : l'estimation le précise pour votre adresse.`,
      },
      ...(deux
        ? [
            {
              question: `Quel est le prix d'un deux pièces à ${secteur.nom} ?`,
              reponse: `Les ${nombre(deux.ventes)} deux pièces vendus de ${periode} mesurent ${deux.surface} m² en médiane et se sont vendus ${prix(deux.prix)} en médiane, soit ${prix(deux.mediane)} le m². Les petites surfaces se vendent plus cher au mètre carré quand elles sont en étage, lumineuses et sans travaux.`,
            },
          ]
        : []),
    ]
  : [];
const faqQuartiers = pagesQuartiers.length > 1
  ? [{
      question: `Quel est le prix au m² selon le quartier du ${secteur.nom.replace('Paris ', '')} ?`,
      reponse: `Médiane des ventes d'appartements signées de ${periode}, voies pondérées par leurs ventes : ${pagesQuartiers
        .map((q) => {
          const m = mesureQuartier(q);
          return `${q.nom}, ${prix(Math.round(m.mediane / 10) * 10)} sur ${nombre(m.ventes)} ventes`;
        })
        .join(' ; ')}. Chaque quartier a sa page d'estimation, avec le prix de ses rues.`,
    }]
  : [];
const faq = [...faqTailles, ...faqQuartiers, ...secteur.faq];

/* Cartes « estimer par quartier » et rues les plus vendues de l'arrondissement : un clic vers la page la plus proche du bien. */
const cartesQuartiers = pagesQuartiers.map((q) => ({ page: q, mesure: mesureQuartier(q) }));
const ruesPlusVendues = rues
  .filter((r) => r.codePostal === secteur.arrondissement)
  .sort((a, b) => b.ventes - a.ventes)
  .slice(0, 15);
/* Trois quartiers au plus dans la description : au-delà, Google la coupe. */
const nomsQuartiers = pagesQuartiers.slice(0, 3).map((q) => q.nom).join(', ');

const donnees = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((q) => ({
      '@type': 'Question',
      name: q.question,
      acceptedAnswer: { '@type': 'Answer', text: q.reponse },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Estimation immobilière ${secteur.nom}`,
    serviceType: 'Estimation immobilière',
    provider: { '@id': 'https://www.trudaines.com/#agence' },
    areaServed: { '@type': 'AdministrativeArea', name: secteur.nomLong },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR', description: "Estimation en ligne immédiate, ou avis de valeur écrit remis après visite sous 48 heures, sans engagement" },
  },
];
---
<Layout
  ancreEstimation={`#estimation-${secteur.slug}`}
  titre={secteur.titre}
  description={chiffres
    ? `Estimation immobilière gratuite à ${secteur.nom} : ${prix(chiffres.mediane)} le m² sur ${nombre(chiffres.ventes)} ventes signées.${nomsQuartiers ? ` ${nomsQuartiers}.` : ''} En ligne ou après visite.`
    : `${secteur.description} ${preuve}`}
  filAriane={[{ nom: 'Estimation', href: '/estimation' }, { nom: secteur.nom }]}
  donnees={donnees}
>
  <CadreMoulure enTete>
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-start">
      <div>
        <p class="surtitre">Estimation · {secteur.arrondissement}</p>
        <h1 class="titre-1 mt-6">Estimation immobilière {secteur.nom}</h1>
        {reponseCourte && <p class="mt-6 max-w-2xl" id="reponse-courte">{reponseCourte}</p>}
        {/* Sur téléphone, le formulaire vient après le texte : un accès direct, sans défiler. */}
        <a href={`#estimation-${secteur.slug}`} class="bouton mt-6 lg:hidden" data-evt={evt('estimation', 'formulaire', secteur.slug)}>Estimer mon appartement</a>
        <p class="chapo mt-8">{secteur.intro}</p>
        <div class="mt-10 border-t border-[color:var(--color-encre)] pt-6">
          <p class="surtitre">Niveau de prix constaté</p>
          {/* Chiffres recalculés à chaque mise à jour de rues.json, jamais recopiés à la main. */}
          <p class="mt-3 text-lg">{chiffres ? `${prix(chiffres.mediane)} le m², prix médian` : secteur.prixMoyen}</p>
          <p class="mt-2 text-sm text-[color:var(--color-ardoise)]">
            {chiffres
              ? `${prix(chiffres.d1)} à ${prix(chiffres.d9)} le m², du premier au neuvième décile des ${nombre(chiffres.ventes)} ventes d'appartements signées de ${periode}`
              : secteur.fourchette}
            {chiffres && <> Base parue le <time datetime={millesime}>{dateFr(new Date(millesime))}</time>.</>}
          </p>
        </div>
        {pagesQuartiers.length > 0 && (
          <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
            <span class="text-[color:var(--color-ardoise)]">Par quartier :</span>
            {pagesQuartiers.map((q) => (
              <a href={`/estimation/${q.secteur}/${q.slug}`} class="lien-souligne">{q.nom}</a>
            ))}
          </p>
        )}
        <p class="mt-8 text-sm text-[color:var(--color-ardoise)]">
          Estimation appartement {secteur.nom}, estimation maison et immeuble, vente maison {secteur.nom} :
          la méthode est la même, seule la base de comparaison change.
        </p>
        <BoutonCreneau
          class="mt-10"
          evt={evt('estimation', 'creneau', secteur.slug)}
          intro="Vous préférez choisir le jour et l'heure de la visite d'estimation ?"
        />
      </div>
      <FormulaireEstimation secteur={secteur.slug} identifiant={`estimation-${secteur.slug}`} />
    </div>
  </CadreMoulure>

  <TableauPrix quartiers={quartiers} codePostal={secteur.arrondissement} titre={`Prix par quartier dans le ${secteur.nom.replace('Paris ', '')}`} />

  {cartesQuartiers.length > 0 && (
    <section class="section filet" aria-labelledby="par-quartier">
      <div class="conteneur">
        <h2 id="par-quartier" class="titre-2">Estimer votre appartement par quartier</h2>
        <p class="mt-4 max-w-2xl text-[color:var(--color-ardoise)]">
          Le {secteur.nom.replace('Paris ', '')} change de valeur d'une rue à l'autre. Choisissez votre quartier pour voir les ventes signées autour de chez vous et estimer votre appartement.
        </p>
        <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {cartesQuartiers.map(({ page: q, mesure }) => (
            <li>
              <a href={`/estimation/${q.secteur}/${q.slug}`} class="bloc block no-underline" data-evt={evt('estimation', 'quartier', q.slug)}>
                <span class="titre-3 block">{q.nom}</span>
                <span class="mt-3 block">{prix(Math.round(mesure.mediane / 10) * 10)} le m², médiane</span>
                <span class="mt-1 block text-sm text-[color:var(--color-ardoise)]">{nombre(mesure.ventes)} ventes signées sur {mesure.liste.length} voies</span>
                <span class="lien-souligne mt-4 inline-block text-sm">Estimer à {q.nom}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-10 text-sm">
          <span class="text-[color:var(--color-ardoise)]">Les rues les plus vendues : </span>
          {ruesPlusVendues.map((r, i) => (
            <>{i > 0 && ' · '}<a href={`/prix-immobilier/${r.slug}`} class="lien-souligne">{r.nom}</a></>
          ))}
        </p>
      </div>
    </section>
  )}

  <PrixParTaille
    typologies={typologies}
    titre={`Prix d'un appartement selon sa taille dans le ${secteur.nom.replace('Paris ', '')}`}
    source={`Toutes les ventes d'appartements de l'arrondissement, par nombre de pièces.`}
  />

  <Faq questions={faq} titre={`Questions des vendeurs du ${secteur.nom.replace('Paris ', '')}`} />

  <Avis avis={avisSecteur} agregat={agregatAvis} titre="Des ventes racontées par leurs propriétaires" />

  <nav class="section filet" aria-labelledby="ailleurs">
    <div class="conteneur">
      <p id="ailleurs" class="titre-2">Continuer</p>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {pagesQuartiers.map((q) => (
          <a href={`/estimation/${q.secteur}/${q.slug}`} class="bloc no-underline">
            <span class="titre-3 block">Estimation {q.nom}</span>
            <span class="mt-3 block text-sm text-[color:var(--color-ardoise)]">Les ventes signées {q.dans}</span>
          </a>
        ))}
        <a href={secteur.hrefAgence} class="bloc no-underline">
          <span class="titre-3 block">Agence immobilière {secteur.nom}</span>
          <span class="mt-3 block text-sm text-[color:var(--color-ardoise)]">Qui nous sommes sur ce secteur</span>
        </a>
        {autresSecteurs.map((s) => (
          <a href={`/estimation/${s.slug}`} class="bloc no-underline">
            <span class="titre-3 block">Estimation {s.nom}</span>
            <span class="mt-3 block text-sm text-[color:var(--color-ardoise)]">{fourchetteSecteur(s.arrondissement)}</span>
          </a>
        ))}
      </div>
    </div>
  </nav>
</Layout>
