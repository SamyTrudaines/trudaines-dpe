---
import { evt } from '../../lib/entonnoir';
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import FormulaireVisite from '../../components/FormulaireVisite.astro';
import FormulaireFiche from '../../components/FormulaireFiche.astro';
import GalerieBien from '../../components/GalerieBien.astro';
import CarteBien from '../../components/CarteBien.astro';
import AlerteExpress from '../../components/AlerteExpress.astro';
import { secteurs } from '../../data/secteurs';
import { prix, prixAffiche, nombre, prixM2, libelleStatut, lieuBien, referencePrixEnergie, faitsBien } from '../../lib/format';
import { site } from '../../data/site';
import { titreSeo, descriptionSeo } from '../../lib/seo';
import { lienWhatsapp } from '../../lib/whatsapp';

interface Props { bien: CollectionEntry<'biens'> }

/*
 * Un bien en vente encore en relecture (offMarket) n'a pas de page : tant que
 * ses mentions obligatoires ne sont pas réunies, il ne doit pas être publié,
 * même à une adresse que personne ne connaît.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const biens = await getCollection('biens', (b) => b.data.archive || !b.data.offMarket);
  return biens.map((b) => ({ params: { bien: b.id }, props: { bien: b } }));
};

const { bien } = Astro.props;
const { Content } = await render(bien);
const d = bien.data;

/**
 * Un mandat archivé n'est plus une annonce : la fiche garde les photographies et
 * le texte, elle perd le prix, les formulaires et les mentions énergétiques.
 * Voir le commentaire du champ `archive` dans src/content.config.ts.
 */
const archive = d.archive;
/* Alerte en fin de fiche : secteur du bien, et budget arrondi au prix affiché, jamais pour une référence, qui ne montre aucun prix. */
const secteurBien = secteurs.find((s) => s.arrondissement === d.arrondissement)?.nom;
const budgetAlerte = !archive && d.prix > 0 ? Math.ceil(d.prix / 10000) * 10000 : undefined;

/*
 * Message du bouton WhatsApp. Une annonce renvoie vers elle-même, pour que Samy
 * sache de quel bien on parle. Une référence n'est plus à vendre : le visiteur
 * qui l'ouvre pense plutôt à son propre bien.
 */
const messageWhatsapp = archive
  ? `Bonjour Samy, j'ai vu votre référence « ${d.titre} » sur votre site. Je pense vendre un appartement dans le secteur et je souhaite le faire estimer.`
  : `Bonjour Samy, je souhaite des informations sur ce bien (réf. ${d.reference}) : ${site.url}/bien/${bien.id}`;

const similaires = archive
  ? (await getCollection('biens', (b) => b.id !== bien.id && b.data.archive && b.data.ville === d.ville)).slice(0, 3)
  : (await getCollection('biens', (b) => b.id !== bien.id && b.data.statut !== 'vendu' && !b.data.offMarket && !b.data.archive)).slice(0, 3);
const echelle = ['A', 'B', 'C', 'D', 'E', 'F', 'G'];
const lienWa = lienWhatsapp(Astro.url.pathname, messageWhatsapp);

/*
 * Les fiches reprises de l'ancien site ont pour description le début de leur
 * texte : le chapô ne la répète pas, le premier paragraphe prend sa place.
 * La description reste celle des moteurs de recherche.
 */
const debut = (texte: string) => texte.replace(/[*_#>`]/g, '').replace(/\s+/g, ' ').trim().slice(0, 60).toLowerCase();
const chapoRepete = Boolean(bien.body) && debut(bien.body ?? '') === debut(d.description);

/* Chiffres clés sous la galerie : ce qu'un acquéreur compare d'abord, d'une fiche à l'autre. */
const chiffres = [
  { valeur: `${nombre(d.surface)} m²`, libelle: 'Surface' },
  { valeur: String(d.pieces), libelle: d.pieces > 1 ? 'Pièces' : 'Pièce' },
  ...(d.chambres > 0 ? [{ valeur: String(d.chambres), libelle: d.chambres > 1 ? 'Chambres' : 'Chambre' }] : []),
  ...(d.etage !== 'Non précisé' ? [{ valeur: d.etage.replace(/\s*étages?$/, ''), libelle: 'Étage' }] : []),
  { valeur: d.ascenseur ? 'Oui' : 'Non', libelle: 'Ascenseur' },
];

/*
 * Le titre d'une page de référence porte le nom de l'agence tant que la balise
 * reste sous les 70 caractères utiles en résultat de recherche. Au delà, le
 * titre du bien seul vaut mieux qu'une marque tronquée par Google.
 */
const titreAvecMarque = `${d.titre} | Trudaines`;
const titreArchive = titreAvecMarque.length <= 70 ? titreAvecMarque : d.titre;

const dpeConnu = d.dpe !== 'Vierge';
const gesConnu = d.ges !== 'Vierge';
const depensesConnues =
  d.depensesEnergieMin !== undefined && d.depensesEnergieMax !== undefined && d.depensesEnergieAnnee !== undefined;

const donnees = [
  // Un mandat archivé n'est pas une offre : aucune annonce, aucun Offer, sinon
  // les moteurs continuent de présenter le bien comme disponible à la vente.
  // Une annonce immobilière, pas un Product : Google lit un Product avec une
  // offre comme une fiche de marchand et réclame livraison et retours.
  ...(archive ? [] : [{
    '@context': 'https://schema.org',
    '@type': 'RealEstateListing',
    name: d.titre,
    description: d.description,
    url: `${site.url}/bien/${bien.id}`,
    image: d.photos.map((p: { src: string }) => new URL(p.src, site.url).href),
    identifier: d.reference,
    offers: {
      '@type': 'Offer',
      // Un prix à zéro veut dire « non renseigné » : mieux vaut ne rien annoncer
      // que d'annoncer une offre gratuite aux moteurs de recherche.
      ...(d.prix > 0 ? { price: d.prix, priceCurrency: 'EUR' } : {}),
      availability: d.statut === 'vendu' ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
      businessFunction: 'http://purl.org/goodrelations/v1#Sell',
      seller: { '@id': `${site.url}/#cabinet` },
    },
  }]),
  {
    '@context': 'https://schema.org',
    '@type': 'Residence',
    name: d.titre,
    address: {
      '@type': 'PostalAddress',
      addressLocality: d.ville,
      postalCode: d.arrondissement,
      addressCountry: 'FR',
    },
    numberOfRooms: d.pieces,
    floorSize: { '@type': 'QuantitativeValue', value: d.surface, unitCode: 'MTK' },
  },
];
---
<Layout
  titre={titreSeo([d.titre, !archive && `${d.quartier} ${d.arrondissement}`, 'Trudaines'])}
  description={descriptionSeo(
    archive
      ? `${d.quartier}, ${d.ville} ${d.arrondissement}. ${nombre(d.surface)} m², ${d.pieces} pièces. Mandat présenté par l'agence Trudaines, bien non disponible.`
      : `${d.titre}, ${nombre(d.surface)} m², ${d.pieces} pièces, ${d.quartier}, ${d.ville} ${d.arrondissement}. ${prixAffiche(d.prix)}. Visite sur rendez-vous avec Trudaines.`,
  )}
  image={d.photos[0]?.src}
  filAriane={archive
    ? [{ nom: 'Nos références', href: '/references' }, { nom: d.titre }]
    : [{ nom: 'Acheter', href: '/acheter' }, { nom: d.titre }]}
  donnees={donnees}
  messageWhatsapp={messageWhatsapp}
  filArianeLarge
  barreAction={archive ? undefined : { href: '#demande-visite', libelle: 'Visiter', evt: evt('fiche', 'barre', 'visite') }}
>
  <section class="pb-16 pt-4 md:pb-24 md:pt-6">
    <div class="conteneur-large">
      <div class="fiche-grille">
        <div class="fiche-haut">
          <GalerieBien photos={d.photos} titre={d.titre} />
          <header class="fiche-entete">
            <div>
              <p class="surtitre">{d.quartier} · {lieuBien(d.arrondissement, d.ville)} · Réf. {d.reference}</p>
              <h1 class="titre-1 fiche-titre mt-4">{d.titre}</h1>
            </div>
            <div class="fiche-prix">
              {archive ? (
                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-[color:var(--color-encre)]">
                  {d.statut === 'vendu' ? "Vendu par l'agence" : "Mandat présenté par l'agence"}
                </p>
              ) : (
                <>
                  <p class="fiche-prix-montant">
                    {prixAffiche(d.prix)}
                    {(d.statut !== 'a-vendre' || d.mention) && (
                      <span class="ml-4 align-middle text-xs font-semibold uppercase tracking-[0.16em] text-[color:var(--color-ardoise)]">
                        {d.statut !== 'a-vendre' ? libelleStatut[d.statut] : d.mention}
                      </span>
                    )}
                  </p>
                  <p class="fiche-prix-note">
                    {prixM2(d.prix, d.surface) && `Soit ${prixM2(d.prix, d.surface)} le m². `}
                    Honoraires à la charge du {d.honorairesCharge}{d.honorairesTaux ? `, ${d.honorairesTaux}` : ''}.
                  </p>
                </>
              )}
            </div>
          </header>
          <ul class="fiche-chiffres" style={`--colonnes: ${chiffres.length}`} aria-label="Chiffres clés">
            {chiffres.map((c) => (
              <li>
                <span class="fiche-chiffre">{c.valeur}</span>
                <span class="fiche-chiffre-libelle">{c.libelle}</span>
              </li>
            ))}
          </ul>
          {archive && (
            <p class="mt-6 max-w-[44rem] text-sm text-[color:var(--color-ardoise)]">
              Ce bien n'est plus proposé à la vente. La fiche est conservée comme référence de notre travail, sans prix
              ni visite.
            </p>
          )}
          {d.visiteVirtuelle && (
            <p class="mt-6">
              <a href={d.visiteVirtuelle} target="_blank" rel="noopener" class="lien-souligne">Ouvrir la visite virtuelle</a>
            </p>
          )}
        </div>

        <aside class="fiche-visite" aria-label={archive ? 'Faire estimer un bien comparable' : 'Demander une visite'}>
          <div class="fiche-visite-carte">
            {archive ? (
              <>
                <p class="surtitre">Référence</p>
                <h2 class="titre-3 mt-4">Un bien comparable à vendre ?</h2>
                <p class="mt-4 text-sm text-[color:var(--color-ardoise)]">
                  Ce dossier a été préparé, photographié et présenté par l'agence. Le vôtre le sera de la même
                  façon : avis de valeur écrit après visite, ventes comparables citées, compte rendu après chaque
                  visite.
                </p>
                <a href="/estimation" class="bouton mt-8 w-full">Estimer mon bien</a>
                <p class="mt-6 text-sm">
                  <a href="/references" class="lien-souligne">Voir toutes nos références</a>
                </p>
              </>
            ) : (
              <>
                <div class="fiche-visite-resume">
                  <p class="fiche-visite-prix">{prixAffiche(d.prix)}</p>
                  <p class="fiche-visite-bien">{faitsBien(d)} · {d.quartier}</p>
                </div>
                <FormulaireVisite reference={d.reference} titreBien={d.titre} />
                <div class="fiche-contact">
                  <p>
                    Samy Santamarina, au{' '}
                    <a href={`tel:${site.telephoneLien}`} class="fiche-contact-tel whitespace-nowrap" data-evt="clic_telephone">{site.telephone}</a>
                  </p>
                  <p>
                    <a href={lienWa} rel="noopener" target="_blank" class="lien-souligne" data-evt="clic_whatsapp">Écrire sur WhatsApp</a>
                    <span aria-hidden="true"> · </span>
                    <a href="#dossier" class="lien-souligne">Recevoir le dossier complet</a>
                  </p>
                </div>
              </>
            )}
          </div>
        </aside>

        <div class="fiche-bas">
          <div class:list={['prose-trudaines max-w-[44rem]', { 'fiche-texte-ouvert': chapoRepete }]}>
            <h2 class="titre-2 mt-0">Le bien</h2>
            {!chapoRepete && <p class="chapo mt-6">{d.description}</p>}
            <Content />
          </div>

          <div class="mt-16 grid gap-14 md:grid-cols-2 md:gap-10 xl:gap-16">
            <div>
              <h2 class="titre-3">Caractéristiques</h2>
              <dl class="mt-6 divide-y divide-[color:var(--color-trait)] border-y border-[color:var(--color-trait)] text-sm">
                <div class="flex justify-between gap-6 py-3"><dt class="text-[color:var(--color-ardoise)]">Surface Carrez</dt><dd>{nombre(d.surface)} m²</dd></div>
                <div class="flex justify-between gap-6 py-3"><dt class="text-[color:var(--color-ardoise)]">Pièces</dt><dd>{d.pieces}</dd></div>
                <div class="flex justify-between gap-6 py-3"><dt class="text-[color:var(--color-ardoise)]">Chambres</dt><dd>{d.chambres}</dd></div>
                <div class="flex justify-between gap-6 py-3"><dt class="text-[color:var(--color-ardoise)]">Étage</dt><dd>{d.etage}</dd></div>
                <div class="flex justify-between gap-6 py-3"><dt class="text-[color:var(--color-ardoise)]">Ascenseur</dt><dd>{d.ascenseur ? 'Oui' : 'Non'}</dd></div>
                {d.charges !== undefined && (
                  <div class="flex justify-between gap-6 py-3"><dt class="text-[color:var(--color-ardoise)]">Charges annuelles</dt><dd>{prix(d.charges)}</dd></div>
                )}
                {d.taxeFonciere !== undefined && (
                  <div class="flex justify-between gap-6 py-3"><dt class="text-[color:var(--color-ardoise)]">Taxe foncière</dt><dd>{prix(d.taxeFonciere)}</dd></div>
                )}
                {d.lotsCopropriete !== undefined && (
                  <div class="flex justify-between gap-6 py-3"><dt class="text-[color:var(--color-ardoise)]">Lots dans la copropriété</dt><dd>{d.lotsCopropriete}</dd></div>
                )}
                {d.procedureCopropriete !== undefined && (
                  <div class="flex justify-between gap-6 py-3">
                    <dt class="text-[color:var(--color-ardoise)]">Procédure en cours</dt>
                    <dd>{d.procedureCopropriete ? 'Oui' : 'Non'}</dd>
                  </div>
                )}
              </dl>
            </div>
            <div>
              {archive ? (
                <>
                  <h2 class="titre-3">Diagnostics</h2>
                  <p class="mt-6 text-sm text-[color:var(--color-ardoise)]">
                    Les diagnostics de ce mandat ne sont plus valides : un diagnostic de performance énergétique
                    établi avant le 1er juillet 2021 a cessé de l'être au 31 décembre 2024. Ils ne sont donc pas
                    republiés ici. Pour un bien actuellement en vente, la classe énergie, la classe climat et le
                    montant estimé des dépenses annuelles d'énergie figurent sur sa fiche.
                  </p>
                </>
              ) : (
              <>
              <h2 class="titre-3">Diagnostic de performance énergétique</h2>
              <div class="mt-6 flex flex-wrap gap-2" role="img" aria-label={`Classe énergie ${d.dpe}, classe climat ${d.ges}`}>
                {echelle.map((lettre) => (
                  <span
                    class={`flex h-10 w-10 items-center justify-center border text-sm font-semibold ${
                      lettre === d.dpe
                        ? 'border-[color:var(--color-nuit)] bg-[color:var(--color-nuit)] text-white'
                        : 'border-[color:var(--color-trait)] text-[color:var(--color-ardoise)]'
                    }`}
                  >
                    {lettre}
                  </span>
                ))}
              </div>

              {/*
                Articles R126-21 à R126-25 du code de la construction et de l'habitation :
                les mentions sont précédées des mots « classe énergie » et « classe climat »,
                en capitales, dans un corps au moins égal à celui du texte de l'annonce, en
                couleur. Les logements classés F et G portent en plus la mention exacte
                « Logement à consommation énergétique excessive ».
              */}
              <p class="mt-5 text-base font-semibold uppercase text-[color:var(--color-nuit)]">
                Classe énergie {dpeConnu ? d.dpe : 'non communiquée'} · Classe climat {gesConnu ? d.ges : 'non communiquée'}
              </p>
              {['F', 'G'].includes(d.dpe) && (
                <p class="mt-3 text-base font-semibold uppercase text-[color:var(--color-nuit)]">
                  Logement à consommation énergétique excessive
                </p>
              )}
              <p class="mt-3 text-sm text-[color:var(--color-ardoise)]">
                {depensesConnues
                  ? `Montant estimé des dépenses annuelles d'énergie pour un usage standard : entre ${nombre(d.depensesEnergieMin!)} et ${nombre(d.depensesEnergieMax!)} € par an. ${referencePrixEnergie(d.depensesEnergieAnnee!)}`
                  : "Montant estimé des dépenses annuelles d'énergie : non communiqué à ce stade. Il vous est remis avec le diagnostic complet, sur demande."}
              </p>
              {['F', 'G'].includes(d.dpe) && (
                <p class="mt-3 text-sm text-[color:var(--color-ardoise)]">
                  Ce bien est concerné par le calendrier de rénovation énergétique. Nous chiffrons les travaux
                  avec vous avant toute offre, devis d'entreprise à l'appui.
                </p>
              )}
              </>
              )}
            </div>
          </div>

          {!archive && (
            <div id="dossier" class="mt-16 max-w-[40rem]">
              <FormulaireFiche reference={d.reference} titreBien={d.titre} />
            </div>
          )}

          <p class="mt-10 text-xs text-[color:var(--color-ardoise)]">
            Bien présenté par {site.nomLong}, carte professionnelle {site.legal.carteT}. Les informations sont
            communiquées sous réserve d'erreur ou d'omission et ne constituent pas un document contractuel.
          </p>
        </div>
      </div>
    </div>
  </section>

  {similaires.length > 0 && (
    <section class="section filet">
      <div class="conteneur">
        <h2 class="titre-2">{archive ? "Autres références de l'agence" : "Autres biens de l'agence"}</h2>
        <div class="mt-12 grid gap-12 md:grid-cols-3">
          {similaires.map((b) => (
            <CarteBien
              id={b.id}
              titre={b.data.titre}
              quartier={b.data.quartier}
              arrondissement={b.data.arrondissement}
              ville={b.data.ville}
              chambres={b.data.chambres}
              accroche={b.data.accroche}
              prixBien={b.data.prix}
              surface={b.data.surface}
              pieces={b.data.pieces}
              statut={b.data.statut}
              mention={b.data.mention}
              photo={b.data.photos[0]}
              sansPrix={archive}
            />
          ))}
        </div>
      </div>
    </section>
  )}
  <AlerteExpress
    id="alerte-fiche"
    titre={archive ? 'Le prochain partira peut-être avant les portails' : 'Pas tout à fait celui-ci ? Recevez les prochains en premier'}
    texte="Chaque nouveau bien est présenté d'abord à notre fichier d'acquéreurs. Trois champs, et vous en faites partie."
    origine={`Fiche ${d.reference}`}
    evt={evt('alerte', archive ? 'reference' : 'fiche')}
    secteur={secteurBien}
    budget={budgetAlerte}
  />
</Layout>
