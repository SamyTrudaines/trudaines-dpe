---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Avis from '../components/Avis.astro';
import { site } from '../data/site';

const avis = (await getCollection('avis')).slice(0, 2);

const valeurs = [
  { titre: 'Dire le prix, même quand il déplaît', texte: "Un cabinet qui flatte pour prendre un mandat vous fait perdre trois mois et finit par vous faire vendre plus bas. Nous préférons perdre le mandat." },
  { titre: 'Un territoire, pas une couverture', texte: "Trois arrondissements limitrophes. Nous refusons les biens hors de ce périmètre plutôt que de promettre une connaissance que nous n'avons pas." },
  { titre: 'La donnée au service du jugement', texte: "Les ventes signées cadrent la discussion, la visite la tranche. Un algorithme ne sent pas une cage d'escalier ni le bruit d'une cour à 18 heures." },
  { titre: "L'écrit plutôt que la promesse", texte: "Avis de valeur, comptes rendus de visite, offres, points hebdomadaires : ce qui est écrit peut être vérifié, discuté, et reproché. C'est le but." },
];
---
<Layout
  titre="Le cabinet Trudaines | Vente immobilière Paris 9e et Montmartre"
  description="Cabinet de vente immobilière fondé en 2024 par Samy Santamarina : un territoire restreint, une méthode écrite, un interlocuteur unique."
  filAriane={[{ nom: 'Le cabinet' }]}
>
  <section class="section pt-10">
    <div class="conteneur max-w-3xl">
      <p class="surtitre">La maison</p>
      <h1 class="titre-1 mt-6">Un cabinet de vente, pas une vitrine de plus</h1>
      <p class="chapo mt-8">
        Trudaines est né en septembre 2024 d'un constat simple : entre les réseaux qui multiplient les mandats et
        les maisons d'image qui vendent surtout leur nom, il manquait un cabinet qui fasse le travail de fond et qui
        l'écrive.
      </p>
    </div>
  </section>

  <section class="section filet">
    <div class="conteneur grid gap-16 lg:grid-cols-2">
      <div>
        <h2 class="titre-2">La méthode</h2>
        <p class="mt-6 text-[color:var(--color-ardoise)]">
          Nous travaillons peu de mandats à la fois, volontairement. Chaque bien est estimé sur la base des ventes
          réellement signées dans sa rue, préparé avant la première visite, présenté à des acheteurs vérifiés, et
          suivi par un compte rendu écrit après chaque visite.
        </p>
        <p class="mt-6 text-[color:var(--color-ardoise)]">
          La technologie sert à gagner du temps sur ce qui peut l'être : recherche de comparables, mise en forme des
          dossiers, suivi des acheteurs, relances. Elle ne remplace jamais la visite, la négociation, ni la
          conversation difficile qu'il faut parfois avoir avec un vendeur.
        </p>
        <p class="mt-8 text-sm"><a href="/vendre" class="lien-souligne">Les sept engagements de vente</a></p>
      </div>
      <div>
        <h2 class="titre-2">Les valeurs</h2>
        <div class="mt-8 grid gap-8">
          {valeurs.map((v) => (
            <div class="border-t border-[color:var(--color-trait)] pt-5">
              <h3 class="titre-3">{v.titre}</h3>
              <p class="mt-3 text-[color:var(--color-ardoise)]">{v.texte}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section filet">
    <div class="conteneur max-w-3xl">
      <h2 class="titre-2">Le cadre réglementaire</h2>
      <p class="mt-6 text-[color:var(--color-ardoise)]">
        {site.nomLong} est exploité par {site.raisonSociale} {site.formeJuridique}, {site.legal.rcs}, dont le siège
        est au {site.adresse.rue}, {site.adresse.codePostal} {site.adresse.ville}. {site.legal.carteTDetail}
        Garantie financière {site.legal.garantie}, à hauteur de {site.legal.garantieMontant},
        numéro de sociétaire {site.legal.garantieSocietaire}. {site.legal.detentionFonds}
      </p>
      <p class="mt-6 text-sm">
        <a href="/mentions-legales" class="lien-souligne">Mentions légales complètes</a>
      </p>
    </div>
  </section>

  <Avis avis={avis} />

  <section class="section filet">
    <div class="conteneur">
      <h2 class="titre-2">Aller plus loin</h2>
      <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm">
        <a href="/samy-santamarina" class="lien-souligne">Samy Santamarina, fondateur</a>
        <a href="/presse" class="lien-souligne">Ce que la presse en dit</a>
        <a href="/nous-rejoindre" class="lien-souligne">Nous rejoindre</a>
        <a href="/honoraires" class="lien-souligne">Honoraires</a>
      </div>
    </div>
  </section>
</Layout>
