---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import marche from '../data/marche-paris.json';
import { site } from '../data/site';

/* Ventes d'appartements signées à Paris depuis janvier 2024 (DVF), lues dans marche-paris.json. */
const anneesSuivies = marche.annees.filter((a) => a.annee >= 2024);
const ventesParis = anneesSuivies.reduce((total, a) => total + a.paris.ventes, 0).toLocaleString('fr-FR').replace(/\u202f/g, '\u00a0');
const derniereAnnee = anneesSuivies.at(-1)?.annee;

/*
 * Le manifeste et les sept engagements sont ceux que l'agence publie depuis
 * sa création. Ils sont repris tels quels, à deux détails près : les tournures
 * au pluriel qui évoquaient plusieurs consultants sont ramenées à l'agence,
 * puisque le site s'engage par ailleurs sur un interlocuteur unique.
 */
const manifeste = [
  "Trudaines repense les codes de l'immobilier haut de gamme.",
  "À l'avant-garde des évolutions technologiques, nous intégrons les dernières innovations pour les appliquer au secteur de l'immobilier.",
  "Notre engagement garantit un accompagnement performant, éthique et ultra personnalisé de chaque client.",
  "Inspirés par le design, l'architecture et l'art de vivre, nous révélons le plein potentiel de vos projets par une approche expérientielle de l'immobilier.",
];

const engagements = [
  { titre: 'Engagement', texte: "Nous accompagnons nos clients avec éthique et engagement, pour leur offrir un suivi ultra personnalisé." },
  { titre: 'Modernité', texte: "Tirer parti des meilleures technologies pour fluidifier et valoriser chaque projet immobilier, tout en conservant une approche humaine et intuitive." },
  { titre: 'Émotions', texte: "L'immobilier ne se limite pas aux biens, c'est une expérience. Nous valorisons les savoir-faire, design, architecture, décoration, qui enrichissent chaque réalisation." },
  { titre: 'Authenticité', texte: "Une approche premium, mais décontractée et accessible, où l'humain reste au cœur de chaque initiative, sans artifice ni formalisme inutile." },
  { titre: 'Expérientiel', texte: "Transformer l'immobilier en une expérience mémorable, où chaque projet est pensé pour être vécu pleinement." },
  { titre: 'Premium', texte: "Une exigence d'excellence, tant dans la qualité des biens que de l'accompagnement, avec un service sur mesure et exclusif." },
  { titre: 'Audace', texte: "Animés par une approche proactive et orientée solution, nous relevons les défis avec ingéniosité pour concrétiser chaque projet." },
];

const concret = [
  { titre: 'Le prix, même quand il déplaît', texte: "Flatter pour prendre un mandat fait perdre trois mois au vendeur. Nous préférons perdre le mandat." },
  { titre: 'Un territoire, rue par rue', texte: "Peu d'arrondissements, connus au mètre carré. Hors de ce périmètre, nous le disons." },
  { titre: 'La donnée, puis le jugement', texte: "Les ventes signées cadrent le prix. La visite le tranche." },
  { titre: "L'écrit, pas la promesse", texte: "Avis de valeur, comptes rendus de visite, offres : tout est écrit, donc vérifiable." },
];
---
<Layout
  titre="L'agence Trudaines | Vente immobilière Paris 9e et Montmartre"
  description="Agence immobilière fondée en 2024 à Paris : un territoire restreint, une méthode écrite, un interlocuteur unique. Estimation en 24 heures."
  filAriane={[{ nom: "L'agence" }]}
  cta={false}
>
  <section class="section pt-10">
    <div class="conteneur max-w-3xl">
      <p class="surtitre marque-filet">L'immobilier au-delà des murs</p>
      <h1 class="titre-1 mt-6">Une agence de vente, pas une vitrine de plus</h1>
      <p class="chapo mt-8">
        Fondée en septembre 2024. Peu de mandats, un territoire connu rue par rue, tout par écrit.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a href="/estimation" class="bouton" data-evt="agence_estimer">Estimer mon bien</a>
        <a href={`tel:${site.telephoneLien}`} class="lien-souligne whitespace-nowrap" data-evt="clic_telephone">Appeler le {site.telephone}</a>
      </div>
    </div>
  </section>

  <section class="section filet" aria-labelledby="le-nom">
    <div class="conteneur">
      <div class="mx-auto max-w-3xl text-center">
        <p class="surtitre">Le nom</p>
        <div class="mt-10 flex justify-center">
          <Logo taille="grand" />
        </div>
        <h2 id="le-nom" class="titre-2 mt-12">Deux lettres en orange, au milieu du mot</h2>
        <p class="mt-8 text-[color:var(--color-ardoise)]">
          Trudaine, une avenue du 9e nord, entre Anvers et Pigalle. Notre territoire.
        </p>
        <p class="mt-4 text-[color:var(--color-ardoise)]">
          AI, pour l'intelligence artificielle. Dans le mot, pas sur l'enseigne : la technologie est dans le travail.
        </p>
      </div>
      <ul class="reperes mx-auto mt-16 max-w-5xl">
        <li>
          <span class="reperes-chiffre">{ventesParis}</span>
          <span class="reperes-texte">
            ventes d'appartements signées à Paris de janvier 2024 à décembre {derniereAnnee}, analysées une à une
            (DVF, DGFiP).
          </span>
        </li>
        <li>
          <span class="reperes-chiffre">24 h</span>
          <span class="reperes-texte">pour estimer votre bien. La machine cherche les comparables, l'agent fixe le prix.</span>
        </li>
        <li>
          <span class="reperes-chiffre">0</span>
          <span class="reperes-texte">
            rendez-vous, négociation ou décision difficile délégué à l'intelligence artificielle. La machine sert
            l'agent. L'agent Trudaines relie, valide et décide.
          </span>
        </li>
      </ul>
      <p class="mt-14 text-center text-sm">
        <a href="/quartiers" class="lien-souligne">Les prix au mètre carré, quartier par quartier</a>
      </p>
    </div>
  </section>

  <section class="section filet" aria-labelledby="methode">
    <div class="conteneur">
      <div class="max-w-3xl">
        <p class="surtitre marque-filet">La méthode</p>
        <h2 id="methode" class="titre-2 mt-6">Peu de mandats. Chacun suivi par écrit.</h2>
        <p class="mt-6 text-[color:var(--color-ardoise)]">
          Estimé sur les ventes signées de sa rue. Préparé avant la première visite. Présenté à des acheteurs
          vérifiés. Un compte rendu écrit après chaque visite.
        </p>
      </div>
      <ol class="mt-14 grid gap-x-12 gap-y-12 md:grid-cols-2 xl:grid-cols-4">
        {concret.map((v, n) => (
          <li class="border-t border-[color:var(--color-encre)] pt-6">
            <p class="chiffre" aria-hidden="true">{String(n + 1).padStart(2, '0')}</p>
            <h3 class="titre-3 mt-4">{v.titre}</h3>
            <p class="mt-3 text-sm text-[color:var(--color-ardoise)]">{v.texte}</p>
          </li>
        ))}
      </ol>
      <p class="mt-12 text-sm"><a href="/vendre" class="lien-souligne">Les sept engagements de vente</a></p>
    </div>
  </section>

  <section class="section filet" aria-labelledby="valeurs">
    <div class="conteneur max-w-3xl">
      <h2 id="valeurs" class="surtitre">Ce qui nous anime</h2>
      <p class="titre-2 mt-8">{manifeste[0]}</p>
      <p class="mt-8 text-sm uppercase tracking-[0.2em] text-[color:var(--color-ardoise)]">
        {engagements.map((e) => e.titre).join('  ·  ')}
      </p>
    </div>
  </section>

  <section class="section bg-[color:var(--color-papier)]" aria-labelledby="contact-agence">
    <div class="conteneur max-w-3xl">
      <h2 id="contact-agence" class="titre-2">Combien vaut votre bien ? Réponse en 24 heures.</h2>
      <p class="chapo mt-6">Sans frais dans le cadre de votre projet immobilier. Un seul interlocuteur, du premier appel à l'acte.</p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="/estimation" class="bouton" data-evt="agence_cta_estimer">Estimer mon bien</a>
        <a href={`tel:${site.telephoneLien}`} class="bouton bouton-secondaire" data-evt="clic_telephone">Appeler le {site.telephone}</a>
      </div>
      <p class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a href="/references" class="lien-souligne">Nos références</a>
        <a href="/samy-santamarina" class="lien-souligne">Le mot du fondateur</a>
        <a href="/avis" class="lien-souligne">Avis clients</a>
        <a href="/presse" class="lien-souligne">Presse</a>
        <a href="/honoraires" class="lien-souligne">Honoraires</a>
      </p>
    </div>
  </section>

  <section class="py-10">
    <div class="conteneur max-w-3xl text-xs leading-relaxed text-[color:var(--color-ardoise)]">
      {site.nomLong} est exploité par {site.raisonSociale} {site.formeJuridique}, {site.legal.rcs}, siège au
      {' '}{site.adresse.rue}, {site.adresse.codePostal} {site.adresse.ville}. {site.legal.carteTDetail} Garantie
      financière {site.legal.garantie}, {site.legal.garantieMontant}, sociétaire {site.legal.garantieSocietaire}.
      {' '}{site.legal.detentionFonds} <a href="/mentions-legales" class="lien-souligne">Mentions légales</a>.
    </div>
  </section>
</Layout>
