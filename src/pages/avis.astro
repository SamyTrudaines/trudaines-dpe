---
import Layout from '../layouts/Layout.astro';
import FormulaireTemoignage from '../components/FormulaireTemoignage.astro';
import { agrégatAvis, tousLesAvis } from '../lib/avis';
import { site } from '../data/site';

const avis = await tousLesAvis();
const agregat = await agrégatAvis();
const commentés = avis.filter((a) => a.data.texte);
const notesSeules = avis.filter((a) => !a.data.texte && a.data.note);

const libelléSource = (source: string) =>
  source === 'google' ? 'Avis Google' : source === 'pagesjaunes' ? 'Avis Pages Jaunes' : "Avis recueilli par l'agence";

/*
 * Balisage des avis cités. La note moyenne et le volume sont portés par la
 * fiche de l'agence, posée par le gabarit sur toutes les pages, et calculés sur
 * ces mêmes fiches : le visiteur peut les recompter ici.
 */
const donnees = [
  {
    '@context': 'https://schema.org',
    '@type': 'RealEstateAgent',
    '@id': `${site.url}/#cabinet`,
    name: site.nomLong,
    url: site.url,
    review: commentés.slice(0, 12).map((a) => ({
      '@type': 'Review',
      author: { '@type': 'Person', name: a.data.auteur },
      ...(a.data.note ? { reviewRating: { '@type': 'Rating', ratingValue: a.data.note, bestRating: 5, worstRating: 1 } } : {}),
      reviewBody: a.data.texte,
    })),
  },
];
---
<Layout
  titre="Avis clients | Trudaines, agence immobilière Paris"
  description={`${agregat.total} avis de vendeurs et d'acquéreurs accompagnés par Samy Santamarina, note ${agregat.noteTexte} sur 5, publiés sur Google et Pages Jaunes.`}
  filAriane={[{ nom: 'Avis clients' }]}
  donnees={donnees}
>
  <section class="section pt-10">
    <div class="conteneur">
      <div class="max-w-3xl">
        <p class="surtitre">Avis clients</p>
        <h1 class="titre-1 mt-6">Ce que disent les propriétaires que nous avons accompagnés</h1>
        <p class="chapo mt-8">
          Les avis reçus par Samy Santamarina, avant et depuis l'ouverture de l'agence en septembre 2024, sont ici, dans leur texte d'origine. Chacun peut
          être vérifié à sa source, sur la fiche Google de l'agence ou sur Pages Jaunes.
        </p>
      </div>

      <dl class="mt-16 grid gap-10 border-t border-[color:var(--color-encre)] pt-8 sm:grid-cols-3">
        <div>
          <dt class="text-xs uppercase tracking-[0.14em] text-[color:var(--color-ardoise)]">Note moyenne</dt>
          <dd class="mt-3 font-[family-name:var(--font-titre)] text-4xl">{agregat.noteTexte} <span class="text-xl">/ 5</span></dd>
          {agregat.notés < agregat.total && (
            <dd class="mt-2 text-xs text-[color:var(--color-ardoise)]">
              Sur les {agregat.notés} notes relevées. Les autres avis ont été repris sans leurs étoiles.
            </dd>
          )}
        </div>
        <div>
          <dt class="text-xs uppercase tracking-[0.14em] text-[color:var(--color-ardoise)]">Avis publiés</dt>
          <dd class="mt-3 font-[family-name:var(--font-titre)] text-4xl">{agregat.total}</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-[0.14em] text-[color:var(--color-ardoise)]">Sources</dt>
          <dd class="mt-3 text-sm leading-relaxed text-[color:var(--color-ardoise)]">
            {agregat.parSource.google} sur Google et {agregat.parSource.pagesjaunes} sur Pages Jaunes.
            Relevé en {site.avis.releve}.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="avis-commentes">
    <div class="conteneur">
      <h2 id="avis-commentes" class="sr-only">Avis commentés</h2>
      <div class="grid gap-x-12 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
        {commentés.map((a) => (
          <figure class="flex flex-col bloc" data-avis>
            {a.data.note && (
              <span aria-hidden="true" class="text-sm tracking-[0.3em] text-[color:var(--color-or-fonce)]">
                {'★'.repeat(a.data.note)}
              </span>
            )}
            <blockquote class="mt-6 grow font-[family-name:var(--font-titre)] text-[1.0625rem] leading-[1.75]">
              {a.data.texte}
            </blockquote>
            <figcaption class="mt-6 text-xs leading-relaxed text-[color:var(--color-ardoise)]">
              <span class="block font-medium uppercase tracking-[0.12em] text-[color:var(--color-encre)]">
                {a.data.auteur}
              </span>
              <span class="mt-1 block">
                {a.data.note && <span class="sr-only">Note de {a.data.note} sur 5. </span>}
                {[a.data.typeProjet, a.data.quartier].filter(Boolean).join(' · ')}
              </span>
              <span class="mt-1 block">
                {libelléSource(a.data.source)}
                {a.data.anciennete ? `, ${a.data.anciennete}` : ''}
                {a.data.dateVisite ? ` · ${a.data.dateVisite}` : ''}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {notesSeules.length > 0 && (
    <section class="section pt-0" aria-labelledby="notes-seules">
      <div class="conteneur">
        <div class="border-t border-[color:var(--color-trait)] pt-8">
          <h2 id="notes-seules" class="titre-3">Notes déposées sans commentaire</h2>
          <p class="mt-4 max-w-2xl text-sm text-[color:var(--color-ardoise)]">
            Ces {notesSeules.length} clients ont noté l'agence cinq étoiles sans écrire de texte. Ils comptent dans la
            moyenne affichée ci-dessus, c'est pourquoi ils figurent ici.
          </p>
          <ul class="mt-8 grid gap-4 text-sm sm:grid-cols-2 lg:grid-cols-4">
            {notesSeules.map((a) => (
              <li class="border-t border-[color:var(--color-trait)] pt-4" data-avis>
                <span class="block font-medium uppercase tracking-[0.12em] text-xs">{a.data.auteur}</span>
                <span aria-hidden="true" class="mt-2 block text-xs tracking-[0.3em] text-[color:var(--color-or-fonce)]">
                  {'★'.repeat(a.data.note ?? 0)}
                </span>
                <span class="mt-2 block text-xs text-[color:var(--color-ardoise)]">
                  <span class="sr-only">Note de {a.data.note} sur 5. </span>
                  {libelléSource(a.data.source)}
                  {a.data.anciennete ? `, ${a.data.anciennete}` : ''}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <section class="section pt-0">
    <div class="conteneur">
      <div class="max-w-2xl border-t border-[color:var(--color-encre)] pt-8">
        <h2 class="titre-3">Comment ces avis sont recueillis</h2>
        <p class="mt-4 text-sm leading-relaxed text-[color:var(--color-ardoise)]">
          L'agence ne rémunère aucun avis. Chaque client est invité une fois, après la signature, à
          déposer son avis sur Google. Une partie des avis, sur Google comme sur Pages Jaunes, date de l'activité de
          Samy Santamarina avant la création de l'agence en septembre 2024 : l'ancienneté de chacun est indiquée. Les avis qui citent le réseau où il exerçait alors ne sont pas repris ici ; ils restent publiés sur la fiche Google. Les noms sont réduits à l'initiale du nom de famille, les
          textes ne sont pas retouchés, et les avis les plus longs sont affichés tels que la plateforme les publie.
        </p>
        <a
          href={site.avis.lienGoogle}
          target="_blank"
          rel="noopener nofollow"
          data-evt="clic_avis_google"
          class="lien-souligne mt-8 inline-block text-sm"
        >
          Voir la fiche Google de l'agence
        </a>
      </div>
    </div>
  </section>

  <section class="section filet" aria-labelledby="deposer-avis">
    <div class="conteneur grid gap-16 lg:grid-cols-[1fr_1fr] lg:items-start">
      <div class="max-w-xl">
        <p class="surtitre">Vous avez travaillé avec nous</p>
        <h2 id="deposer-avis" class="titre-2 mt-6">Déposer un témoignage</h2>
        <p class="mt-6 text-[color:var(--color-ardoise)]">
          Un avis utile n'est pas un compliment, c'est un récit : ce que vous vouliez, ce qui a été difficile, ce
          qui s'est passé. Cela vaut mieux qu'une étoile de plus, pour vous comme pour le prochain vendeur qui
          lira cette page.
        </p>
        <p class="mt-6 text-[color:var(--color-ardoise)]">
          Rien n'est publié automatiquement. Je relis, je vous écris, et je ne mets en ligne que si vous avez
          coché l'accord. Vous pouvez demander le retrait à tout moment.
        </p>
        <p class="mt-8 text-sm">
          Le déposer aussi sur{' '}
          <a href={site.avis.lienGoogle} target="_blank" rel="noopener nofollow" data-evt="clic_avis_google" class="lien-souligne">
            la fiche Google de l'agence
          </a>{' '}
          aide davantage que tout le reste : c'est là que regardent les vendeurs qui ne nous connaissent pas
          encore.
        </p>
      </div>
      <FormulaireTemoignage />
    </div>
  </section>
</Layout>
