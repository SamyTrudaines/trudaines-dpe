---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---
<Layout
  titre="Merci | Trudaines"
  description="Votre demande a bien été transmise au cabinet Trudaines."
  noindex={true}
  cta={false}
>
  <section class="section pt-20">
    <div class="conteneur-texte text-center">
      <p class="surtitre">Demande envoyée</p>
      <h1 class="titre-1 mt-6">Merci, c'est bien reçu</h1>
      <p class="chapo mt-8">
        Samy Santamarina vous rappelle sous 24 heures ouvrées. Si votre demande est urgente, appelez directement le{' '}
        <a href={`tel:${site.telephoneLien}`} data-evt="clic_telephone" class="lien-souligne">{site.telephone}</a>.
      </p>
      <div class="mt-12 flex flex-col justify-center gap-4 sm:flex-row">
        <a href="/" class="bouton">Retour à l'accueil</a>
        <a href="/panorama" class="bouton bouton-secondaire">Lire nos analyses</a>
      </div>
    </div>
  </section>
</Layout>
