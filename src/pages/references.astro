---
import { srcsetCarte, TAILLES_CARTE } from '../lib/images';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BlocCta from '../components/BlocCta.astro';
import { nombre } from '../lib/format';
import { site } from '../data/site';

/**
 * Les mandats passés, présentés comme références et non comme annonces.
 * Aucun prix, aucun formulaire de visite : la page rend compte du travail
 * accompli, elle ne propose rien à la vente.
 */
const mandats = (await getCollection('biens', (b) => b.data.archive)).sort(
  (a, b) => b.data.surface - a.data.surface
);

const paris = mandats.filter((b) => b.data.ville === 'Paris');
const ouest = mandats.filter((b) => b.data.ville !== 'Paris');

const villes = [...new Set(ouest.map((b) => b.data.ville))].sort();

/** « 75009 » vers « 9e », pour dire où les mandats se sont réellement trouvés. */
const arrondissements = [...new Set(paris.map((b) => b.data.arrondissement))]
  .sort()
  .map((code) => `${Number(code.slice(-2))}e`);

const groupes = [
  {
    cle: 'paris',
    titre: 'Paris',
    chapo: `Le périmètre de travail quotidien du cabinet est le 9e nord, Montmartre et le 10e nord. Ces mandats se sont trouvés dans les ${arrondissements.join(', ')} arrondissements.`,
    biens: paris,
  },
  {
    cle: 'ouest',
    titre: 'Ouest parisien et Hauts-de-Seine',
    chapo: `Des mandats conduits hors du périmètre parisien, à ${villes.join(', ')}, pour des clients recommandés. Nous les présentons parce qu'ils disent quelque chose d'utile : la même méthode tient sur une maison de famille comme sur un deux pièces de la Butte.`,
    biens: ouest,
  },
].filter((groupe) => groupe.biens.length > 0);

const surfaces = mandats.map((b) => b.data.surface).sort((a, b) => a - b);
const surfaceMin = surfaces[0];
const surfaceMax = surfaces[surfaces.length - 1];

const donnees = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Nos références',
    description: `Les ${mandats.length} biens présentés par ${site.nomLong} depuis 2024.`,
    url: `${site.url}/references`,
    isPartOf: { '@id': `${site.url}/#site` },
  },
];
---
<Layout
  titre="Nos références | Les biens présentés par Trudaines"
  description={`Les ${mandats.length} biens confiés au cabinet Trudaines depuis 2024, de ${Math.round(surfaceMin)} à ${Math.round(surfaceMax)} m², à Paris et dans l'ouest parisien.`}
  filAriane={[{ nom: 'Nos références' }]}
  donnees={donnees}
  cta={false}
>
  <section class="section pt-10">
    <div class="conteneur max-w-3xl">
      <p class="surtitre">Depuis septembre 2024</p>
      <h1 class="titre-1 mt-6">Les biens qui nous ont été confiés</h1>
      <p class="chapo mt-8">
        {mandats.length} mandats, de {Math.round(surfaceMin)} à {Math.round(surfaceMax)} m², du deux pièces de la
        Butte à la demeure avec jardin. Les photographies sont celles des dossiers, prises pour le cabinet.
      </p>
      <p class="mt-6 text-sm text-[color:var(--color-ardoise)]">
        Ces biens ne sont plus proposés à la vente. Aucun prix n'est affiché et aucune visite n'est organisée
        depuis cette page. Les biens disponibles sont sur{' '}
        <a href="/acheter" class="lien-souligne">la page acheter</a>.
      </p>
    </div>
  </section>

  {groupes.map((groupe) => (
    <section class="section filet" aria-labelledby={`groupe-${groupe.cle}`}>
      <div class="conteneur">
        <div class="max-w-2xl">
          <h2 id={`groupe-${groupe.cle}`} class="titre-2">{groupe.titre}</h2>
          <p class="mt-6 text-[color:var(--color-ardoise)]">{groupe.chapo}</p>
        </div>
        <div class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {groupe.biens.map((b, index) => (
            <article class="group">
              <a href={`/bien/${b.id}`} class="block no-underline">
                <div class="relative aspect-[4/3] overflow-hidden bg-[color:var(--color-papier)]">
                  {b.data.photos[0] && (
                    <img
                      src={b.data.photos[0].src}
                      srcset={srcsetCarte(b.data.photos[0].src)}
                      sizes={TAILLES_CARTE}
                      alt={b.data.photos[0].alt}
                      width="800"
                      height="600"
                      loading={index < 3 ? 'eager' : 'lazy'}
                      decoding="async"
                      class="h-full w-full object-cover transition-opacity duration-200 group-hover:opacity-90"
                    />
                  )}
                  {b.data.statut === 'vendu' && (
                    <span class="absolute left-0 top-0 bg-[color:var(--color-encre)] px-3 py-2 text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-white">
                      Vendu
                    </span>
                  )}
                </div>
                <p class="surtitre mt-5">{b.data.quartier} · {b.data.ville} {b.data.arrondissement}</p>
                <h3 class="titre-3 mt-2 text-[color:var(--color-encre)]">{b.data.titre}</h3>
                <p class="mt-3 text-sm text-[color:var(--color-ardoise)]">
                  {nombre(b.data.surface)} m² · {b.data.pieces} {b.data.pieces > 1 ? 'pièces' : 'pièce'}
                  {b.data.photos.length > 1 && ` · ${b.data.photos.length} photographies`}
                </p>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <BlocCta
    titre="Votre bien mérite le même dossier"
    texte="Avis de valeur écrit après visite, ventes comparables citées, calendrier de décision. Gratuit, sans engagement, et il reste à vous."
  />
</Layout>
