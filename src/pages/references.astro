---
import { evt } from '../lib/entonnoir';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import AlerteExpress from '../components/AlerteExpress.astro';
import Banniere from '../components/Banniere.astro';
import { ambiance } from '../data/ambiance';
import BlocCta from '../components/BlocCta.astro';
import { lieuBien } from '../lib/format';
import { jeuPhoto, TAILLES_CARTE } from '../lib/images';
import { site } from '../data/site';
import { lieuxDeVente } from '../lib/ventes';

/**
 * Les mandats passés, présentés comme références et non comme annonces.
 * Aucun prix, aucun formulaire de visite : la page rend compte du travail
 * accompli, elle ne propose rien à la vente.
 */
/*
 * Ordre choisi par l'agence : les adresses les plus parlantes d'abord. Un bien absent de la liste
 * vient après, les ventes d'abord, puis les plus grandes surfaces.
 */
const ORDRE = [
  'appartement-4-pieces-89m2-haussmannien-trudaine-condorcet',
  'appartement-familial-6-pieces-158m2-montholon-paradis',
  'appartement-2-pieces-46m2-balcon-abbesses',
  'appartement-3-pieces-65m2-traversant-brochant-epinettes',
  'appartement-2-pieces-43m2-renove-rue-vaneau',
  'appartement-3-pieces-68m2-oriente-sud-secteur-trudaine',
  'appartement-4-pieces-96m2-deux-balcons-pyrenees',
  'demeure-300m2-jardin-vaucresson-centre',
  'duplex-6-pieces-136m2-becon-les-bruyeres',
  'appartement-3-pieces-77m2-terrasse-boulogne-marcel-sembat',
  'maison-familiale-130m2-bois-colombes-centre',
  'maison-moderne-145m2-cinq-chambres-petit-colombes',
  'maison-de-charme-226m2-jardin-la-garenne-colombes',
  'maison-architecte-200m2-terrasse-bagnolet',
];
const rang = (id: string) => (ORDRE.includes(id) ? ORDRE.indexOf(id) : ORDRE.length);
const mandats = (await getCollection('biens', (b) => b.data.archive)).sort(
  (a, b) =>
    rang(a.id) - rang(b.id) ||
    Number(b.data.statut === 'vendu') - Number(a.data.statut === 'vendu') ||
    b.data.surface - a.data.surface
);

const paris = mandats.filter((b) => b.data.ville === 'Paris');
const ouest = mandats.filter((b) => b.data.ville !== 'Paris');

/** « 75009 » vers « 9e », pour dire où les mandats se sont réellement trouvés. */
const arrondissements = [...new Set(paris.map((b) => b.data.arrondissement))]
  .sort()
  .map((code) => `${Number(code.slice(-2))}e`);

const groupes = [
  {
    cle: 'paris',
    titre: 'Paris',
    chapo: `L'agence travaille Paris, avec une connaissance au mètre carré des 7e, 9e, 10e, 16e, 17e et 18e. Ces mandats se sont trouvés dans les ${arrondissements.join(', ')} arrondissements.`,
    biens: paris,
  },
  {
    cle: 'ouest',
    titre: 'Aux portes de Paris',
    chapo: `Des mandats conduits en première couronne, souvent pour des clients recommandés : demeure avec jardin, duplex familial, maisons d'architecte. La même méthode tient sur une maison de famille comme sur un deux pièces de la Butte.`,
    biens: ouest,
  },
].filter((groupe) => groupe.biens.length > 0);

const lieux = await lieuxDeVente();

const donnees = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Nos références',
    description: `Les biens présentés par ${site.nomLong} depuis 2024, à Paris et en première couronne.`,
    url: `${site.url}/references`,
    isPartOf: { '@id': `${site.url}/#site` },
  },
];
---
<Layout
  titre="Nos références | Les biens présentés par Trudaines"
  description="Les biens confiés à l'agence Trudaines depuis 2024, du deux pièces de la Butte à la demeure avec jardin, à Paris et en première couronne."
  filAriane={[{ nom: 'Nos références' }]}
  donnees={donnees}
  cta={false}
>
  <Banniere
    image={ambiance.ruePavee}
    surtitre="Depuis septembre 2024"
    titre="Les biens qui nous ont été confiés"
    balise="div"
    hauteur="moyen"
    premiere
  />

  <section class="section pt-14">
    <div class="conteneur max-w-3xl">
      <h1 class="titre-1">Nos références</h1>
      <p class="chapo mt-8">
        Du deux pièces de la Butte à la demeure avec jardin, à Paris et aux portes de Paris. Chaque bien est
        présenté avec des photographes et des vidéastes professionnels.
      </p>
      <p class="mt-6 text-[color:var(--color-ardoise)]">
        Ces biens ne sont plus proposés à la vente. Aucun prix n'est affiché et aucune visite n'est organisée
        depuis cette page. Les biens disponibles sont sur{' '}
        <a href="/acheter" class="lien-souligne">la page acheter</a>.
      </p>
    </div>
  </section>

  <section class="section filet pt-14" aria-labelledby="lieux-ventes">
    <div class="conteneur">
      <div class="max-w-2xl">
        <p class="surtitre marque-filet">Ventes signées</p>
        <h2 id="lieux-ventes" class="titre-2 mt-6">À Paris et en première couronne</h2>
        <p class="mt-6 text-[color:var(--color-ardoise)]">
          Samy Santamarina a déjà conduit des ventes jusqu'à la signature dans ces arrondissements et ces départements.
          Votre adresse n'y figure pas ? La méthode est la même partout : les ventes signées de votre rue, une visite,
          un avis de valeur écrit.
        </p>
      </div>
      <div class="mt-12 grid gap-12 md:grid-cols-2">
        <div>
          <h3 class="surtitre">Paris</h3>
          <ul class="lieux-ventes mt-4" aria-label="Arrondissements où une vente a été signée">
            {lieux.arrondissements.map((a) => <li>{a}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="surtitre">Première couronne</h3>
          <ul class="lieux-ventes lieux-ventes-communes mt-4" aria-label="Départements où une vente a été signée">
            {lieux.departements.map((d) => <li>{d}</li>)}
          </ul>
        </div>
      </div>
      {lieux.aussi.length > 0 && (
        <p class="mt-10 text-sm text-[color:var(--color-ardoise)]">
          L'agence intervient aussi à {lieux.aussi.join(', ').replace(/, ([^,]*)$/, ' et $1')}, et dans toute la première couronne.{' '}
          <a href="/estimation" class="lien-souligne">Faire estimer votre bien</a>
        </p>
      )}
    </div>
  </section>

  <AlerteExpress
    id="alerte-references"
    titre="Le prochain partira peut-être avant les portails"
    texte="Ces biens ne sont plus disponibles. Les suivants sont présentés d'abord à notre fichier d'acquéreurs : trois champs, et vous en faites partie."
    origine="Références"
    evt={evt('alerte', 'references')}
  />

  {groupes.map((groupe) => (
    <section class="section filet" aria-labelledby={`groupe-${groupe.cle}`}>
      <div class="conteneur">
        <div class="max-w-2xl">
          <h2 id={`groupe-${groupe.cle}`} class="titre-2">{groupe.titre}</h2>
          <p class="mt-6 text-[color:var(--color-ardoise)]">{groupe.chapo}</p>
        </div>
        <div class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
          {groupe.biens.map((b, index) => (
            <article class="group">
              <a href={`/bien/${b.id}`} class="block no-underline">
                <div class="relative aspect-[4/3] overflow-hidden bg-[color:var(--color-papier)]">
                  {b.data.photos[0] && (
                    <img
                      src={jeuPhoto(b.data.photos[0].src).src}
                      srcset={jeuPhoto(b.data.photos[0].src).srcset}
                      sizes={TAILLES_CARTE}
                      alt={b.data.photos[0].alt}
                      width="800"
                      height="600"
                      loading={index < 3 ? 'eager' : 'lazy'}
                      decoding="async"
                      class="h-full w-full object-cover transition-opacity duration-200 group-hover:opacity-90"
                    />
                  )}
                  {b.data.statut === 'vendu' && <span class="cartouche-vendu">Vendu</span>}
                </div>
                <p class="surtitre mt-5">{b.data.quartier} · {lieuBien(b.data.arrondissement, b.data.ville)}</p>
                <h3 class="titre-3 mt-2 text-[color:var(--color-encre)]">{b.data.accroche ?? b.data.titre}</h3>
                <p class="surtitre mt-4">
                  {b.data.statut === 'vendu' ? 'Vendu par Trudaines' : 'Confié à Trudaines'}
                </p>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <BlocCta
    titre="Votre bien mérite le même dossier"
    texte="Avis de valeur écrit après visite, ventes comparables citées, calendrier de décision. Gratuit, sans engagement, et il reste à vous."
  />
</Layout>
