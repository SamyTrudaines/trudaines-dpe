---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FormulaireAlerte from '../components/FormulaireAlerte.astro';
import { prixAffiche, nombre, libelleStatut } from '../lib/format';

const biens = (await getCollection('biens', (b) => !b.data.offMarket)).sort(
  (a, b) => a.data.ordre - b.data.ordre || b.data.prix - a.data.prix
);

const arrondissements = [...new Set(biens.map((b) => b.data.arrondissement))].sort();
const quartiers = [...new Set(biens.map((b) => b.data.quartier))].sort();
---
<Layout
  titre="Appartements à vendre Paris 9e, 18e et 10e | Trudaines"
  description="Les biens à la vente du cabinet Trudaines : Paris 9e nord, Montmartre, Paris 10e. Filtrez par arrondissement, quartier, prix, surface et nombre de pièces."
  filAriane={[{ nom: 'Acheter' }]}
>
  <section class="section pt-10">
    <div class="conteneur max-w-3xl">
      <p class="surtitre">Acheter</p>
      <h1 class="titre-1 mt-6">Les biens que nous vendons</h1>
      <p class="chapo mt-8">
        Une sélection volontairement courte. Chaque bien est visité, documenté et présenté par la personne qui le
        vend. Une partie de nos ventes se fait avant diffusion : créez une alerte pour en être informé.
      </p>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="filtres">
    <div class="conteneur">
      <h2 id="filtres" class="sr-only">Filtrer les biens</h2>
      <form class="grid gap-4 border-y border-[color:var(--color-trait)] py-8 sm:grid-cols-2 lg:grid-cols-5" data-filtres>
        <div>
          <label class="etiquette" for="f-arrondissement">Arrondissement</label>
          <select class="champ" id="f-arrondissement" name="arrondissement">
            <option value="">Tous</option>
            {arrondissements.map((a) => <option value={a}>{a}</option>)}
          </select>
        </div>
        <div>
          <label class="etiquette" for="f-quartier">Quartier</label>
          <select class="champ" id="f-quartier" name="quartier">
            <option value="">Tous</option>
            {quartiers.map((q) => <option value={q}>{q}</option>)}
          </select>
        </div>
        <div>
          <label class="etiquette" for="f-pieces">Pièces minimum</label>
          <select class="champ" id="f-pieces" name="pieces">
            <option value="">Indifférent</option>
            <option value="2">2 et plus</option>
            <option value="3">3 et plus</option>
            <option value="4">4 et plus</option>
            <option value="5">5 et plus</option>
          </select>
        </div>
        <div>
          <label class="etiquette" for="f-prix">Budget maximum</label>
          <select class="champ" id="f-prix" name="prix">
            <option value="">Indifférent</option>
            <option value="400000">400 000 €</option>
            <option value="600000">600 000 €</option>
            <option value="800000">800 000 €</option>
            <option value="1000000">1 000 000 €</option>
            <option value="1500000">1 500 000 €</option>
          </select>
        </div>
        <div>
          <label class="etiquette" for="f-surface">Surface minimum</label>
          <select class="champ" id="f-surface" name="surface">
            <option value="">Indifférent</option>
            <option value="30">30 m²</option>
            <option value="50">50 m²</option>
            <option value="70">70 m²</option>
            <option value="90">90 m²</option>
          </select>
        </div>
      </form>
      <p class="mt-6 text-sm text-[color:var(--color-ardoise)]" data-compte-biens>{biens.length} biens</p>
    </div>
  </section>

  <section class="section pt-0">
    <div class="conteneur">
      {biens.length === 0 ? (
        <p class="text-[color:var(--color-ardoise)]">
          Aucun bien n'est actuellement diffusé publiquement. Créez une alerte ci-dessous, nous vous écrivons dès
          qu'un bien correspond à votre recherche.
        </p>
      ) : (
        <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-3" data-liste-biens>
          {biens.map((b, index) => (
            <article
              class="group"
              data-bien
              data-arrondissement={b.data.arrondissement}
              data-quartier={b.data.quartier}
              data-pieces={b.data.pieces}
              data-prix={b.data.prix}
              data-surface={b.data.surface}
            >
              <a href={`/bien/${b.id}`} class="block no-underline">
                <div class="relative aspect-[4/3] overflow-hidden bg-[color:var(--color-papier)]">
                  {b.data.photos[0] ? (
                    <img
                      src={b.data.photos[0].src}
                      alt={b.data.photos[0].alt}
                      width="800"
                      height="600"
                      loading={index < 3 ? 'eager' : 'lazy'}
                      decoding="async"
                      class="h-full w-full object-cover"
                    />
                  ) : (
                    <span class="flex h-full w-full items-center justify-center text-xs uppercase tracking-[0.2em] text-[color:var(--color-ardoise)]">
                      Photographies à venir
                    </span>
                  )}
                  {b.data.statut !== 'a-vendre' && (
                    <span class="absolute left-0 top-0 bg-[color:var(--color-nuit)] px-3 py-2 text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-white">
                      {libelleStatut[b.data.statut]}
                    </span>
                  )}
                </div>
                <p class="surtitre mt-5">{b.data.quartier} · {b.data.arrondissement}</p>
                <h2 class="titre-3 mt-2 text-[color:var(--color-encre)]">{b.data.titre}</h2>
                <p class="mt-3 text-sm text-[color:var(--color-ardoise)]">
                  {nombre(b.data.surface)} m² · {b.data.pieces} {b.data.pieces > 1 ? 'pièces' : 'pièce'} · DPE {b.data.dpe}
                </p>
                <p class="mt-2 text-base font-semibold text-[color:var(--color-nuit)]">{prixAffiche(b.data.prix)}</p>
              </a>
            </article>
          ))}
        </div>
      )}
      <p class="mt-12 text-sm text-[color:var(--color-ardoise)]" data-aucun-resultat hidden>
        Aucun bien ne correspond à ces critères pour le moment. Créez une alerte, nous vous préviendrons.
      </p>
    </div>
  </section>

  <section class="section filet">
    <div class="conteneur grid gap-16 lg:grid-cols-[1fr_1fr] lg:items-start">
      <div>
        <h2 class="titre-2">Acheter avant tout le monde</h2>
        <p class="chapo mt-6">
          Les biens que nous rentrons sont présentés d'abord à notre fichier d'acquéreurs. C'est souvent là que se
          traitent les meilleures affaires, sans surenchère et sans visite groupée.
        </p>
        <p class="mt-6 text-sm text-[color:var(--color-ardoise)]">
          Vous cherchez un bien précis et vous ne le trouvez pas ?
          <a href="/chasse" class="lien-souligne">Confiez-nous un mandat de recherche</a>.
        </p>
      </div>
      <FormulaireAlerte />
    </div>
  </section>

  <script is:inline>
    (function () {
      var form = document.querySelector('[data-filtres]');
      var liste = document.querySelector('[data-liste-biens]');
      if (!form || !liste) return;
      var cartes = Array.prototype.slice.call(liste.querySelectorAll('[data-bien]'));
      var compte = document.querySelector('[data-compte-biens]');
      var vide = document.querySelector('[data-aucun-resultat]');

      function appliquer() {
        var d = new FormData(form);
        var arrondissement = d.get('arrondissement');
        var quartier = d.get('quartier');
        var pieces = parseInt(d.get('pieces') || '0', 10);
        var prixMax = parseInt(d.get('prix') || '0', 10);
        var surfaceMin = parseInt(d.get('surface') || '0', 10);
        var visibles = 0;

        cartes.forEach(function (carte) {
          var ok =
            (!arrondissement || carte.dataset.arrondissement === arrondissement) &&
            (!quartier || carte.dataset.quartier === quartier) &&
            (!pieces || parseInt(carte.dataset.pieces, 10) >= pieces) &&
            (!prixMax || parseInt(carte.dataset.prix, 10) <= prixMax) &&
            (!surfaceMin || parseInt(carte.dataset.surface, 10) >= surfaceMin);
          carte.hidden = !ok;
          if (ok) visibles++;
        });

        if (compte) compte.textContent = visibles + (visibles > 1 ? ' biens' : ' bien');
        if (vide) vide.hidden = visibles !== 0;
      }

      form.addEventListener('change', appliquer);
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        appliquer();
      });
    })();
  </script>
</Layout>
