---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { dateFr, cabinet } from '../../data/site';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).filter((a) => !a.data.brouillon);
  return articles.map((article) => ({ params: { article: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const d = article.data;

const autres = (await getCollection('articles'))
  .filter((a) => !a.data.brouillon && a.id !== article.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const schemaArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.titre,
  description: d.chapo,
  datePublished: d.date.toISOString(),
  dateModified: d.date.toISOString(),
  author: { '@type': 'Person', name: cabinet.fondateur, url: `${cabinet.domaine}/samy-santamarina` },
  publisher: { '@id': `${cabinet.domaine}/#cabinet` },
  mainEntityOfPage: `${cabinet.domaine}/panorama/${article.id}`,
  ...(d.image ? { image: `${cabinet.domaine}${d.image}` } : {}),
  keywords: d.motsCles.join(', '),
};
---
<Base
  title={`${d.titre} | Trudaines`}
  description={d.chapo}
  image={d.image}
  ariane={[{ nom: 'Panorama', url: '/panorama' }, { nom: d.titre, url: `/panorama/${article.id}` }]}
  schemas={[schemaArticle]}
>
  <article>
    <header class="conteneur-etroit py-16 lg:py-20">
      <p class="surtitre">{dateFr(d.date)}</p>
      <h1 class="mt-6 text-3xl leading-tight lg:text-4xl">{d.titre}</h1>
      <p class="mt-6 text-lg text-gris">{d.chapo}</p>
      <p class="mt-6 text-sm text-gris">
        Par <a href="/samy-santamarina" class="lien-souligne">{cabinet.fondateur}</a>, fondateur du cabinet.
      </p>
    </header>

    {d.image && (
      <div class="conteneur">
        <img src={d.image} alt={d.imageAlt} width="1600" height="900" fetchpriority="high" decoding="async" class="aspect-[16/9] w-full object-cover" />
      </div>
    )}

    <div class="conteneur-etroit prose-trudaines py-16">
      <Content />
    </div>

    {d.motsCles.length > 0 && (
      <div class="conteneur-etroit pb-8">
        <p class="surtitre">Sujets</p>
        <p class="mt-3 text-sm text-gris">{d.motsCles.join(' · ')}</p>
      </div>
    )}
  </article>

  {autres.length > 0 && (
    <section class="border-t border-ligne">
      <div class="conteneur py-16">
        <p class="surtitre">À lire ensuite</p>
        <div class="mt-8 grid gap-10 sm:grid-cols-2">
          {autres.map((autre) => (
            <a href={`/panorama/${autre.id}`} class="no-underline">
              <p class="surtitre">{dateFr(autre.data.date)}</p>
              <h2 class="mt-2 text-lg">{autre.data.titre}</h2>
              <p class="mt-2 text-sm text-gris">{autre.data.chapo}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
