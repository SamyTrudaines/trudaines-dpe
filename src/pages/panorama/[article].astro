---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { titreSeo, descriptionSeo } from '../../lib/seo';
import CarteArticle from '../../components/CarteArticle.astro';
import Faq from '../../components/Faq.astro';
import { dateFr, dateIso } from '../../lib/format';
import { site } from '../../data/site';

interface Props { article: CollectionEntry<'articles'> }

export const getStaticPaths: GetStaticPaths = async () => {
  const articles = await getCollection('articles', (a) => !a.data.brouillon);
  return articles.map((a) => ({ params: { article: a.id }, props: { article: a } }));
};

const { article } = Astro.props;
const { Content } = await render(article);

const autres = (await getCollection('articles', (a) => !a.data.brouillon && a.id !== article.id))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

/* Date de mise à jour affichée seulement quand elle diffère de la parution : sinon la ligne ne dirait rien. */
const dateMaj = article.data.dateMaj && dateIso(article.data.dateMaj) !== dateIso(article.data.date) ? article.data.dateMaj : undefined;

const donnees: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.data.titre,
    description: article.data.chapo,
    inLanguage: 'fr-FR',
    datePublished: dateIso(article.data.date),
    dateModified: dateIso(article.data.dateMaj ?? article.data.date),
    author: { '@type': 'Person', '@id': `${site.url}/samy-santamarina#personne`, name: 'Samy Santamarina', url: `${site.url}/samy-santamarina` },
    publisher: { '@id': `${site.url}/#agence` },
    mainEntityOfPage: `${site.url}/panorama/${article.id}`,
    ...(article.data.image ? { image: new URL(article.data.image, site.url).href } : {}),
    keywords: article.data.motsCles.join(', '),
  },
];

/* La FAQ n'est déclarée que si elle est affichée : un balisage qui décrit du texte invisible est un balisage trompeur. */
if (article.data.faq.length > 0) {
  donnees.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: article.data.faq.map((q) => ({
      '@type': 'Question',
      name: q.question,
      acceptedAnswer: { '@type': 'Answer', text: q.reponse },
    })),
  });
}
---
<Layout
  titre={article.data.titreSeo ?? titreSeo([article.data.titre, 'Trudaines'])}
  description={descriptionSeo(article.data.descriptionSeo ?? article.data.chapo)}
  image={article.data.image}
  type="article"
  filAriane={[{ nom: 'Actu', href: '/panorama' }, { nom: article.data.titre }]}
  donnees={donnees}
>
  <article>
    {/*
      Mise en page d'éditorial : titre centré sur une colonne de lecture, photographie plus large
      au ratio 3:2, puis une seule colonne pour l'essentiel, le texte et les questions.
    */}
    <header class="pt-12 sm:pt-20">
      <div class="conteneur-texte text-center">
        <p class="surtitre">
          <time datetime={dateIso(article.data.date)}>{dateFr(article.data.date)}</time>
          {dateMaj && <> · mis à jour le <time datetime={dateIso(dateMaj)}>{dateFr(dateMaj)}</time></>}
        </p>
        <h1 class="titre-1 mt-8 text-balance">{article.data.titre}</h1>
        <span aria-hidden="true" class="mx-auto mt-10 block h-px w-10 bg-[color:var(--color-or-fonce)]"></span>
        <p class="chapo mx-auto mt-10 max-w-[38rem] text-pretty">{article.data.chapo}</p>
      </div>
      {article.data.image && (
        <div class="mx-auto mt-14 w-full max-w-[64rem] sm:mt-20 sm:px-6">
          <img
            src={article.data.image}
            alt={article.data.imageAlt}
            width="1400"
            height="933"
            fetchpriority="high"
            decoding="async"
            class="aspect-[3/2] w-full object-cover"
          />
        </div>
      )}
    </header>

    <div class="section pt-14 sm:pt-20">
      {article.data.essentiel.length > 0 && (
        <div class="conteneur-texte">
          <aside class="essentiel" aria-labelledby="essentiel">
            <h2 id="essentiel" class="surtitre">L'essentiel</h2>
            <ol>
              {article.data.essentiel.map((point, i) => (
                <li>
                  <span aria-hidden="true" class="essentiel-numero">{String(i + 1).padStart(2, '0')}</span>
                  <span>{point}</span>
                </li>
              ))}
            </ol>
          </aside>
        </div>
      )}
      <div class="conteneur-texte prose-trudaines mt-14">
        <Content />
      </div>
      {article.data.faq.length > 0 && <Faq questions={article.data.faq} titre="Les questions que cet article règle" />}
      <div class="conteneur-texte mt-16 border-t border-[color:var(--color-trait)] pt-8">
        <p class="text-sm text-[color:var(--color-ardoise)]">
          Article rédigé par <a href="/samy-santamarina" class="lien-souligne">Samy Santamarina</a>, fondateur de Trudaines,
          agent immobilier titulaire de la carte professionnelle {site.legal.carteT}.{' '}
          <a href="/estimation" class="lien-souligne">Faire estimer mon bien</a>.
        </p>
        {article.data.motsCles.length > 0 && (
          <p class="mt-4 text-xs uppercase tracking-[0.12em] text-[color:var(--color-ardoise)]">
            {article.data.motsCles.join(' · ')}
          </p>
        )}
      </div>
    </div>
  </article>

  {autres.length > 0 && (
    <section class="section filet">
      <div class="conteneur">
        <h2 class="titre-2">À lire également</h2>
        <div class="mt-12 grid gap-12 md:grid-cols-3">
          {autres.map((a) => (
            <CarteArticle id={a.id} titre={a.data.titre} date={a.data.date} chapo={a.data.chapo} image={a.data.image} imageAlt={a.data.imageAlt} />
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
