---
import { evt } from '../lib/entonnoir';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CarteArticle from '../components/CarteArticle.astro';
import Avis from '../components/Avis.astro';
import { avisCommentés, agrégatAvis } from '../lib/avis';
import { site, parrainage } from '../data/site';
import { pourcent, primeVente } from '../lib/bareme';
import { agencesLocales } from '../data/agences-locales';
import { prix } from '../lib/format';
import { secteurs } from '../data/secteurs';
import Ouverture from '../components/Ouverture.astro';
import Manifeste from '../components/Manifeste.astro';
import ReferencesAccueil from '../components/ReferencesAccueil.astro';
import VitrineBiens from '../components/VitrineBiens.astro';
import AlerteExpress from '../components/AlerteExpress.astro';

const biens = (await getCollection('biens', (b) => b.data.statut !== 'vendu' && !b.data.offMarket && !b.data.archive))
  .sort((a, b) => a.data.ordre - b.data.ordre || b.data.prix - a.data.prix)
  .slice(0, 8);

/** Mandats passés : la preuve du travail accompli, sans prix ni disponibilité. */
const mandats = await getCollection('biens', (b) => b.data.archive);
const totalReferences = mandats.length;
const references = mandats
  .filter((b) => b.data.ville === 'Paris')
  .sort((a, b) => b.data.surface - a.data.surface)
  .slice(0, 3);

const articles = (await getCollection('articles', (a) => !a.data.brouillon))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const avis = await avisCommentés(3);
const agregatAvis = await agrégatAvis();
/* Toutes les notes relevées à cinq étoiles, et chaque avis noté : alors seulement « tous à cinq étoiles ». */
const toutCinq = agregatAvis.toutesCinq && agregatAvis.notés === agregatAvis.total;
const preuveAvis = toutCinq
  ? `${agregatAvis.total} avis clients, tous à cinq étoiles`
  : `${agregatAvis.total} avis clients, note moyenne de ${agregatAvis.noteTexte} sur 5`;
const presse = (await getCollection('presse')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 4);

/* Trudaines WinWin : trois exemples calculés au barème exclusif, jamais saisis à la main. */
const exemplesWinWin = [500000, 1000000, 2000000].map((p) => ({ prix: p, prime: primeVente(p) }));

/* Nom du site affiché par Google au-dessus du lien, et lien avec la fiche de l'agence. */
const siteWeb = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#site`,
  name: site.nom,
  alternateName: [site.nomLong, 'Trudaines agence immobilière'],
  url: `${site.url}/`,
  inLanguage: 'fr-FR',
  publisher: { '@id': `${site.url}/#cabinet` },
};

const engagements = [
  {
    titre: 'Un prix argumenté par écrit',
    texte:
      "Vous recevez un avis de valeur qui cite les ventes signées comparables, explique chaque ajustement et assume une fourchette. Pas un chiffre lancé au téléphone pour emporter le mandat.",
  },
  {
    titre: 'Un compte rendu après chaque visite',
    texte:
      "Ce que l'acheteur a dit, ce qui l'a retenu, ce qui l'a fait reculer. Par écrit, le jour même, avec un point de synthèse chaque semaine.",
  },
  {
    titre: 'Un seul interlocuteur',
    texte:
      "Samy Santamarina fait l'estimation, les visites, la négociation et le suivi jusqu'à la signature. Personne ne reprend votre dossier en cours de route.",
  },
];
---
<Layout
  titre="Trudaines, agence immobilière à Paris 9e, 18e et Montmartre"
  description={`Agence immobilière indépendante à Paris : vente, recherche, gestion locative. Avis de valeur écrit offert sous 48 heures. ${preuveAvis}.`}
  enteteSurPhoto
  donnees={[siteWeb]}
>
  <Ouverture />

  <section class="section pt-8">
    <div class="conteneur">
      <h1 class="max-w-4xl">
        <span class="surtitre marque-filet block">Agence immobilière à Paris</span>
        <span class="titre-1 mt-5 block">L'immobilier <span class="whitespace-nowrap">au-delà des murs.</span></span>
      </h1>
      <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,29rem)] lg:items-end lg:gap-16">
        <div>
          <p class="chapo max-w-2xl">
            Derrière chaque adresse, il y a une rue, un marché, une vie. Nous lisons les trois par la donnée
            et défendons votre prix en personne.
          </p>
          {agregatAvis.total > 0 && (
            <a href="/avis" class="preuve-avis" data-evt="accueil_avis">
              {toutCinq && <span class="preuve-avis-etoiles" aria-hidden="true">★★★★★</span>}
              <span>{preuveAvis}</span>
            </a>
          )}
        </div>
        <form action="/estimation#estimation-immediate" method="get" class="estimer-adresse" data-cta-estimation>
          <label for="accueil-adresse" class="etiquette">Combien vaut votre bien ?</label>
          <div class="estimer-adresse-ligne">
            <input
              id="accueil-adresse"
              name="adresse"
              class="champ"
              type="text"
              autocomplete="street-address"
              placeholder="12 avenue Trudaine, 75009 Paris"
              required
            />
            <button type="submit" class="bouton" data-evt="accueil_estimer_adresse">Estimer</button>
          </div>
          <p class="estimer-adresse-note">
            Une fourchette tirée des ventes signées dans votre rue, sans inscription.{' '}
            <a href="/vendre" class="lien-souligne whitespace-nowrap">Notre méthode de vente</a>
          </p>
        </form>
      </div>
      <ul class="reperes mt-16 md:mt-20" aria-label="Estimation : conditions et délais">
        <li>
          <span class="reperes-chiffre">0 €</span>
          <span class="reperes-texte">Estimation sans frais et sans engagement</span>
        </li>
        <li>
          <span class="reperes-chiffre">48 h</span>
          <span class="reperes-texte">Avis de valeur écrit, remis après la visite</span>
        </li>
        <li>
          <span class="reperes-chiffre">24 h</span>
          <span class="reperes-texte">
            Réponse en jours ouvrés, au{' '}
            <a href={`tel:${site.telephoneLien}`} data-evt="clic_telephone" class="lien-souligne whitespace-nowrap">{site.telephone}</a>
          </span>
        </li>
      </ul>
    </div>
  </section>

  {biens.length > 0 ? (
    <section class="section" aria-labelledby="biens-accueil">
      <div class="conteneur">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 id="biens-accueil" class="titre-2">Nos biens à vendre à Paris</h2>
          <a href="/acheter" class="lien-souligne text-sm">Tous les biens à la vente</a>
        </div>
        <div class="mt-12">
          <VitrineBiens biens={biens} />
        </div>
      </div>
    </section>
  ) : (
    references.length > 0 && <ReferencesAccueil references={references} total={totalReferences} />
  )}

  {biens.length > 0 && references.length > 0 && (
    <ReferencesAccueil references={references} total={totalReferences} />
  )}

  <AlerteExpress
    id="alerte-accueil"
    titre="Nos biens partent souvent avant les portails"
    texte="Chaque nouveau bien est présenté d'abord à notre fichier d'acquéreurs. Trois champs, et vous en faites partie."
    origine="Accueil"
    evt={evt('alerte', 'accueil')}
  />

  <section class="section filet" aria-labelledby="engagements">
    <div class="conteneur">
      <h2 id="engagements" class="titre-2 max-w-2xl">Ce qui change concrètement quand vous nous confiez une vente</h2>
      <div class="mt-14 grid gap-x-12 gap-y-14 md:grid-cols-3">
        {engagements.map((e, n) => (
          <div class="grid grid-cols-[auto_1fr] gap-x-5">
            <p class="chiffre" aria-hidden="true">{String(n + 1).padStart(2, '0')}</p>
            <div>
              <h3 class="titre-3">{e.titre}</h3>
              <p class="mt-4 text-[color:var(--color-ardoise)]">{e.texte}</p>
            </div>
          </div>
        ))}
      </div>
      <a href="/vendre" class="lien-souligne mt-12 inline-block text-sm">Les sept engagements de la méthode Trudaines</a>
    </div>
  </section>

  <Avis avis={avis} agregat={agregatAvis} />

  <section class="section filet" aria-labelledby="winwin-accueil">
    <div class="conteneur">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-16">
        <div class="max-w-2xl">
          <p class="surtitre marque-filet">{parrainage.nom}</p>
          <h2 id="winwin-accueil" class="titre-2 mt-6">
            Un proche vend ? Votre recommandation vaut {pourcent(parrainage.part)} de nos honoraires.
          </h2>
          <p class="mt-6 text-[color:var(--color-ardoise)]">
            Vous nous présentez, nous faisons le reste. Votre proche est entre de bonnes mains, et vous recevez
            votre prime après la signature chez le notaire. Un achat ou une mise en location ? Même principe.
          </p>
        </div>
        <div class="flex flex-wrap gap-4">
          <a href="/recommander#simulateur" class="bouton" data-evt="accueil_winwin_simulateur">Calculer ma prime</a>
          <a href="/recommander#formulaire-winwin" class="bouton bouton-secondaire" data-evt="accueil_winwin_recommander">Recommander un proche</a>
        </div>
      </div>
      <ul class="reperes mt-14" aria-label="Exemples de primes WinWin, au barème du mandat exclusif">
        {exemplesWinWin.map((e) => (
          <li>
            <span class="reperes-chiffre">{prix(e.prime)}</span>
            <span class="reperes-texte">pour la vente d'un bien à <span class="whitespace-nowrap">{prix(e.prix)}</span></span>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-xs text-[color:var(--color-ardoise)]">Au barème du mandat exclusif, sur nos honoraires hors taxes.</p>
    </div>
  </section>

  <Manifeste />

  <section class="section filet" aria-labelledby="territoire">
    <div class="conteneur">
      <h2 id="territoire" class="titre-2 max-w-2xl">Notre territoire</h2>
      <p class="chapo mt-6 max-w-2xl">
        Quatre arrondissements contigus, un seul bassin d'acheteurs. Chaque estimation s'y appuie sur les
        ventes signées des rues voisines, pas sur une moyenne de ville.
      </p>
      <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {secteurs.map((s) => (
          <a href={s.hrefAgence} class="bloc group block no-underline">
            <h3 class="titre-3 group-hover:underline group-hover:decoration-[color:var(--color-or)] group-hover:decoration-1 group-hover:underline-offset-4">{s.nom}</h3>
            <p class="mt-4 text-sm text-[color:var(--color-ardoise)]">{s.intro.split('.')[0]}.</p>
          </a>
        ))}
      </div>
      <p class="mt-12 flex flex-wrap gap-x-8 gap-y-3 text-sm">
        {agencesLocales.map((l) => (
          <a href={`/agence-immobiliere-${l.slug}`} class="lien-souligne" data-evt="accueil_agence_locale">Agence immobilière {l.nom}</a>
        ))}
      </p>
    </div>
  </section>

  {presse.length > 0 && (
    <section class="section filet" aria-labelledby="presse-accueil">
      <div class="conteneur">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 id="presse-accueil" class="titre-2">Ils parlent de nous</h2>
          <a href="/presse" class="lien-souligne text-sm">Toutes les retombées</a>
        </div>
        <div class="mt-12 grid gap-10 md:grid-cols-4">
          {presse.map((p) => (
            <div>
              <p class="surtitre">{p.data.media}</p>
              <p class="mt-4 text-sm text-[color:var(--color-ardoise)]">{p.data.citation}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {articles.length > 0 && (
    <section class="section" aria-labelledby="panorama-accueil">
      <div class="conteneur">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 id="panorama-accueil" class="titre-2">L'actu du marché</h2>
          <a href="/panorama" class="lien-souligne text-sm">Tous les articles</a>
        </div>
        <div class="mt-12 grid gap-12 md:grid-cols-3">
          {articles.map((a) => (
            <CarteArticle id={a.id} titre={a.data.titre} date={a.data.date} chapo={a.data.chapo} image={a.data.image} imageAlt={a.data.imageAlt} />
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
