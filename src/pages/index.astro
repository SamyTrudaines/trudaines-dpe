---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CarteArticle from '../components/CarteArticle.astro';
import Avis from '../components/Avis.astro';
import { avisCommentés, agrégatAvis } from '../lib/avis';
import { site, parrainage } from '../data/site';
import { pourcent } from '../lib/bareme';
import { estimationsQuartiers } from '../data/estimations-quartiers';
import { agencesLocales } from '../data/agences-locales';
import { prix } from '../lib/format';
import { secteurs } from '../data/secteurs';
import Ouverture from '../components/Ouverture.astro';
import Manifeste from '../components/Manifeste.astro';
import ReferencesAccueil from '../components/ReferencesAccueil.astro';
import VitrineBiens from '../components/VitrineBiens.astro';

const biens = (await getCollection('biens', (b) => b.data.statut !== 'vendu' && !b.data.offMarket && !b.data.archive))
  .sort((a, b) => a.data.ordre - b.data.ordre || b.data.prix - a.data.prix)
  .slice(0, 8);

/** Mandats passés : la preuve du travail accompli, sans prix ni disponibilité. */
const mandats = await getCollection('biens', (b) => b.data.archive);
const totalReferences = mandats.length;
const references = mandats
  .filter((b) => b.data.ville === 'Paris')
  .sort((a, b) => Number(b.data.statut === 'vendu') - Number(a.data.statut === 'vendu') || b.data.surface - a.data.surface)
  .slice(0, 3);

const articles = (await getCollection('articles', (a) => !a.data.brouillon))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const avis = await avisCommentés(3);
const agregatAvis = await agrégatAvis();
/* Toutes les notes relevées à cinq étoiles, et chaque avis noté : alors seulement « tous à cinq étoiles ». */
const toutCinq = agregatAvis.toutesCinq && agregatAvis.notés === agregatAvis.total;
/* Le nombre de la fiche Google, vérifiable par chacun, plutôt que les seuls avis repris sur /avis. */
const preuveAvis = `${site.avis.google.total} avis Google`;
const presse = (await getCollection('presse')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 4);


/* Nom du site affiché par Google au-dessus du lien, et lien avec la fiche de l'agence. */
const siteWeb = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#site`,
  name: site.nom,
  alternateName: [site.nomLong, 'Trudaines agence immobilière'],
  url: `${site.url}/`,
  inLanguage: 'fr-FR',
  publisher: { '@id': `${site.url}/#agence` },
};

const engagements = [
  {
    titre: 'Un prix argumenté par écrit',
    texte:
      "Vous recevez un avis de valeur qui cite les ventes signées comparables, explique chaque ajustement et assume une fourchette. Pas un chiffre lancé au téléphone pour emporter le mandat.",
  },
  {
    titre: 'Un compte rendu après chaque visite',
    texte:
      "Ce que l'acheteur a dit, ce qui l'a retenu, ce qui l'a fait reculer. Par écrit, le jour même, avec un point de synthèse chaque semaine.",
  },
  {
    titre: 'Un seul interlocuteur',
    texte:
      "Samy Santamarina fait l'estimation, les visites, la négociation et le suivi jusqu'à la signature. Personne ne reprend votre dossier en cours de route.",
  },
];
/* Les quatre arrondissements contigus du coeur de l'agence ; le 7e et le 16e restent en liens. */
const coeur = ['paris-9', 'paris-18', 'paris-17', 'paris-10'];
---
<Layout
  ancreEstimation="#accueil-adresse"
  titre="Trudaines, agence immobilière à Paris 9e, 18e et Montmartre"
  description={`Agence immobilière indépendante à Paris : vente, recherche, gestion locative. Estimation en 24 heures, avis de valeur écrit offert. ${preuveAvis}.`}
  enteteSurPhoto
  donnees={[siteWeb]}
>
  <Ouverture />

  {/* Titre, preuve et estimation en un seul écran : les biens commencent au premier défilement. */}
  <section class="pb-8 pt-8 md:pb-6">
    <div class="conteneur">
      <h1 class="max-w-4xl">
        <span class="surtitre marque-filet block">Agence immobilière à Paris</span>
        <span class="titre-1 mt-5 block">L'immobilier <span class="whitespace-nowrap">au-delà des murs.</span></span>
      </h1>
      <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,29rem)] lg:items-stretch lg:gap-16">
        <div>
          <p class="chapo max-w-2xl">
            <span class="block">Guidés par la passion et l'humain.</span>
            <span class="block">En avance, par la technologie.</span>
          </p>
          {/* Qui, où, quoi, en une phrase lisible hors contexte : c'est elle qu'un assistant reprend pour présenter l'agence. */}
          <p class="mt-5 max-w-2xl text-[color:var(--color-ardoise)]" id="reponse-courte">
            Trudaines Immobilier est une agence immobilière indépendante fondée en septembre 2024 par Samy Santamarina,
            installée au {site.adresse.rue}, Paris {site.adresse.codePostal.replace(/^750/, '')}e. Vente, estimation écrite remise sous 24 heures
            après visite, recherche pour acquéreurs et gestion locative, dans les 9e, 10e, 17e et 18e arrondissements et dans tout Paris.
          </p>
          {agregatAvis.total > 0 && (
            <a href="/avis" class="preuve-avis" data-evt="accueil_avis">
              {toutCinq && <span class="preuve-avis-etoiles" aria-hidden="true">★★★★★</span>}
              <span>{preuveAvis}</span>
            </a>
          )}
        </div>
        <form action="/estimation#avis-de-valeur" method="get" class="estimer-adresse" data-cta-estimation>
          <label for="accueil-adresse" class="etiquette">Combien vaut votre bien ?</label>
          <div class="estimer-adresse-ligne">
            <input
              id="accueil-adresse"
              name="adresse"
              class="champ"
              type="text"
              autocomplete="street-address"
              placeholder="12 avenue Trudaine, 75009 Paris"
              required
            />
            <button type="submit" class="bouton" data-evt="accueil_estimer_adresse">Estimer</button>
          </div>
          <p class="estimer-adresse-note">
            Gratuit, moins d'une minute, à partir des ventes signées dans votre rue.{' '}
            <a href="/vendre" class="lien-souligne whitespace-nowrap">Notre méthode de vente</a>
          </p>
        </form>
      </div>
    </div>
  </section>

  {biens.length > 0 ? (
    <section class="pb-8 pt-6 md:pb-10 md:pt-6" aria-labelledby="biens-accueil">
      <div class="conteneur">
        <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
          <h2 id="biens-accueil" class="titre-2">Nos biens à vendre à Paris</h2>
          <a href="/acheter" class="lien-souligne text-sm">Tous les biens à la vente</a>
        </div>
        <div class="mt-8 md:mt-10">
          <VitrineBiens biens={biens} />
        </div>
      </div>
    </section>
  ) : (
    references.length > 0 && <ReferencesAccueil references={references} total={totalReferences} />
  )}

  <section class="pb-2 md:pb-4">
    <div class="conteneur">
      <ul class="reperes reperes-deux" aria-label="Estimation : conditions et délais">
        <li>
          <span class="reperes-chiffre">0 €</span>
          <span class="reperes-texte">Estimation sans frais dans le cadre de votre projet immobilier</span>
        </li>
        <li>
          <span class="reperes-chiffre">24 h</span>
          <span class="reperes-texte">
            Estimation en 24 heures. Appelez le{' '}
            <a href={`tel:${site.telephoneLien}`} data-evt="clic_telephone" class="lien-souligne whitespace-nowrap">{site.telephone}</a>
          </span>
        </li>
      </ul>
    </div>
  </section>

  {biens.length > 0 && references.length > 0 && (
    <ReferencesAccueil references={references} total={totalReferences} />
  )}

  <Avis avis={avis} agregat={agregatAvis} />

  <section class="pb-16 md:pb-20" aria-labelledby="winwin-accueil">
    <div class="conteneur">
      <div class="carre-winwin">
        <p class="surtitre">{parrainage.nom}</p>
        <h2 id="winwin-accueil" class="titre-3 mt-5">Vos proches, entre de bonnes mains.</h2>
        <p class="mt-4 text-sm text-[color:var(--color-ardoise)]">
          Trudaines grandit par la recommandation de ses clients. Quand vous nous présentez un proche qui vend,
          achète ou loue, nous vous remercions : {pourcent(parrainage.part)} de nos honoraires hors taxes, une fois
          l'opération signée.
        </p>
        <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          <a href="/recommander#formulaire-winwin" class="lien-souligne" data-evt="accueil_winwin_recommander">Recommander un proche</a>
          <a href="/recommander#simulateur" class="lien-souligne" data-evt="accueil_winwin_simulateur">Calculer ma prime</a>
        </p>
      </div>
    </div>
  </section>

  {presse.length > 0 && (
    <section class="section filet" aria-labelledby="presse-accueil">
      <div class="conteneur">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 id="presse-accueil" class="titre-2">Ils parlent de nous</h2>
          <a href="/presse" class="lien-souligne text-sm">Toutes les retombées</a>
        </div>
        <ul class="reperes presse-accueil mt-12">
          {presse.map((p) => (
            <li>
              <p class="surtitre whitespace-nowrap">{p.data.media}</p>
              <p class="presse-citation mt-5">« {p.data.citation} »</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section filet" aria-labelledby="engagements">
    <div class="conteneur">
      <h2 id="engagements" class="titre-2 max-w-2xl">Ce qui change concrètement quand vous nous confiez une vente</h2>
      <div class="mt-14 grid gap-x-12 gap-y-14 md:grid-cols-2 xl:grid-cols-3">
        {engagements.map((e, n) => (
          <div class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-5">
            <p class="chiffre" aria-hidden="true">{String(n + 1).padStart(2, '0')}</p>
            <div>
              <h3 class="titre-3">{e.titre}</h3>
              <p class="mt-4 text-[color:var(--color-ardoise)]">{e.texte}</p>
            </div>
          </div>
        ))}
      </div>
      <a href="/vendre" class="lien-souligne mt-12 inline-block text-sm">Les sept engagements de la méthode Trudaines</a>
    </div>
  </section>

  <section class="section filet" aria-labelledby="territoire">
    <div class="conteneur">
      <h2 id="territoire" class="titre-2 max-w-2xl">Notre territoire</h2>
      <p class="chapo mt-6 max-w-2xl">
        Quatre arrondissements contigus, un seul bassin d'acheteurs. Chaque estimation s'y appuie sur les
        ventes signées des rues voisines, pas sur une moyenne de ville.
      </p>
      <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {secteurs.filter((s) => coeur.includes(s.slug)).map((s) => (
          <a href={s.hrefAgence} class="bloc group block no-underline">
            <h3 class="titre-3 group-hover:underline group-hover:decoration-[color:var(--color-or)] group-hover:decoration-1 group-hover:underline-offset-4">{s.nom}</h3>
            <p class="mt-4 text-sm text-[color:var(--color-ardoise)]">{s.intro.split('.')[0]}.</p>
          </a>
        ))}
      </div>
      <p class="mt-12 text-[color:var(--color-ardoise)]">
        Nous vendons aussi dans le 7e et le 16e :{' '}
        {secteurs.filter((s) => !coeur.includes(s.slug)).map((s, i) => (
          <>{i > 0 && ' et '}<a href={s.hrefAgence} class="lien-souligne whitespace-nowrap" data-evt="accueil_agence_secteur">{s.nom}</a></>
        ))}.
      </p>
      <details class="liens-territoire mt-8">
        <summary class="lien-souligne text-sm">Toutes nos pages d'estimation et d'agence</summary>
        <p class="mt-12 flex flex-wrap gap-x-8 gap-y-3 text-sm">
          {agencesLocales.map((l) => (
            <a href={`/agence-immobiliere-${l.slug}`} class="lien-souligne" data-evt="accueil_agence_locale">Agence immobilière {l.nom}</a>
          ))}
        </p>
        <p class="mt-4 flex flex-wrap gap-x-8 gap-y-3 text-sm">
          {secteurs.map((s) => (
            <a href={`/estimation/${s.slug}`} class="lien-souligne" data-evt="accueil_estimation_secteur">Estimation {s.nom}</a>
          ))}
          {estimationsQuartiers.map((q) => (
            <a href={`/estimation/${q.secteur}/${q.slug}`} class="lien-souligne" data-evt="accueil_estimation_quartier">Estimation {q.nom}</a>
          ))}
        </p>
      </details>
    </div>
  </section>

  <Manifeste />

  <section class="section filet" aria-labelledby="rejoindre-accueil">
    <div class="conteneur">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-16">
        <div class="max-w-2xl">
          <p class="surtitre marque-filet">Nous rejoindre</p>
          <h2 id="rejoindre-accueil" class="titre-2 mt-6">Apprendre le métier sur quelques rues, pas sur un département.</h2>
          <p class="mt-6 text-[color:var(--color-ardoise)]">
            Trudaines recrute des profils qui veulent faire de la transaction en profondeur, autour de la Butte,
            du 9e et des Batignolles : sortie d'école, reconversion ou agent confirmé. Un secteur, une formation
            au métier, des outils qui font gagner du temps, une rémunération claire.
          </p>
        </div>
        <div class="flex flex-wrap gap-4">
          <a href="/nous-rejoindre#candidature" class="bouton" data-evt="accueil_recrutement_candidature">Déposer ma candidature</a>
          <a href="/nous-rejoindre" class="bouton bouton-secondaire" data-evt="accueil_recrutement_decouvrir">Découvrir le poste</a>
        </div>
      </div>
    </div>
  </section>

  {articles.length > 0 && (
    <section class="section" aria-labelledby="panorama-accueil">
      <div class="conteneur">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 id="panorama-accueil" class="titre-2">L'actu du marché</h2>
          <a href="/panorama" class="lien-souligne text-sm">Tous les articles</a>
        </div>
        <div class="mt-12 grid gap-12 md:grid-cols-3">
          {articles.map((a) => (
            <CarteArticle id={a.id} titre={a.data.titre} date={a.data.date} chapo={a.data.chapo} image={a.data.image} imageAlt={a.data.imageAlt} />
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
