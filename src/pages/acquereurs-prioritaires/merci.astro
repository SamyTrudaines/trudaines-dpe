---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  titre="Confirmez votre adresse | Trudaines"
  description="Un email de confirmation vient de partir : cliquez sur son lien pour recevoir les biens en priorité."
  noindex={true}
  cta={false}
>
  <section class="section pt-20">
    <div class="conteneur-texte text-center">
      <p class="surtitre">Acquéreurs prioritaires</p>
      <h1 class="titre-1 mt-6">Un dernier clic</h1>
      <p class="chapo mt-8">
        Je viens de vous envoyer un email. Cliquez sur « Confirmer mon inscription » : sans ce clic, vous ne
        recevrez rien. S'il n'arrive pas, regardez dans les courriers indésirables.
      </p>
    </div>
  </section>
</Layout>
