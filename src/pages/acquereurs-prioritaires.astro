---
import Layout from '../layouts/Layout.astro';
import { ARRONDISSEMENTS } from '../../functions/_lib/acquereurs.js';

/**
 * Inscription d'un acquéreur prioritaire : les biens de l'agence lui arrivent
 * par email avant leur diffusion sur les portails. Page envoyée en lien direct,
 * jamais indexée. Le lien peut porter les critères déjà connus, que
 * public/js/acquereurs.js reporte dans le formulaire : arr (75018,75009),
 * budget, surface, pieces, financement (credit ou comptant), entree (AAAA-MM-JJ),
 * prenom, nom. L'email, lui, est toujours saisi par l'acquéreur.
 */
const libelle = (code: string) => {
  const n = Number(code.slice(3));
  return `${n}${n === 1 ? 'er' : 'e'}`;
};
---
<Layout
  titre="Acquéreurs prioritaires | Trudaines"
  description="Recevez les biens de l'agence Trudaines avant leur diffusion sur les portails, selon vos critères."
  noindex={true}
  cta={false}
>
  <section class="section pt-20">
    <div class="conteneur max-w-3xl">
      <p class="surtitre">Acquéreurs prioritaires</p>
      <h1 class="titre-1 mt-6">Les biens avant les portails</h1>
      <p class="chapo mt-8">
        Quand un bien correspond à vos critères, vous le recevez par email avant sa diffusion publique, avec ses
        photos et son prix. Rien d'autre, et rien avant que vous ayez confirmé votre adresse.
      </p>

      <form
        class="mt-12 border border-[color:var(--color-trait)] bg-white p-6 md:p-8"
        method="POST"
        action="/api/acquereur-prioritaire"
        data-trudaines
        data-evenement="acquereur_prioritaire"
        data-acquereurs
      >
        <input type="hidden" name="horodatage" value="" />
        <div class="absolute h-0 w-0 overflow-hidden" aria-hidden="true">
          <label for="controle-acquereur">Ne pas remplir</label>
          <input type="text" id="controle-acquereur" name="controle" tabindex="-1" autocomplete="off" />
        </div>
        <div data-corps>
          <fieldset class="border-0 p-0">
            <legend class="titre-3">Où cherchez-vous ?</legend>
            <p class="mt-3 text-sm text-[color:var(--color-ardoise)]">Un ou plusieurs arrondissements.</p>
            {/* Chaque arrondissement est une étiquette de 44 px : la case reste dans le formulaire, invisible, l'étiquette se noircit quand elle est cochée. */}
            <div class="mt-6 grid grid-cols-5 gap-[6px]">
              {ARRONDISSEMENTS.map((code) => (
                <label class="flex min-h-[44px] cursor-pointer items-center justify-center border border-[color:var(--color-trait)] text-sm has-checked:border-[color:var(--color-encre)] has-checked:bg-[color:var(--color-encre)] has-checked:text-white has-focus-visible:outline-2 has-focus-visible:outline-offset-2">
                  <input class="sr-only" type="checkbox" name="arrondissements" value={code} data-arrondissement />
                  {libelle(code)}
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="mt-10 border-0 p-0">
            <legend class="titre-3">Votre recherche</legend>
            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              <div>
                <label class="etiquette" for="acq-budget">Budget maximum en euros</label>
                <input class="champ" id="acq-budget" name="budget" type="number" min="100000" step="10000" required inputmode="numeric" placeholder="800 000" />
              </div>
              <div>
                <label class="etiquette" for="acq-financement">Financement</label>
                <select class="champ" id="acq-financement" name="financement" required>
                  <option value="">Choisir</option>
                  <option value="Crédit">Crédit</option>
                  <option value="Comptant">Comptant</option>
                </select>
              </div>
              <div>
                <label class="etiquette" for="acq-surface">Surface minimum en m², facultatif</label>
                <input class="champ" id="acq-surface" name="surface" type="number" min="10" inputmode="numeric" />
              </div>
              <div>
                <label class="etiquette" for="acq-pieces">Pièces, au moins</label>
                <select class="champ" id="acq-pieces" name="pieces">
                  <option value="">Indifférent</option>
                  <option value="1">1 pièce</option>
                  <option value="2">2 pièces</option>
                  <option value="3">3 pièces</option>
                  <option value="4">4 pièces</option>
                  <option value="5">5 pièces et plus</option>
                </select>
              </div>
              <div>
                <label class="etiquette" for="acq-entree">Date d'entrée souhaitée, facultatif</label>
                <input class="champ" id="acq-entree" name="entree" type="date" />
              </div>
            </div>
          </fieldset>

          <fieldset class="mt-10 border-0 p-0">
            <legend class="titre-3">Pour vous prévenir</legend>
            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              <div>
                <label class="etiquette" for="acq-prenom">Prénom</label>
                <input class="champ" id="acq-prenom" name="prenom" type="text" autocomplete="given-name" required />
              </div>
              <div>
                <label class="etiquette" for="acq-nom">Nom, facultatif</label>
                <input class="champ" id="acq-nom" name="nom" type="text" autocomplete="family-name" />
              </div>
              <div>
                <label class="etiquette" for="acq-email">Email</label>
                <input class="champ" id="acq-email" name="email" type="email" autocomplete="email" required />
              </div>
              <div>
                <label class="etiquette" for="acq-telephone">Téléphone, facultatif</label>
                <input class="champ" id="acq-telephone" name="telephone" type="tel" autocomplete="tel" />
              </div>
              <div class="sm:col-span-2">
                <label class="etiquette" for="acq-precisions">Précisions, facultatif</label>
                <textarea class="champ" id="acq-precisions" name="precisions" rows="3" placeholder="Étage, extérieur, rues à éviter..."></textarea>
              </div>
            </div>
          </fieldset>

          <div class="mt-6 flex items-start gap-3">
            <input class="mt-1 h-5 w-5 shrink-0 accent-[color:var(--color-nuit)]" id="acq-consentement" name="consentement" type="checkbox" required value="oui" />
            <label class="text-sm text-[color:var(--color-ardoise)]" for="acq-consentement">
              J'accepte de recevoir par email les biens qui correspondent à ma recherche. Je peux arrêter à tout moment.{' '}
              <a href="/politique-de-confidentialite" class="lien-souligne">Politique de confidentialité</a>.
            </label>
          </div>
          <button type="submit" class="bouton mt-8 w-full sm:w-auto">Recevoir les biens en priorité</button>
          <p class="mt-4 text-sm text-[#a4262c]" data-erreur hidden></p>
        </div>
        <div data-confirmation hidden class="py-2">
          <h2 class="titre-3">Un dernier clic</h2>
          <p class="mt-4 text-[color:var(--color-ardoise)]">
            Je viens de vous envoyer un email. Cliquez sur « Confirmer mon inscription » : sans ce clic, vous ne
            recevrez rien. S'il n'arrive pas, regardez dans les courriers indésirables.
          </p>
        </div>
      </form>
    </div>
  </section>
  <script is:inline src="/js/acquereurs.js" defer></script>
</Layout>
