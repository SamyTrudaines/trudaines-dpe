---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { nombre } from '../../data/site';

const quartiers = (await getCollection('quartiers')).sort((a, b) => a.data.ordre - b.data.ordre);
---
<Base
  title="Quartiers | Prix et marché à Paris 9e, 18e et 10e - Trudaines"
  description="Les cinq quartiers couverts par Trudaines : Trudaine Maubeuge, Martyrs Lorette, Clichy Trinité, Montmartre et Lariboisière Rocroy. Prix et marché."
  ariane={[{ nom: 'Quartiers', url: '/quartiers' }]}
>
  <section class="border-b border-ligne">
    <div class="conteneur py-16 lg:py-20">
      <p class="surtitre">Territoire</p>
      <h1 class="mt-6 max-w-3xl text-3xl leading-tight lg:text-4xl">Cinq quartiers, connus rue par rue</h1>
      <p class="mt-6 max-w-2xl text-lg text-gris">
        Nous travaillons à pied. Ce périmètre resserré est un choix, il permet de connaître les immeubles,
        les copropriétés et les écarts de prix d'une rue à l'autre.
      </p>
    </div>
  </section>

  <section class="conteneur py-16 lg:py-24">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
      {quartiers.map((q) => (
        <a href={`/quartiers/${q.id}`} class="group block no-underline">
          <div class="aspect-[3/2] overflow-hidden bg-creme">
            {q.data.photos[0] && (
              <img src={q.data.photos[0].src} alt={q.data.photos[0].alt} width="600" height="400" loading="lazy" decoding="async" class="h-full w-full object-cover" />
            )}
          </div>
          <p class="surtitre mt-5">Paris {q.data.arrondissement}</p>
          <h2 class="mt-2 text-xl">{q.data.nom}</h2>
          <p class="mt-2 text-sm text-gris">{nombre(q.data.prixMoyenM2)} euros le m² en moyenne</p>
          <p class="mt-3 text-sm text-gris">{q.data.chapo}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
