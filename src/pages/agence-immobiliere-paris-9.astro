---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BlocAgence from '../components/BlocAgence.astro';
import Avis from '../components/Avis.astro';
import { avisCommentés, agrégatAvis, preuveAvis } from '../lib/avis';
import { getSecteur } from '../data/secteurs';
import EnBref from '../components/EnBref.astro';
import { agencesLocales } from '../data/agences-locales';
import { site } from '../data/site';
import { lignesEnBref, faqAgence, faqEnDonnees } from '../lib/agence';
import { distance } from '../lib/quartiers';
import { arrondissements, periode } from '../lib/rues';
import { prix, nombre } from '../lib/format';
const preuve = await preuveAvis();

const secteur = getSecteur('paris-9')!;
const quartiers = (await getCollection('quartiers')).filter((q) => secteur.quartiers.includes(q.id)).sort((a, b) => a.data.ordre - b.data.ordre);
const avis = await avisCommentés(3);
const agregatAvis = await agrégatAvis();

const chiffres = arrondissements['75009'];
const trudaine = agencesLocales.find((l) => l.slug === 'trudaine')!;
const metres = Math.round(distance({ lon: site.adresse.longitude, lat: site.adresse.latitude }, trudaine.repere) / 10) * 10;
const bureau = `à ${nombre(metres)} mètres de l'avenue Trudaine à vol d'oiseau`;
const prixPhrase = `Médiane de ${prix(chiffres.mediane)} le mètre carré sur ${nombre(chiffres.ventes)} ventes d'appartements de ${periode} ; huit ventes sur dix entre ${prix(chiffres.d1)} et ${prix(chiffres.d9)}.`;
const enBref = await lignesEnBref({ dans: 'dans le 9e arrondissement', bureau, prix: prixPhrase, lienPrix: '/prix-immobilier#arr-75009' });
const locales = agencesLocales.filter((l) => l.codePostal === '75009');
const faq = [
  { question: 'Quel est le prix au mètre carré dans le 9e arrondissement ?', reponse: `${prixPhrase} L'écart d'une rue à l'autre est large : nous publions le prix de chaque voie de l'arrondissement.` },
  { question: 'Quels quartiers du 9e couvrez-vous ?', reponse: "Le 9e nord : Saint-Georges et la Nouvelle Athènes, l'avenue Trudaine, Martyrs et Lorette, Clichy et la Trinité, Rochechouart. Pour un bien ailleurs dans l'arrondissement, nous prenons le rendez-vous avec la même méthode." },
  ...faqAgence({ dans: 'dans le 9e arrondissement', bureau }),
];

const services = [
  { titre: 'Vente et mandat', texte: "Mise en marché complète : avis de valeur écrit, photographies, diffusion, visites qualifiées, négociation et suivi jusqu'à l'acte.", href: '/vendre' },
  { titre: 'Estimation', texte: "Un avis de valeur documenté sous 48 heures après la visite, gratuit et sans engagement.", href: '/estimation/paris-9' },
  { titre: 'Recherche pour acquéreur', texte: "Mandat de recherche pour les acheteurs qui veulent accéder aux biens avant leur diffusion publique.", href: '/chasse' },
];
---
<Layout
  titre={secteur.titreAgence}
  description={`${secteur.descriptionAgence} ${preuve}`}
  filAriane={[{ nom: 'Agence immobilière Paris 9e' }]}
  donnees={[faqEnDonnees(faq)]}
>
  <BlocAgence
    h1="Agence immobilière à Paris 9e, du côté nord de l'arrondissement"
    intro={secteur.introAgence}
    secteurNom="le 9e arrondissement"
    hrefEstimation="/estimation/paris-9"
    quartiers={quartiers}
    services={services}
  >
    <EnBref titre="Trudaines dans le 9e, en bref" lignes={enBref} />
  </BlocAgence>

  <section class="section filet" aria-labelledby="secteurs-9">
    <div class="conteneur">
      <h2 id="secteurs-9" class="titre-2">Nos secteurs du 9e, rue par rue</h2>
      <div class="mt-12 grid gap-10 md:grid-cols-2">
        {locales.map((l) => (
          <div class="bloc">
            <h3 class="titre-3"><a href={`/agence-immobiliere-${l.slug}`} class="no-underline hover:underline">Agence immobilière {l.nom}</a></h3>
            <p class="mt-4 text-[color:var(--color-ardoise)]">{l.chapo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section filet">
    <div class="conteneur max-w-3xl">
      <h2 class="titre-2">Pourquoi quatre arrondissements travaillés au mètre carré</h2>
      <p class="mt-6 text-[color:var(--color-ardoise)]">
        Une agence qui couvre toute l'Île-de-France connaît mal chaque rue. Nous avons choisi l'inverse : quatre
        arrondissements limitrophes travaillés au mètre carré, 458 voies suivies en permanence, et la capacité
        de dire à un vendeur ce qui s'est signé au deuxième étage de l'immeuble d'en face, il y a quatre mois.
      </p>
      <p class="mt-6 text-[color:var(--color-ardoise)]">
        C'est ce qui nous permet d'assumer un prix par écrit et de le défendre devant un acheteur, un notaire ou une
        banque. Et c'est ce qui nous permet aussi de vous dire, parfois, que votre bien vaut moins que ce que vous
        espériez.
      </p>
      <p class="mt-8">
        <a href="/trudaines" class="lien-souligne">Découvrir l'agence</a>
      </p>
    </div>
  </section>
  <section class="section filet" aria-labelledby="questions-9">
    <div class="conteneur max-w-3xl">
      <h2 id="questions-9" class="titre-2">Les questions que l'on nous pose sur le 9e</h2>
      <dl class="mt-10 divide-y divide-[color:var(--color-trait)] border-y border-[color:var(--color-trait)]">
        {faq.map((q) => (
          <div class="py-8">
            <dt class="titre-3">{q.question}</dt>
            <dd class="mt-4 text-[color:var(--color-ardoise)]">{q.reponse}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
  <Avis avis={avis} agregat={agregatAvis} />
</Layout>
