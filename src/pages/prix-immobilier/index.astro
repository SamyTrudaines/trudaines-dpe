---
import Layout from '../../layouts/Layout.astro';
import BlocCta from '../../components/BlocCta.astro';
import { nombre } from '../../lib/format';
import { rues, arrondissements, periode, ventesMinimum } from '../../lib/rues';
import { site } from '../../data/site';

const euros = (valeur: number) => `${nombre(valeur)} €`;

const groupes = Object.entries(arrondissements)
  .map(([code, a]) => ({
    code,
    ...a,
    rues: rues.filter((r) => r.codePostal === code),
  }))
  .filter((g) => g.rues.length > 0)
  .sort((a, b) => a.code.localeCompare(b.code));

const totalVentes = rues.reduce((somme, r) => somme + r.ventes, 0);

const donnees = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Prix immobilier rue par rue, Paris 9e, 10e et 18e',
    description: `Prix au mètre carré de ${rues.length} voies de Paris, calculés sur ${nombre(totalVentes)} ventes d'appartements.`,
    url: `${site.url}/prix-immobilier`,
  },
];
---
<Layout
  titre="Prix immobilier rue par rue, Paris 9e, 10e et 18e | Trudaines"
  description={`Le prix au m² de ${rues.length} voies de Paris 9e, 10e et 18e, calculé sur ${nombre(totalVentes)} ventes d'appartements signées devant notaire.`}
  filAriane={[{ nom: 'Prix par rue' }]}
  donnees={donnees}
  cta={false}
>
  <section class="section pt-10">
    <div class="conteneur max-w-3xl">
      <p class="surtitre">Ventes signées, {periode}</p>
      <h1 class="titre-1 mt-6">Le prix au mètre carré, rue par rue</h1>
      <p class="chapo mt-8">
        {rues.length} voies de Paris 9e, 10e et 18e, mesurées sur {nombre(totalVentes)} ventes d'appartements
        enregistrées devant notaire. Pas une estimation, pas une annonce : des ventes signées.
      </p>
      <p class="mt-6 text-sm text-[color:var(--color-ardoise)]">
        Une voie n'apparaît ici qu'à partir de {ventesMinimum} ventes sur la période. En dessous, une médiane
        ne mesure rien et nous préférons ne rien publier.
      </p>
    </div>
  </section>

  {groupes.map((groupe) => (
    <section class="section filet" aria-labelledby={`arr-${groupe.code}`}>
      <div class="conteneur">
        <div class="flex flex-wrap items-baseline justify-between gap-6">
          <h2 id={`arr-${groupe.code}`} class="titre-2">{groupe.nom}</h2>
          <p class="text-sm text-[color:var(--color-ardoise)]">
            Médiane {euros(groupe.mediane)} le m² · {groupe.rues.length} voies mesurées · {nombre(groupe.ventes)} ventes
          </p>
        </div>
        <div class="mt-10 grid gap-x-10 gap-y-0 sm:grid-cols-2 lg:grid-cols-3">
          {groupe.rues.map((r) => (
            <a href={`/prix-immobilier/${r.slug}`} class="flex items-baseline justify-between gap-4 border-t border-[color:var(--color-trait)] py-3.5 no-underline">
              <span class="text-[color:var(--color-encre)]">{r.nom}</span>
              <span class="whitespace-nowrap text-sm text-[color:var(--color-ardoise)]">{euros(r.mediane)}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <BlocCta
    titre="Votre rue n'est pas la médiane de votre rue"
    texte="L'étage, l'ascenseur, la vue et l'état du bien valent plusieurs milliers d'euros au mètre carré. Nous venons voir, et nous écrivons le chiffre."
  />
</Layout>
