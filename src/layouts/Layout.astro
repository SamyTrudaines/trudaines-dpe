---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Entete from '../components/Entete.astro';
import PiedDePage from '../components/PiedDePage.astro';
import BarreMobile from '../components/BarreMobile.astro';
import BandeauCookies from '../components/BandeauCookies.astro';
import Analytics from '../components/Analytics.astro';
import FilAriane from '../components/FilAriane.astro';
import BlocCta from '../components/BlocCta.astro';
import { site } from '../data/site';
import { agrégatAvis } from '../lib/avis';

interface Props {
  /** Ancre du formulaire local : la barre mobile y mène au lieu de /estimation. */
  ancreEstimation?: string;
  titre: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  filAriane?: { nom: string; href?: string }[];
  donnees?: Record<string, unknown>[];
  cta?: boolean;
  /** Réglages du bloc d'appel à l'action de fin de page, quand `cta` est vrai. */
  ctaProps?: Record<string, string | undefined>;
  /** Nom d'événement du bouton « Estimer » de la barre mobile (data-evt). */
  evtEstimation?: string;
  /** La page s'ouvre sur une photographie pleine largeur, sous une barre transparente. */
  enteteSurPhoto?: boolean;
}

const { titre, description, image, type = 'website', noindex = false, filAriane = [], donnees = [], cta = true, ctaProps = {}, ancreEstimation, evtEstimation, enteteSurPhoto = false } = Astro.props;

/*
 * Note et volume repris des avis publiés sur /avis, et de rien d'autre :
 * le visiteur comme le moteur peuvent les recompter sur la page.
 */
const avis = await agrégatAvis();

/*
 * Version construite, posée par Cloudflare Pages au moment du build (branche et
 * commit). L'audit de mise en ligne la lit sur l'adresse de production : c'est
 * ainsi qu'on sait si la production sert bien la dernière fusion.
 */
const version = process.env.CF_PAGES_COMMIT_SHA
  ? `${process.env.CF_PAGES_BRANCH ?? '?'}@${process.env.CF_PAGES_COMMIT_SHA.slice(0, 7)}`
  : 'local';

const agence = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  '@id': `${site.url}/#cabinet`,
  name: site.nomLong,
  legalName: `${site.raisonSociale} ${site.formeJuridique}`,
  url: site.url,
  logo: `${site.url}/images/logo.svg`,
  image: `${site.url}/images/logo.svg`,
  description: site.description,
  email: site.email,
  telephone: site.telephoneLien,
  priceRange: '€€€',
  currenciesAccepted: 'EUR',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.adresse.rue,
    postalCode: site.adresse.codePostal,
    addressLocality: site.adresse.ville,
    addressCountry: site.adresse.pays,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.adresse.latitude,
    longitude: site.adresse.longitude,
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Paris 9e arrondissement' },
    { '@type': 'AdministrativeArea', name: 'Paris 18e arrondissement' },
    { '@type': 'AdministrativeArea', name: 'Paris 10e arrondissement' },
  ],
  openingHoursSpecification: site.horaires.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.jours,
    opens: h.ouverture,
    closes: h.fermeture,
  })),
  founder: { '@type': 'Person', name: 'Samy Santamarina', url: `${site.url}/samy-santamarina` },
  /* La fiche Google relie le site à l'établissement que Google et les assistants connaissent déjà. */
  hasMap: site.reseaux.google,
  sameAs: [site.reseaux.linkedin, site.reseaux.instagram, site.reseaux.google],
  ...(avis.notés > 0
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: avis.note,
          bestRating: 5,
          worstRating: 1,
          ratingCount: avis.notés,
          reviewCount: avis.total,
        },
      }
    : {}),
};
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="trudaines-version" content={version} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/cormorant-garamond-latin-600-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-garamond-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-garamond-latin-500-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#ffffff" />
    <Seo titre={titre} description={description} image={image} type={type} noindex={noindex} />
    <script type="application/ld+json" set:html={JSON.stringify(agence)} is:inline />
    {donnees.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} is:inline />)}
    <Analytics />
  </head>
  <body>
    <Entete surPhoto={enteteSurPhoto} />
    {filAriane.length > 0 && <FilAriane etapes={filAriane} />}
    <main id="contenu">
      <slot />
      {cta && <BlocCta {...ctaProps} />}
    </main>
    <PiedDePage colleAuBloc={cta} />
    <BarreMobile ancreEstimation={ancreEstimation} evtEstimation={evtEstimation} />
    <BandeauCookies />
    <script src="/js/formulaires.js" defer is:inline></script>
    <script>
      /*
       * Un clic sur un élément portant data-evt envoie l'événement du même nom.
       * Un formulaire peut porter data-evt lui aussi : l'événement part alors
       * à l'envoi réussi (public/js/formulaires.js), pas à chaque clic dans un
       * champ, d'où l'exclusion des formulaires ici.
       */
      document.addEventListener('click', (evt) => {
        const cible = evt.target instanceof Element ? evt.target.closest('[data-evt]:not(form)') : null;
        const nom = cible?.getAttribute('data-evt');
        if (nom) window.trudainesEvent?.(nom);
      });
    </script>
    <script>
      /*
       * Apparition des sections au défilement. L'attribut est posé ici, jamais
       * dans le HTML : un navigateur sans JavaScript, un moteur de recherche
       * ou un lecteur d'écran voient la page entière d'emblée. Seules les
       * sections encore sous le pli sont marquées, pour ne rien faire
       * clignoter au chargement, et l'écouteur se coupe une fois passé.
       */
      if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window) {
        const sections = document.querySelectorAll('main .section, main .conteneur > .vitrine');
        const seuil = window.innerHeight * 0.92;
        const guetteur = new IntersectionObserver(
          (entrees) => {
            for (const entree of entrees) {
              if (entree.isIntersecting) {
                entree.target.classList.add('est-visible');
                guetteur.unobserve(entree.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' }
        );
        for (const section of sections) {
          if (section.getBoundingClientRect().top > seuil) {
            section.setAttribute('data-apparait', '');
            guetteur.observe(section);
          }
        }
      }
    </script>
  </body>
</html>
