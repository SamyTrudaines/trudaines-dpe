---
/**
 * Champ « Trouvez votre rue ». Masqué dans le HTML et révélé par
 * public/js/filtre-rues.js : sans JavaScript, il ne ferait rien, et la liste
 * qu'il devait filtrer reste entière.
 */
interface Props {
  identifiant: string;
  /** Identifiant de la liste que le champ filtre. */
  liste: string;
  /** Événement envoyé à la première saisie (data-evt-saisie). */
  evtSaisie?: string;
  libelle?: string;
  exemple?: string;
}
const { identifiant, liste, evtSaisie, libelle = 'Trouvez votre rue', exemple = 'Rue des Martyrs' } = Astro.props;
---
<div data-recherche-rues hidden class="max-w-xl">
  <label class="mb-1 block text-base font-semibold text-[color:var(--color-encre)]" for={identifiant}>{libelle}</label>
  <input
    id={identifiant}
    class="champ min-h-[3.5rem] text-lg"
    type="search"
    inputmode="search"
    autocomplete="off"
    autocapitalize="none"
    spellcheck="false"
    enterkeyhint="search"
    placeholder={`Par exemple : ${exemple}`}
    aria-controls={liste}
    data-filtre-rues
    data-evt-saisie={evtSaisie}
  />
</div>
