---
/**
 * La moulure de l'accueil en fond, un panneau blanc posé dessus : l'habillage
 * des pages où l'on demande quelque chose au visiteur (estimation). L'image ne
 * sert que de matière ; le contenu reste sur blanc, contraste intact.
 */
interface Props {
  /** Vrai en haut de page : l'image se charge sans attendre le défilement. */
  enTete?: boolean;
  class?: string;
}
const { enTete = false, class: classe = '' } = Astro.props;
---
<section class={`relative isolate overflow-hidden ${classe}`}>
  <picture>
    <source type="image/avif" srcset="/images/marque/moulure-1200.avif 1200w, /images/marque/moulure-2000.avif 2000w" sizes="100vw" />
    <source type="image/webp" srcset="/images/marque/moulure-1200.webp 1200w, /images/marque/moulure-2000.webp 2000w" sizes="100vw" />
    <img
      src="/images/marque/moulure-2000.webp"
      alt=""
      aria-hidden="true"
      width="2000"
      height="1125"
      loading={enTete ? 'eager' : 'lazy'}
      decoding="async"
      class="absolute inset-0 -z-10 h-full w-full object-cover object-center"
    />
  </picture>
  <div class="conteneur py-6 md:py-10 lg:py-12">
    <div class="mx-auto max-w-6xl bg-white px-5 py-8 sm:px-10 md:px-14 md:py-12">
      <slot />
    </div>
  </div>
</section>
