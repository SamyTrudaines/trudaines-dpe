---
/**
 * Ouverture de l'accueil : le square d'Anvers et, au loin, le Sacré-Cœur,
 * pleine largeur. Photographie du cabinet.
 *
 * Le fichier reçu mesure 1500 px sur 840. Il a été agrandi deux fois par
 * super-résolution (modèle EDSR), plus net qu'un simple agrandissement :
 * la version la plus large fait 3000 px, de quoi servir un écran Retina de
 * 1440 px. À remplacer par l'original, environ 6000 px, dès qu'il est déposé
 * dans le dépôt.
 *
 * Deux cadrages : l'image entière sur ordinateur, une coupe verticale centrée
 * sur le dôme sur téléphone. Les noms de fichiers changent avec la photographie,
 * les images étant gardées trente jours en cache.
 */
const alt = "Le square d'Anvers et, au loin, la basilique du Sacré-Cœur";
const large = [1200, 1600, 2000, 2400, 3000]
  .map((l) => `/images/marque/square-anvers-large-${l}.webp ${l}w`)
  .join(', ');
const haut = [640, 900, 1200, 1462]
  .map((l) => `/images/marque/square-anvers-haut-${l}.webp ${l}w`)
  .join(', ');
---
<div class="relative w-full overflow-hidden bg-[color:var(--color-papier)]">
  <picture>
    <source media="(min-width: 768px)" srcset={large} sizes="100vw" />
    <source srcset={haut} sizes="100vw" />
    <img
      src="/images/marque/square-anvers-large-2400.webp"
      alt={alt}
      width="3000"
      height="1680"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      class="ouverture-photo h-[56svh] w-full object-cover object-center md:h-[64svh] lg:h-[74svh]"
    />
  </picture>
  <div class="ouverture-voile" aria-hidden="true"></div>
</div>
