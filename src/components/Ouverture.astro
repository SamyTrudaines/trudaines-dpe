---
/**
 * Ouverture de l'accueil : la photographie du square d'Anvers, seule, pleine
 * largeur.
 *
 * Pas de texte posé dessus. L'image parle, le titre vient juste en dessous sur
 * blanc, où il se lit sans qu'il faille assombrir un ciel bleu pour y arriver.
 *
 * L'original mesure 1500 pixels de large. C'est la limite dure : aucun
 * agrandissement n'ajoute de détail, il ne fait qu'adoucir. Le fichier est donc
 * servi à sa taille native, encodé haut, en AVIF d'abord et en WebP ensuite.
 * À qualité perçue égale l'AVIF pèse ici 46 % de moins que le WebP, ce qui
 * permet de monter la qualité sans allonger l'affichage.
 */
const largeurs = [640, 960, 1200, 1500];
const jeu = (ext: string) => largeurs.map((l) => `/images/marque/anvers-${l}.${ext} ${l}w`).join(', ');
const alt = "Le square d'Anvers et le Sacré-Cœur vus du boulevard de Rochechouart, Paris 9e";
---
<div class="w-full overflow-hidden bg-[color:var(--color-papier)]">
  <picture>
    <source type="image/avif" srcset={jeu('avif')} sizes="100vw" />
    <source type="image/webp" srcset={jeu('webp')} sizes="100vw" />
    <img
      src="/images/marque/anvers-1500.webp"
      alt={alt}
      width="1500"
      height="1001"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      class="h-[56svh] w-full object-cover object-center md:h-[64svh] lg:h-[72svh]"
    />
  </picture>
</div>
