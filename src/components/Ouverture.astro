---
import { OUVERTURE } from '../lib/images';

/**
 * Ouverture de l'accueil : le square d'Anvers et, au loin, le Sacré-Cœur, vus
 * de l'avenue Trudaine. Photographie du cabinet, déclinée par
 * scripts/photo-ouverture.mjs sans jamais dépasser la définition de l'original.
 *
 * Sur téléphone, la photographie est montrée entière, à son format : la
 * recadrer en hauteur obligerait à l'agrandir au-delà de sa définition, et
 * c'est ce qui la rendait granuleuse. Sur ordinateur, elle couvre la largeur
 * et sa hauteur suit l'écran : la coupe ne retire que du ciel et de la
 * chaussée, la largeur fixant l'échelle, donc jamais de définition. Aucun
 * mouvement : une image immobile se restitue au mieux. Le titre de la page se
 * lit dès l'arrivée, sous la photographie.
 */
const alt = "Le square d'Anvers et, au loin, la basilique du Sacré-Cœur, vus de l'avenue Trudaine";
---
<div class="ouverture">
  <picture>
    <source type="image/avif" srcset={OUVERTURE.avif} sizes={OUVERTURE.tailles} />
    <img
      src={OUVERTURE.src}
      srcset={OUVERTURE.webp}
      sizes={OUVERTURE.tailles}
      alt={alt}
      width={OUVERTURE.largeur}
      height={OUVERTURE.hauteur}
      fetchpriority="high"
      loading="eager"
      decoding="async"
      class="ouverture-photo"
    />
  </picture>
  <div class="ouverture-voile" aria-hidden="true"></div>
</div>
