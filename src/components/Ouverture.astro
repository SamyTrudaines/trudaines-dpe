---
/**
 * Ouverture de l'accueil : la photographie du square d'Anvers, pleine largeur.
 *
 * L'original mesure 1500 px. Il est agrandi ici, au Lanczos, avec une
 * accentuation légère, plutôt que laissé au filtre bilinéaire du navigateur :
 * à l'examen à l'échelle 1 sur un écran de 1920, c'est la seule méthode
 * testée qui garde le détail du feuillage et l'arête des coupoles. La
 * variante de 2000 px couvre exactement un écran de 1920, qui reçoit donc
 * l'image sans le moindre étirement.
 *
 * Encodage haut, AVIF d'abord : à ce niveau de qualité il pèse un tiers de
 * moins que le WebP, ce qui paie l'agrandissement.
 */
const largeurs = [768, 1200, 1600, 2000, 2560];
const jeu = (ext: string) => largeurs.map((l) => `/images/marque/anvers-${l}.${ext} ${l}w`).join(', ');
const alt = "Le square d'Anvers et le Sacré-Cœur vus du boulevard de Rochechouart, Paris 9e";
---
<div class="w-full overflow-hidden bg-[color:var(--color-papier)]">
  <picture>
    <source type="image/avif" srcset={jeu('avif')} sizes="100vw" />
    <source type="image/webp" srcset={jeu('webp')} sizes="100vw" />
    <img
      src="/images/marque/anvers-2000.webp"
      alt={alt}
      width="2560"
      height="1708"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      class="h-[56svh] w-full object-cover object-center md:h-[64svh] lg:h-[72svh]"
    />
  </picture>
</div>
