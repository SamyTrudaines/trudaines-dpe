---
/**
 * Ouverture de l'accueil : immeubles parisiens et, au loin, le Sacré-Cœur,
 * pleine largeur.
 *
 * Photographie de Francisco Mamani, collection « Site WEB » du cabinet sur
 * Unsplash (licence Unsplash : usage commercial libre, sans attribution
 * obligatoire), https://unsplash.com/photos/gray-and-beige-buildings-YGH2qAQIbCc.
 * L'original mesure 6000 px sur 4000 : chaque fichier servi est une réduction,
 * jamais un agrandissement. L'ancienne photographie ne faisait que 1500 px de
 * large, d'où le flou sur les écrans haute densité, où une page de 1440 px en
 * demande 2880.
 *
 * Deux cadrages, un par forme d'écran, recadrés à la production : une bande
 * large (rapport 2,2) sur ordinateur, une coupe verticale (0,87) centrée sur la
 * basilique sur téléphone. Jusqu'à 3840 px de large, pour les écrans Retina et
 * 4K. WebP à qualité élevée : c'est la page qui vend.
 */
const alt = 'Immeubles parisiens et, au loin, la basilique du Sacré-Cœur';
const large = [1200, 1600, 2000, 2400, 3200, 3840]
  .map((l) => `/images/marque/ouverture-large-${l}.webp ${l}w`)
  .join(', ');
const haut = [640, 900, 1200, 1600]
  .map((l) => `/images/marque/ouverture-haut-${l}.webp ${l}w`)
  .join(', ');
---
<div class="relative w-full overflow-hidden bg-[color:var(--color-papier)]">
  <picture>
    <source media="(min-width: 768px)" srcset={large} sizes="100vw" />
    <source srcset={haut} sizes="100vw" />
    <img
      src="/images/marque/ouverture-large-2400.webp"
      alt={alt}
      width="2400"
      height="1091"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      class="ouverture-photo h-[56svh] w-full object-cover object-center md:h-[64svh] lg:h-[74svh]"
    />
  </picture>
  <div class="ouverture-voile" aria-hidden="true"></div>
</div>
