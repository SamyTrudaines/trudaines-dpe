---
import { site } from '../data/site';
/**
 * `large` : aligné sur le conteneur large de la fiche d'un bien. La page
 * courante n'y est pas répétée sur téléphone : son titre suit immédiatement.
 */
interface Props { etapes: { nom: string; href?: string }[]; large?: boolean }
const { etapes, large = false } = Astro.props;
const complet = [{ nom: 'Accueil', href: '/' }, ...etapes];
const donnees = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: complet.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: e.nom,
    ...(e.href ? { item: new URL(e.href, site.url).href } : {}),
  })),
};
---
<nav aria-label="Fil d'Ariane" class={`${large ? 'conteneur-large' : 'conteneur'} pt-6`}>
  <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--color-ardoise)]">
    {complet.map((e, i) => (
      <li class={large && i === complet.length - 1 ? 'hidden items-center gap-2 sm:flex' : 'flex items-center gap-2'}>
        {i > 0 && <span aria-hidden="true">/</span>}
        {e.href && i < complet.length - 1 ? (
          <a href={e.href} class="no-underline hover:underline">{e.nom}</a>
        ) : (
          <span aria-current="page">{e.nom}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(donnees)} is:inline />
