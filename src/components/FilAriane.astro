---
import { site } from '../data/site';
interface Props { etapes: { nom: string; href?: string }[]; }
const { etapes } = Astro.props;
const complet = [{ nom: 'Accueil', href: '/' }, ...etapes];
const donnees = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: complet.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: e.nom,
    ...(e.href ? { item: new URL(e.href, site.url).href } : {}),
  })),
};
---
<nav aria-label="Fil d'Ariane" class="conteneur pt-6">
  <ol class="flex flex-wrap items-center gap-2 text-xs text-[color:var(--color-ardoise)]">
    {complet.map((e, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true">/</span>}
        {e.href && i < complet.length - 1 ? (
          <a href={e.href} class="no-underline hover:underline">{e.nom}</a>
        ) : (
          <span aria-current="page">{e.nom}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(donnees)} is:inline />
