    <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a href="/estimation" class="bouton w-full sm:w-auto">Estimer mon bien</a>
      <a href="/guides" class="bouton bouton-secondaire w-full sm:w-auto">Recevoir le guide des prix</a>
