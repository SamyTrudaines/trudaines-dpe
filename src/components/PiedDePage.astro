---
interface Props {
  /*
   * Vrai quand la page se termine par le bloc d'appel à l'action, dont le fond
   * ivoire touche alors directement le pied de page. Sans lui, un filet fin et
   * une marge détachent le pied du dernier paragraphe.
   */
  colleAuBloc?: boolean;
}
const { colleAuBloc = false } = Astro.props;
import Logo from './Logo.astro';
import { site } from '../data/site';
import { secteurs } from '../data/secteurs';

/*
 * La marque et ses coordonnées, puis quatre colonnes dans l'ordre de la barre
 * de navigation. Huit liens au plus par colonne : les pages plus fines
 * (estimation par arrondissement, quartier par quartier) restent à un clic
 * depuis leur page mère, /estimation et /quartiers.
 */
const numero = (slug: string) => Number(slug.replace(/\D/g, ''));
const arrondissements = [...secteurs]
  .sort((a, b) => numero(a.slug) - numero(b.slug))
  .map((s) => ({ libelle: s.nom, href: s.hrefAgence }));

const colonnes = [
  {
    titre: 'Vendre',
    liens: [
      { libelle: 'Estimer mon bien', href: '/estimation' },
      { libelle: 'La méthode de vente', href: '/vendre' },
      { libelle: 'Le mandat exclusif', href: '/mandat-exclusif' },
      { libelle: 'Choisir son agence', href: '/choisir-son-agence-immobiliere-paris' },
      { libelle: 'Prix au m² rue par rue', href: '/prix-immobilier' },
      { libelle: 'Honoraires', href: '/honoraires' },
      { libelle: 'Guides', href: '/guides' },
    ],
  },
  {
    titre: 'Acheter et louer',
    liens: [
      { libelle: 'Biens à vendre', href: '/acheter' },
      { libelle: 'Nos références', href: '/references' },
      { libelle: 'Chasse immobilière', href: '/chasse' },
      { libelle: 'Gestion locative', href: '/gestion-locative' },
    ],
  },
  {
    titre: 'Quartiers',
    liens: [
      ...arrondissements,
      { libelle: 'Montmartre', href: '/agence-immobiliere-montmartre' },
      { libelle: 'Saint-Georges', href: '/agence-immobiliere-saint-georges' },
      { libelle: 'Trudaine', href: '/agence-immobiliere-trudaine' },
      { libelle: 'Tous les quartiers', href: '/quartiers' },
    ],
  },
  {
    titre: "L'agence",
    liens: [
      { libelle: 'Qui sommes-nous', href: '/trudaines' },
      { libelle: 'Samy Santamarina', href: '/samy-santamarina' },
      { libelle: 'Avis clients', href: '/avis' },
      { libelle: 'Presse', href: '/presse' },
      { libelle: 'Actu', href: '/panorama' },
      { libelle: 'Recommander un proche', href: '/recommander' },
      { libelle: 'Nous rejoindre', href: '/nous-rejoindre' },
      { libelle: 'Contact', href: '/contact' },
    ],
  },
];
const annee = new Date().getFullYear();
---
<footer class={`pied bg-white ${colleAuBloc ? '' : 'pied-detache'}`}>
  <div class="conteneur pied-grille">
    <div class="pied-marque">
      <a href="/" class="pied-logo"><Logo /></a>
      <address class="pied-coordonnees">
        <p>{site.adresse.rue}<br />{site.adresse.codePostal} {site.adresse.ville}</p>
        <p>
          <a href={`tel:${site.telephoneLien}`} data-evt="clic_telephone">{site.telephone}</a><br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p class="pied-horaires">{site.horairesTexte}</p>
      </address>
    </div>

    {colonnes.map((c) => (
      <div>
        <h2 class="pied-titre">{c.titre}</h2>
        <ul class="pied-liens">
          {c.liens.map((l) => <li><a href={l.href}>{l.libelle}</a></li>)}
        </ul>
      </div>
    ))}
  </div>

  <div class="pied-trait">
    <div class="conteneur pied-legal">
      <p>
        {site.nomLong}, {site.raisonSociale} {site.formeJuridique}, {site.legal.rcs}. Carte professionnelle {site.legal.carteT},
        CCI Paris Île-de-France. Garantie financière {site.legal.garantie}, {site.legal.garantieMontant}. {site.legal.detentionFonds}
        Médiateur de la consommation : <a href="/mentions-legales#médiation-de-la-consommation" class="lien-souligne">{site.legal.mediateur.nom}</a>.
      </p>
      <p class="pied-legal-liens">
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/politique-de-confidentialite">Confidentialité</a>
        {site.ga4 && <button type="button" data-cookies-ouvrir>Gérer les cookies</button>}
        <span>© {annee}</span>
      </p>
    </div>
  </div>
</footer>
