---
interface Props { reference: string; titreBien: string; }
const { reference, titreBien } = Astro.props;
---
<form
  class="border border-[color:var(--color-trait)] bg-[color:var(--color-papier)] p-6"
  method="POST"
  action="/api/fiche-bien"
  data-trudaines
  data-evenement="fiche_telechargee"
>
  <input type="hidden" name="reference" value={reference} />
  <input type="hidden" name="bien" value={titreBien} />
  <input type="hidden" name="horodatage" value="" />
  <div class="absolute h-0 w-0 overflow-hidden" aria-hidden="true">
    <label for="societe-fiche">Ne pas remplir</label>
    <input type="text" id="societe-fiche" name="societe" tabindex="-1" autocomplete="off" />
  </div>

  <div data-corps>
    <h2 class="titre-3">Recevoir le dossier complet du bien</h2>
    <p class="mt-3 text-sm text-[color:var(--color-ardoise)]">
      Photos, plan des surfaces, diagnostic, charges et honoraires, en un document PDF envoyé par email.
    </p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <div>
        <label class="etiquette" for="fiche-email">Email</label>
        <input class="champ" id="fiche-email" name="email" type="email" autocomplete="email" required />
      </div>
      <div>
        <label class="etiquette" for="fiche-telephone">Téléphone</label>
        <input class="champ" id="fiche-telephone" name="telephone" type="tel" autocomplete="tel" required />
      </div>
    </div>
    <div class="mt-4 flex items-start gap-3">
      <input class="mt-1 h-5 w-5 shrink-0 accent-[color:var(--color-nuit)]" id="fiche-consentement" name="consentement" type="checkbox" required value="oui" />
      <label class="text-sm text-[color:var(--color-ardoise)]" for="fiche-consentement">
        J'accepte de recevoir le dossier et les biens similaires mis en vente par Trudaines.
      </label>
    </div>
    <button type="submit" class="bouton mt-6 w-full">Recevoir le dossier</button>
    <p class="mt-4 text-sm text-[#a4262c]" data-erreur hidden></p>
  </div>

  <div data-confirmation hidden class="py-2">
    <h2 class="titre-3">Dossier envoyé</h2>
    <p class="mt-4 text-[color:var(--color-ardoise)]">
      Le dossier du bien {reference} part à l'instant vers votre boîte email. Pensez à vérifier les indésirables.
    </p>
  </div>
</form>
