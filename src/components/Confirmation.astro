---
interface Props { titre: string; texte: string }
const { titre, texte } = Astro.props;
---
<div data-confirmation hidden class="border border-encre bg-creme p-8">
  <p class="surtitre">Demande enregistrée</p>
  <h3 class="mt-3 text-xl">{titre}</h3>
  <p class="mt-3 text-gris">{texte}</p>
</div>
<p data-erreur hidden role="alert" class="mt-4 border-l-2 border-encre bg-creme p-4 text-sm"></p>
