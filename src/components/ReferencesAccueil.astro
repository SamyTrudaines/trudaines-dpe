---
import type { CollectionEntry } from 'astro:content';
import CarteBien from './CarteBien.astro';

/**
 * Les mandats passés, sur l'accueil. Une seule section, placée selon qu'il y
 * a ou non des biens en vente : juste après l'ouverture quand la vitrine est
 * vide, plus bas sinon. Jamais deux fois sur la même page.
 */
interface Props {
  references: CollectionEntry<'biens'>[];
  total: number;
}
const { references, total } = Astro.props;
---
<section class="section filet" aria-labelledby="references-accueil">
  <div class="conteneur">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="surtitre marque-filet">Références</p>
        <h2 id="references-accueil" class="titre-2 mt-6">Ce qui nous a été confié</h2>
        <p class="mt-6 text-[color:var(--color-ardoise)]">
          {total} mandats depuis septembre 2024, du deux pièces de la Butte à la demeure avec jardin. Une
          partie de nos ventes se conclut avant d'être publiée ; les photographies sont celles des dossiers
          du cabinet.
        </p>
      </div>
      <a href="/references" class="lien-souligne text-sm">Voir toutes nos références</a>
    </div>
    <div class="mt-12 grid gap-12 md:grid-cols-3">
      {references.map((b) => (
        <CarteBien
          id={b.id}
          titre={b.data.titre}
          quartier={b.data.quartier}
          arrondissement={b.data.arrondissement}
          ville={b.data.ville}
          chambres={b.data.chambres}
          accroche={b.data.accroche}
          prixBien={b.data.prix}
          surface={b.data.surface}
          pieces={b.data.pieces}
          statut={b.data.statut}
          photo={b.data.photos[0]}
          sansPrix
        />
      ))}
    </div>
  </div>
</section>
