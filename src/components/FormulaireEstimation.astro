---
import { preuveAvis } from '../lib/avis';
import { lienWhatsapp } from '../lib/whatsapp';
import { photoEstimation } from '../data/ambiance';

interface Props {
  secteur?: string;
  quartier?: string;
  identifiant?: string;
  /** Nom d'événement (data-evt), envoyé quand la demande aboutit. */
  evt?: string;
  /** Page d'où part la demande, transmise à l'agence : « Rue des Dames, Paris 17e ». */
  origine?: string;
}
const { secteur = '', quartier = '', identifiant = 'estimation', evt, origine = '' } = Astro.props;
const listeId = `adresses-${identifiant}`;
/* Le quartier en image, en tête du formulaire : le visiteur voit où l'estimation se situe. */
const photo = photoEstimation(secteur, quartier);
/* La preuve sociale sous la barre d'étapes : le chiffre vient des avis publiés, jamais écrit à la main. */
const preuve = await preuveAvis();
/* Après l'envoi : des photos par WhatsApp, pour que le premier appel parte du bien réel. */
const lienPhotos = lienWhatsapp('', "Bonjour Samy, je viens de demander une estimation sur votre site. Voici quelques photos de mon appartement.");
---
<div class="border border-[color:var(--color-trait)] bg-white p-3 sm:p-4 xl:p-5" data-choix-estimation>
<figure class="-mx-3 -mt-3 mb-6 sm:-mx-4 sm:-mt-4 xl:-mx-5 xl:-mt-5">
  <img
    src={`${photo.fichier}-1200.webp`}
    srcset={`${photo.fichier}-1200.webp 1200w, ${photo.fichier}.webp 2000w`}
    sizes="(min-width: 1024px) 34rem, 100vw"
    alt={photo.alt}
    width="1200"
    height="525"
    loading="lazy"
    decoding="async"
    class="aspect-[16/7] w-full object-cover"
  />
</figure>
{/*
  Deux voies, comme sur l'ancien site : estimer en ligne, ou être rappelé. Dans les deux cas Samy reçoit
  un email et un SMS et rappelle ; seule la seconde le promet au visiteur.
*/}
<div class="mb-8 grid grid-cols-2 border border-[color:var(--color-encre)]" role="group" aria-label="Comment souhaitez-vous procéder ?">
  <button type="button" class="choix-voie" aria-pressed="true" data-voie="en-ligne">Estimer en ligne</button>
  <button type="button" class="choix-voie" aria-pressed="false" data-voie="rappel">Être rappelé</button>
</div>
<form
  id={identifiant}
  method="POST"
  action="/api/estimation"
  data-trudaines
  data-evenement="estimation_envoyee"
  data-evt={evt}
  data-evenement-etape="estimation_etape1"
  data-formulaire-avis
  data-fourchette
  data-voie-formulaire="en-ligne"
  novalidate={false}
>
  <input type="hidden" name="secteur" value={secteur} />
  <input type="hidden" name="quartier" value={quartier} />
  <input type="hidden" name="origine" value={origine} />
  <input type="hidden" name="horodatage" value="" />
  {/* Rempli pendant les étapes : l'agence voit la fourchette que le visiteur a eue sous les yeux. */}
  <input type="hidden" name="fourchette" value="" />
  <div class="absolute h-0 w-0 overflow-hidden" aria-hidden="true">
    <label for={`controle-${identifiant}`}>Ne pas remplir</label>
    <input type="text" id={`controle-${identifiant}`} name="controle" tabindex="-1" autocomplete="off" />
  </div>

  <div data-corps>
    <div class="mb-8">
      <p class="surtitre" data-compteur>Étape 1 sur 5 · Adresse</p>
      <div class="mt-3 h-[2px] w-full bg-[color:var(--color-trait)]" role="presentation">
        <div class="h-[2px] bg-[color:var(--color-nuit)] transition-[width] duration-200" style="width:25%" data-barre></div>
      </div>
      <p class="mt-3 text-xs text-[color:var(--color-ardoise)]">Gratuit, moins d'une minute.{preuve && ` ${preuve}`}</p>
    </div>

    {/*
      Une question par écran, la plus simple d'abord : l'adresse. Le visiteur voit ensuite combien
      de ventes signées fondent son estimation, puis donne son contact pour la recevoir.
    */}
    <fieldset data-etape data-nom-etape="Adresse" class="border-0 p-0">
      <legend class="titre-3 mb-6">Où se trouve votre bien ?</legend>
      <div class="grid gap-6">
        <div>
          <label class="etiquette" for={`adresse-${identifiant}`}>Adresse du bien</label>
          <input
            class="champ"
            id={`adresse-${identifiant}`}
            name="adresse"
            type="text"
            required
            autocomplete="street-address"
            placeholder="12 avenue Trudaine, 75009 Paris"
            list={listeId}
            data-autocomplete-adresse
          />
          <datalist id={listeId}></datalist>
          <p class="mt-2 text-xs text-[color:var(--color-ardoise)]">
            Utilisée uniquement pour retrouver les ventes signées de votre rue. Jamais publiée.
          </p>
        </div>
        <fieldset class="border-0 p-0">
          <legend class="etiquette">Type de bien</legend>
          <div class="choix-groupe choix-groupe-large">
            <label class="choix"><input type="radio" name="type" value="Appartement" checked required data-type-libelle="Votre appartement" /><span>Appartement</span></label>
            <label class="choix"><input type="radio" name="type" value="Maison" data-type-libelle="Votre maison" /><span>Maison</span></label>
            <label class="choix"><input type="radio" name="type" value="Immeuble ou local" data-type-libelle="Votre bien" /><span>Immeuble ou local</span></label>
          </div>
        </fieldset>
      </div>
      <button type="button" class="bouton mt-8 w-full sm:w-auto" data-suivant>Commencer l'estimation</button>
    </fieldset>

    <fieldset data-etape data-nom-etape="Le bien" class="border-0 p-0">
      <legend class="titre-3 mb-6"><span data-type-titre>Votre appartement</span>, sa surface et ses pièces</legend>
      {/* Rempli après l'adresse : le nombre de ventes signées sur lesquelles l'estimation s'appuie. */}
      <p class="mb-6 border-l-2 border-[color:var(--color-or)] pl-4 text-sm" data-apercu-ventes hidden></p>
      <div class="grid gap-5">
        <div>
          <label class="etiquette" for={`surface-${identifiant}`}>Surface habitable</label>
          <div class="champ-unite">
            <input class="champ" id={`surface-${identifiant}`} name="surface" type="number" min="5" max="1000" required inputmode="numeric" placeholder="45" />
            <span aria-hidden="true">m²</span>
          </div>
        </div>
        <div data-si-maison hidden>
          <label class="etiquette" for={`terrain-${identifiant}`}>Surface du terrain</label>
          <div class="champ-unite">
            <input class="champ" id={`terrain-${identifiant}`} name="terrain" type="number" min="0" max="100000" required disabled inputmode="numeric" placeholder="300" />
            <span aria-hidden="true">m²</span>
          </div>
        </div>
        <fieldset class="border-0 p-0">
          <legend class="etiquette">Nombre de pièces</legend>
          <div class="choix-groupe">
          <label class="choix"><input type="radio" name="pieces" value="1" required /><span>1</span></label>
          <label class="choix"><input type="radio" name="pieces" value="2" /><span>2</span></label>
          <label class="choix"><input type="radio" name="pieces" value="3" /><span>3</span></label>
          <label class="choix"><input type="radio" name="pieces" value="4" /><span>4</span></label>
          <label class="choix"><input type="radio" name="pieces" value="5" /><span>5</span></label>
          <label class="choix"><input type="radio" name="pieces" value="6 et plus" /><span>6 et +</span></label>
          </div>
        </fieldset>
        <fieldset class="border-0 p-0">
          <legend class="etiquette">Nombre de chambres</legend>
          <div class="choix-groupe">
          <label class="choix"><input type="radio" name="chambres" value="0" required /><span>Aucune</span></label>
          <label class="choix"><input type="radio" name="chambres" value="1" /><span>1</span></label>
          <label class="choix"><input type="radio" name="chambres" value="2" /><span>2</span></label>
          <label class="choix"><input type="radio" name="chambres" value="3" /><span>3</span></label>
          <label class="choix"><input type="radio" name="chambres" value="4" /><span>4</span></label>
          <label class="choix"><input type="radio" name="chambres" value="5 et plus" /><span>5 et +</span></label>
          </div>
        </fieldset>
        <fieldset class="border-0 p-0">
          <legend class="etiquette">Salles de bain ou salles d'eau</legend>
          <div class="choix-groupe">
          <label class="choix"><input type="radio" name="sallesDeBain" value="1" required /><span>1</span></label>
          <label class="choix"><input type="radio" name="sallesDeBain" value="2" /><span>2</span></label>
          <label class="choix"><input type="radio" name="sallesDeBain" value="3 et plus" /><span>3 et +</span></label>
          </div>
        </fieldset>
      </div>
      <div class="mt-8 flex flex-wrap gap-4">
        <button type="button" class="bouton bouton-secondaire" data-precedent>Revenir</button>
        <button type="button" class="bouton" data-suivant>Continuer</button>
      </div>
    </fieldset>

    <fieldset data-etape data-nom-etape="État et atouts" class="border-0 p-0">
      <legend class="titre-3 mb-6">Son état et ses atouts</legend>
      <p class="mb-6 text-sm text-[color:var(--color-ardoise)]">Deux biens de la même rue s'écartent souvent de 20 % selon leur état et leurs atouts.</p>
      <div class="grid gap-5">
        <fieldset class="border-0 p-0">
          <legend class="etiquette">État du bien</legend>
          <div class="choix-groupe choix-groupe-liste">
          <label class="choix"><input type="radio" name="etat" value="Neuf ou récent" required /><span>Neuf ou récent</span></label>
          <label class="choix"><input type="radio" name="etat" value="Rénové" /><span>Rénové récemment</span></label>
          <label class="choix"><input type="radio" name="etat" value="Très bon état" /><span>Très bon état</span></label>
          <label class="choix"><input type="radio" name="etat" value="État correct" /><span>État correct</span></label>
          <label class="choix"><input type="radio" name="etat" value="À rénover" /><span>À rénover</span></label>
          </div>
        </fieldset>
        <div class="max-w-xs">
          <label class="etiquette" for={`dpe-${identifiant}`}>DPE, facultatif</label>
          <select class="champ" id={`dpe-${identifiant}`} name="dpe">
            <option value="">Je ne sais pas</option>
            <option value="A">A</option>
            <option value="B">B</option>
            <option value="C">C</option>
            <option value="D">D</option>
            <option value="E">E</option>
            <option value="F">F</option>
            <option value="G">G</option>
          </select>
        </div>
        <fieldset class="border-0 p-0">
          <legend class="etiquette">Atouts, facultatif</legend>
          <div class="choix-groupe">
          <label class="choix"><input type="checkbox" name="atouts" value="Balcon ou terrasse" /><span>Balcon ou terrasse</span></label>
          <label class="choix"><input type="checkbox" name="atouts" value="Vue dégagée" /><span>Vue dégagée</span></label>
          <label class="choix"><input type="checkbox" name="atouts" value="Calme" /><span>Calme</span></label>
          <label class="choix"><input type="checkbox" name="atouts" value="Lumineux" /><span>Très lumineux</span></label>
          <label class="choix"><input type="checkbox" name="atouts" value="Cave" /><span>Cave</span></label>
          <label class="choix"><input type="checkbox" name="atouts" value="Parking" /><span>Parking</span></label>
          </div>
        </fieldset>
      </div>
      <div class="mt-8 flex flex-wrap gap-4">
        <button type="button" class="bouton bouton-secondaire" data-precedent>Revenir</button>
        <button type="button" class="bouton" data-suivant>Continuer</button>
      </div>
    </fieldset>

    <fieldset data-etape data-nom-etape="Étage et projet" class="border-0 p-0">
      <legend class="titre-3 mb-6">Étage et projet</legend>
      <div class="grid gap-5">
        {/* Sans objet pour une maison : les champs sont alors désactivés et ne bloquent pas l'étape. */}
        <div class="grid gap-5" data-si-appartement>
          <p class="text-sm text-[color:var(--color-ardoise)]">L'étage et l'ascenseur placent votre bien en haut ou en bas des prix de la rue.</p>
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label class="etiquette" for={`etage-${identifiant}`}>Étage du bien</label>
              <select class="champ" id={`etage-${identifiant}`} name="etage" required>
                <option value="" disabled selected>Choisir</option>
                <option value="Rez-de-chaussée">Rez-de-chaussée</option>
            <option value="1er">1er étage</option>
            <option value="2e">2e étage</option>
            <option value="3e">3e étage</option>
            <option value="4e">4e étage</option>
            <option value="5e">5e étage</option>
            <option value="6e">6e étage</option>
            <option value="7e">7e étage</option>
            <option value="8e">8e étage</option>
            <option value="9e">9e étage</option>
            <option value="10e et plus">10e étage et plus</option>
              </select>
            </div>
            <div>
              <label class="etiquette" for={`etages-${identifiant}`}>Étages de l'immeuble</label>
              <select class="champ" id={`etages-${identifiant}`} name="etages" required>
                <option value="" disabled selected>Choisir</option>
            <option value="1">1 étage</option>
            <option value="2">2 étages</option>
            <option value="3">3 étages</option>
            <option value="4">4 étages</option>
            <option value="5">5 étages</option>
            <option value="6">6 étages</option>
            <option value="7">7 étages</option>
            <option value="8">8 étages</option>
            <option value="9">9 étages</option>
            <option value="10 et plus">10 étages et plus</option>
              </select>
            </div>
          </div>
          <fieldset class="border-0 p-0">
            <legend class="etiquette">Ascenseur</legend>
            <div class="choix-groupe">
          <label class="choix"><input type="radio" name="ascenseur" value="Oui" required /><span>Oui</span></label>
          <label class="choix"><input type="radio" name="ascenseur" value="Non" /><span>Non</span></label>
            </div>
          </fieldset>
        </div>
        <fieldset class="border-0 p-0">
          <legend class="etiquette">Votre projet</legend>
          <div class="choix-groupe choix-groupe-liste">
          <label class="choix"><input type="radio" name="horizon" value="Moins de 3 mois" required /><span>Vendre dans les 3 mois</span></label>
          <label class="choix"><input type="radio" name="horizon" value="3 à 6 mois" /><span>Vendre dans 3 à 6 mois</span></label>
          <label class="choix"><input type="radio" name="horizon" value="Plus tard" /><span>Connaître la valeur, vendre plus tard</span></label>
          </div>
        </fieldset>
      </div>
      <div class="mt-8 flex flex-wrap gap-4">
        <button type="button" class="bouton bouton-secondaire" data-precedent>Revenir</button>
        <button type="button" class="bouton" data-suivant>Calculer mon estimation</button>
      </div>
    </fieldset>

    <fieldset data-etape data-nom-etape="Vos coordonnées" class="border-0 p-0">
      <legend class="titre-3 mb-2">Où recevoir votre estimation ?</legend>
      <p class="mb-6 text-sm text-[color:var(--color-ardoise)]">
        Dans nos six arrondissements, votre fourchette s'affiche dès l'envoi, calculée sur les ventes signées.
      </p>
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label class="etiquette" for={`prenom-${identifiant}`}>Prénom</label>
          <input class="champ" id={`prenom-${identifiant}`} name="prenom" type="text" autocomplete="given-name" required />
        </div>
        <div>
          <label class="etiquette" for={`nom-${identifiant}`}>Nom</label>
          <input class="champ" id={`nom-${identifiant}`} name="nom" type="text" autocomplete="family-name" required />
        </div>
        <div>
          <label class="etiquette" for={`email-${identifiant}`}>Adresse email</label>
          <input class="champ" id={`email-${identifiant}`} name="email" type="email" autocomplete="email" inputmode="email" required />
        </div>
        <div>
          <label class="etiquette" for={`telephone-${identifiant}`}>Téléphone</label>
          <input class="champ" id={`telephone-${identifiant}`} name="telephone" type="tel" autocomplete="tel" inputmode="tel" required />
        </div>
      </div>
      <details class="mt-6 text-sm">
        <summary class="cursor-pointer text-[color:var(--color-ardoise)]">Ajouter une précision, facultatif</summary>
        <label class="sr-only" for={`message-${identifiant}`}>Précisions utiles</label>
        <textarea class="champ mt-3" id={`message-${identifiant}`} name="message" rows="3" placeholder="Travaux récents, vue, exposition, contexte de la vente"></textarea>
      </details>
      <div class="mt-6 flex items-start gap-3">
        <input class="mt-1 h-5 w-5 shrink-0 accent-[color:var(--color-nuit)]" id={`consentement-${identifiant}`} name="consentement" type="checkbox" value="oui" />
        <label class="text-sm text-[color:var(--color-ardoise)]" for={`consentement-${identifiant}`}>
          Recevoir aussi, deux fois par an, les prix signés de mon quartier. Facultatif.
        </label>
      </div>
      <p class="mt-4 text-xs text-[color:var(--color-ardoise)]">
        Vos coordonnées servent seulement à répondre à votre demande : Samy Santamarina vous rappelle sous 24 heures
        ouvrées pour l'avis de valeur écrit, gratuit et sans engagement. Elles ne sont ni vendues ni cédées.{' '}
        <a href="/politique-de-confidentialite" class="lien-souligne">Politique de confidentialité</a>.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <button type="button" class="bouton bouton-secondaire" data-precedent>Revenir</button>
        <button type="submit" class="bouton">Voir mon estimation</button>
      </div>
    </fieldset>

    <p class="mt-6 text-sm text-[#a4262c]" data-erreur hidden></p>
  </div>

  <div data-confirmation hidden class="py-4">
    <p class="surtitre">Demande envoyée</p>
    <p class="titre-3 mt-4" role="status">Merci, votre demande est enregistrée.</p>
    {/* Rempli dans le navigateur à l'envoi : la fourchette n'apparaît qu'une fois le contact reçu. */}
    <div class="mt-6 border-l-2 border-[color:var(--color-or)] pl-4" data-fourchette-rue hidden></div>
    <p class="mt-4 text-[color:var(--color-ardoise)]">
      Samy Santamarina vous rappelle sous 24 heures ouvrées pour convenir de la visite d'estimation.
      {' '}<span data-mention-email hidden>Un email vient de partir vers votre boîte, avec votre fourchette.</span>
    </p>
    <p class="mt-6">
      <a href={lienPhotos} rel="noopener" target="_blank" class="bouton bouton-secondaire" data-evt="estimation_photos_whatsapp">Envoyer des photos par WhatsApp</a>
    </p>
    <p class="mt-2 text-xs text-[color:var(--color-ardoise)]">Facultatif. Trois ou quatre photos suffisent à préparer la visite.</p>
  </div>
</form>
<form
  id={`${identifiant}-rappel`}
  method="POST"
  action="/api/rappel"
  data-trudaines
  data-evenement="rappel_envoye"
  data-voie-formulaire="rappel"
  hidden
>
  <input type="hidden" name="secteur" value={secteur} />
  <input type="hidden" name="origine" value={origine} />
  <input type="hidden" name="horodatage" value="" />
  <div class="absolute h-0 w-0 overflow-hidden" aria-hidden="true">
    <label for={`controle-${identifiant}-rappel`}>Ne pas remplir</label>
    <input type="text" id={`controle-${identifiant}-rappel`} name="controle" tabindex="-1" autocomplete="off" />
  </div>
  <div data-corps>
    <p class="titre-3">Samy Santamarina vous rappelle</p>
    <p class="mt-2 text-sm text-[color:var(--color-ardoise)]">Votre prénom et votre numéro suffisent.</p>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      <div>
        <label class="etiquette" for={`rappel-prenom-${identifiant}`}>Prénom</label>
        <input class="champ" id={`rappel-prenom-${identifiant}`} name="prenom" type="text" autocomplete="given-name" required />
      </div>
      <div>
        <label class="etiquette" for={`rappel-telephone-${identifiant}`}>Téléphone</label>
        <input class="champ" id={`rappel-telephone-${identifiant}`} name="telephone" type="tel" autocomplete="tel" required />
      </div>
      <div>
        <label class="etiquette" for={`rappel-moment-${identifiant}`}>Quand vous rappeler</label>
        <select class="champ" id={`rappel-moment-${identifiant}`} name="moment">
          <option>Dès que possible</option>
          <option>Le matin</option>
          <option>À midi</option>
          <option>En fin de journée</option>
          <option>Le samedi</option>
        </select>
      </div>
      <div>
        <label class="etiquette" for={`rappel-adresse-${identifiant}`}>Adresse du bien, facultatif</label>
        <input class="champ" id={`rappel-adresse-${identifiant}`} name="adresse" type="text" autocomplete="street-address" />
      </div>
    </div>
    <p class="mt-6 text-xs text-[color:var(--color-ardoise)]">
      Votre numéro sert seulement à ce rappel. <a href="/politique-de-confidentialite" class="lien-souligne">Politique de confidentialité</a>.
    </p>
    <button type="submit" class="bouton mt-8">Être rappelé</button>
    <p class="mt-6 text-sm text-[#a4262c]" data-erreur hidden></p>
  </div>
  <div data-confirmation hidden class="py-4">
    <p class="surtitre">Demande envoyée</p>
    <p class="titre-3 mt-4" role="status">Merci, Samy vous rappelle.</p>
    <p class="mt-4 text-[color:var(--color-ardoise)]">En jours ouvrés, au moment que vous avez choisi. Si c'est urgent : 06 20 46 59 12.</p>
  </div>
</form>
</div>
<script src="/js/choix-estimation.js" defer is:inline></script>
<script src="/js/fourchette-formulaire.js" defer is:inline></script>
