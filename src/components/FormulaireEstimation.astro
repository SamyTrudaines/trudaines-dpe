---
interface Props {
  secteur?: string;
  quartier?: string;
  identifiant?: string;
  /** Nom d'événement (data-evt), envoyé quand la demande aboutit. */
  evt?: string;
  /** Page d'où part la demande, transmise à l'agence : « Rue des Dames, Paris 17e ». */
  origine?: string;
}
const { secteur = '', quartier = '', identifiant = 'estimation', evt, origine = '' } = Astro.props;
const listeId = `adresses-${identifiant}`;
---
<div class="border border-[color:var(--color-trait)] bg-white p-6 md:p-10" data-choix-estimation>
{/*
  Deux voies, comme sur l'ancien site : estimer en ligne, ou être rappelé. Dans les deux cas Samy reçoit
  un email et un SMS et rappelle ; seule la seconde le promet au visiteur.
*/}
<div class="mb-8 grid grid-cols-2 border border-[color:var(--color-encre)]" role="group" aria-label="Comment souhaitez-vous procéder ?">
  <button type="button" class="choix-voie" aria-pressed="true" data-voie="en-ligne">Estimer en ligne</button>
  <button type="button" class="choix-voie" aria-pressed="false" data-voie="rappel">Être rappelé</button>
</div>
<form
  id={identifiant}
  method="POST"
  action="/api/estimation"
  data-trudaines
  data-evenement="estimation_envoyee"
  data-evt={evt}
  data-evenement-etape="estimation_etape1"
  data-formulaire-avis
  data-fourchette
  data-voie-formulaire="en-ligne"
  novalidate={false}
>
  <input type="hidden" name="secteur" value={secteur} />
  <input type="hidden" name="quartier" value={quartier} />
  <input type="hidden" name="origine" value={origine} />
  <input type="hidden" name="horodatage" value="" />
  {/* Rempli par le calculateur immédiat : l'agence voit la fourchette que le visiteur a eue sous les yeux. */}
  <input type="hidden" name="fourchette" value="" />
  <div class="absolute h-0 w-0 overflow-hidden" aria-hidden="true">
    <label for={`controle-${identifiant}`}>Ne pas remplir</label>
    <input type="text" id={`controle-${identifiant}`} name="controle" tabindex="-1" autocomplete="off" />
  </div>

  <div data-corps>
    <div class="mb-8">
      <p class="surtitre" data-compteur>Étape 1 sur 2</p>
      <div class="mt-3 h-[2px] w-full bg-[color:var(--color-trait)]" role="presentation">
        <div class="h-[2px] bg-[color:var(--color-nuit)] transition-[width] duration-200" style="width:50%" data-barre></div>
      </div>
    </div>

    <fieldset data-etape class="border-0 p-0">
      <legend class="titre-3 mb-6">Votre bien</legend>
      <div class="grid gap-6">
        <div>
          <label class="etiquette" for={`adresse-${identifiant}`}>Adresse du bien</label>
          <input
            class="champ"
            id={`adresse-${identifiant}`}
            name="adresse"
            type="text"
            required
            autocomplete="street-address"
            placeholder="12 avenue Trudaine, 75009 Paris"
            list={listeId}
            data-autocomplete-adresse
          />
          <datalist id={listeId}></datalist>
          <p class="mt-2 text-xs text-[color:var(--color-ardoise)]">
            Adresse utilisée uniquement pour l'estimation. Elle n'est jamais publiée.
          </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label class="etiquette" for={`type-${identifiant}`}>Type de bien</label>
            <select class="champ" id={`type-${identifiant}`} name="type" required>
              <option value="Appartement">Appartement</option>
              <option value="Maison">Maison</option>
              <option value="Immeuble">Immeuble</option>
              <option value="Local ou autre">Local ou autre</option>
            </select>
          </div>
          <div>
            <label class="etiquette" for={`surface-${identifiant}`}>Surface en m²</label>
            <input class="champ" id={`surface-${identifiant}`} name="surface" type="number" min="5" max="1000" required inputmode="numeric" />
          </div>
          <div>
            <label class="etiquette" for={`pieces-${identifiant}`}>Nombre de pièces</label>
            <select class="champ" id={`pieces-${identifiant}`} name="pieces" required>
              <option value="" disabled selected>Choisir</option>
              <option value="1">1 pièce</option>
              <option value="2">2 pièces</option>
              <option value="3">3 pièces</option>
              <option value="4">4 pièces</option>
              <option value="5">5 pièces</option>
              <option value="6 et plus">6 pièces et plus</option>
            </select>
          </div>
          <div>
            <label class="etiquette" for={`chambres-${identifiant}`}>Chambres</label>
            <select class="champ" id={`chambres-${identifiant}`} name="chambres" required>
              <option value="" disabled selected>Choisir</option>
              <option value="0">Aucune, studio</option>
              <option value="1">1 chambre</option>
              <option value="2">2 chambres</option>
              <option value="3">3 chambres</option>
              <option value="4">4 chambres</option>
              <option value="5 et plus">5 chambres et plus</option>
            </select>
          </div>
          <div>
            <label class="etiquette" for={`etage-${identifiant}`}>Étage</label>
            <select class="champ" id={`etage-${identifiant}`} name="etage" required>
              <option value="" disabled selected>Choisir</option>
              <option value="Rez-de-chaussée">Rez-de-chaussée</option>
              <option value="1er">1er étage</option>
              <option value="2e à 4e">2e à 4e étage</option>
              <option value="5e et plus">5e étage et plus</option>
              <option value="Dernier étage">Dernier étage</option>
            </select>
          </div>
          <div>
            <label class="etiquette" for={`ascenseur-${identifiant}`}>Ascenseur</label>
            <select class="champ" id={`ascenseur-${identifiant}`} name="ascenseur" required>
              <option value="" disabled selected>Choisir</option>
              <option value="Oui">Oui</option>
              <option value="Non">Non</option>
            </select>
          </div>
        </div>

        <div>
          <label class="etiquette" for={`horizon-${identifiant}`}>Horizon de vente</label>
          <select class="champ" id={`horizon-${identifiant}`} name="horizon" required>
            <option value="Moins de 3 mois">Moins de 3 mois</option>
            <option value="3 à 6 mois">3 à 6 mois</option>
            <option value="Plus tard">Plus tard, je prépare mon projet</option>
          </select>
        </div>
      </div>
      <button type="button" class="bouton mt-8 w-full sm:w-auto" data-suivant>Continuer</button>
    </fieldset>

    <fieldset data-etape class="border-0 p-0">
      <legend class="titre-3 mb-6">Vos coordonnées</legend>

      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label class="etiquette" for={`prenom-${identifiant}`}>Prénom</label>
          <input class="champ" id={`prenom-${identifiant}`} name="prenom" type="text" autocomplete="given-name" required />
        </div>
        <div>
          <label class="etiquette" for={`nom-${identifiant}`}>Nom, facultatif</label>
          <input class="champ" id={`nom-${identifiant}`} name="nom" type="text" autocomplete="family-name" />
        </div>
        <div>
          <label class="etiquette" for={`email-${identifiant}`}>Adresse email</label>
          <input class="champ" id={`email-${identifiant}`} name="email" type="email" autocomplete="email" required />
        </div>
        <div>
          <label class="etiquette" for={`telephone-${identifiant}`}>Téléphone</label>
          <input class="champ" id={`telephone-${identifiant}`} name="telephone" type="tel" autocomplete="tel" required />
        </div>
      </div>
      <div class="mt-6">
        <label class="etiquette" for={`message-${identifiant}`}>Précisions utiles, facultatif</label>
        <textarea class="champ" id={`message-${identifiant}`} name="message" rows="3" placeholder="Travaux récents, vue, exposition, contexte de la vente"></textarea>
      </div>
      <div class="mt-6 flex items-start gap-3">
        <input class="mt-1 h-5 w-5 shrink-0 accent-[color:var(--color-nuit)]" id={`consentement-${identifiant}`} name="consentement" type="checkbox" required value="oui" />
        <label class="text-sm text-[color:var(--color-ardoise)]" for={`consentement-${identifiant}`}>
          J'accepte d'être recontacté par Trudaines au sujet de ma demande. Mes données ne sont ni vendues ni cédées.{' '}
          <a href="/politique-de-confidentialite" class="lien-souligne">Politique de confidentialité</a>.
        </label>
      </div>
      <p class="mt-6 text-sm text-[color:var(--color-ardoise)]">
        Votre fourchette s'affiche dès l'envoi, calculée sur les ventes signées de votre rue. Samy Santamarina
        vous rappelle sous 24 heures ouvrées pour l'avis de valeur écrit, gratuit et sans engagement.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <button type="button" class="bouton bouton-secondaire" data-precedent>Revenir</button>
        <button type="submit" class="bouton">Voir ma fourchette de prix</button>
      </div>
    </fieldset>

    <p class="mt-6 text-sm text-[#a4262c]" data-erreur hidden></p>
  </div>

  <div data-confirmation hidden class="py-4">
    <p class="surtitre">Demande envoyée</p>
    <h2 class="titre-3 mt-4">Merci, votre demande est enregistrée.</h2>
    {/* Rempli dans le navigateur à l'envoi : la fourchette n'apparaît qu'une fois le contact reçu. */}
    <div class="mt-6 border-l-2 border-[color:var(--color-or)] pl-4" data-fourchette-rue hidden></div>
    <p class="mt-4 text-[color:var(--color-ardoise)]">
      Samy Santamarina vous rappelle sous 24 heures ouvrées pour convenir de la visite d'estimation.
      Un email de confirmation vient de partir vers votre boîte.
    </p>
  </div>
</form>
<form
  id={`${identifiant}-rappel`}
  method="POST"
  action="/api/rappel"
  data-trudaines
  data-evenement="rappel_envoye"
  data-voie-formulaire="rappel"
  hidden
>
  <input type="hidden" name="secteur" value={secteur} />
  <input type="hidden" name="origine" value={origine} />
  <input type="hidden" name="horodatage" value="" />
  <div class="absolute h-0 w-0 overflow-hidden" aria-hidden="true">
    <label for={`controle-${identifiant}-rappel`}>Ne pas remplir</label>
    <input type="text" id={`controle-${identifiant}-rappel`} name="controle" tabindex="-1" autocomplete="off" />
  </div>
  <div data-corps>
    <p class="titre-3">Samy Santamarina vous rappelle</p>
    <p class="mt-2 text-sm text-[color:var(--color-ardoise)]">Deux champs suffisent. Le reste se dit au téléphone.</p>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      <div>
        <label class="etiquette" for={`rappel-prenom-${identifiant}`}>Prénom</label>
        <input class="champ" id={`rappel-prenom-${identifiant}`} name="prenom" type="text" autocomplete="given-name" required />
      </div>
      <div>
        <label class="etiquette" for={`rappel-telephone-${identifiant}`}>Téléphone</label>
        <input class="champ" id={`rappel-telephone-${identifiant}`} name="telephone" type="tel" autocomplete="tel" required />
      </div>
      <div>
        <label class="etiquette" for={`rappel-moment-${identifiant}`}>Quand vous rappeler</label>
        <select class="champ" id={`rappel-moment-${identifiant}`} name="moment">
          <option>Dès que possible</option>
          <option>Le matin</option>
          <option>À midi</option>
          <option>En fin de journée</option>
          <option>Le samedi</option>
        </select>
      </div>
      <div>
        <label class="etiquette" for={`rappel-adresse-${identifiant}`}>Adresse du bien, facultatif</label>
        <input class="champ" id={`rappel-adresse-${identifiant}`} name="adresse" type="text" autocomplete="street-address" />
      </div>
    </div>
    <div class="mt-6 flex items-start gap-3">
      <input class="mt-1 h-5 w-5 shrink-0 accent-[color:var(--color-nuit)]" id={`rappel-consentement-${identifiant}`} name="consentement" type="checkbox" required value="oui" />
      <label class="text-sm text-[color:var(--color-ardoise)]" for={`rappel-consentement-${identifiant}`}>
        J'accepte d'être rappelé par Trudaines au sujet de ma demande. <a href="/politique-de-confidentialite" class="lien-souligne">Politique de confidentialité</a>.
      </label>
    </div>
    <button type="submit" class="bouton mt-8">Être rappelé</button>
    <p class="mt-6 text-sm text-[#a4262c]" data-erreur hidden></p>
  </div>
  <div data-confirmation hidden class="py-4">
    <p class="surtitre">Demande envoyée</p>
    <h2 class="titre-3 mt-4">Merci, Samy vous rappelle.</h2>
    <p class="mt-4 text-[color:var(--color-ardoise)]">En jours ouvrés, au moment que vous avez choisi. Si c'est urgent : 06 20 46 59 12.</p>
  </div>
</form>
</div>
<script src="/js/choix-estimation.js" defer is:inline></script>
<script src="/js/fourchette-formulaire.js" defer is:inline></script>
