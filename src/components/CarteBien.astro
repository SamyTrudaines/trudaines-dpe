---
import { euros, nombre, libelleStatut } from '../data/site';
interface Props { bien: any; priorite?: boolean }
const { bien, priorite = false } = Astro.props;
const d = bien.data;
const photo = d.photos[0];
---
<article
  class="group"
  data-bien
  data-secteur={d.secteur}
  data-quartier={d.quartier}
  data-prix={d.prix}
  data-surface={d.surfaceCarrez}
  data-pieces={d.pieces}
>
  <a href={`/bien/${bien.id}`} class="block no-underline">
    <div class="relative aspect-[4/3] overflow-hidden bg-creme">
      {photo ? (
        <img
          src={photo.src}
          alt={photo.alt || d.titre}
          width="800"
          height="600"
          loading={priorite ? 'eager' : 'lazy'}
          fetchpriority={priorite ? 'high' : 'auto'}
          decoding="async"
          class="h-full w-full object-cover transition-opacity duration-300 group-hover:opacity-90"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center text-sm text-gris">Photos en cours</div>
      )}
      {d.statut !== 'a-vendre' && (
        <span class="absolute left-0 top-0 bg-encre px-3 py-2 text-xs uppercase tracking-widest text-white">
          {libelleStatut[d.statut]}
        </span>
      )}
    </div>
    <div class="mt-5">
      <p class="surtitre">{d.quartier}, Paris {d.arrondissement}</p>
      <h3 class="mt-2 text-lg">{d.titre}</h3>
      <p class="mt-2 text-sm text-gris">
        {nombre(d.surfaceCarrez)} m² · {d.pieces} pièces{d.chambres ? ` · ${d.chambres} chambres` : ''}{d.etage ? ` · ${d.etage}` : ''}
      </p>
      <p class="mt-3 text-base">{euros(d.prix)}</p>
    </div>
  </a>
</article>
