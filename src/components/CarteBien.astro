---
import { prixAffiche, nombre, libelleStatut } from '../lib/format';
import { jeuPhoto, TAILLES_CARTE } from '../lib/images';
interface Props {
  id: string;
  titre: string;
  quartier: string;
  arrondissement: string;
  prixBien: number;
  surface: number;
  pieces: number;
  statut: string;
  photo?: { src: string; alt: string };
  chargement?: 'lazy' | 'eager';
  /** Vrai pour un mandat archivé : la carte ne porte alors aucun prix. */
  sansPrix?: boolean;
}
const { id, titre, quartier, arrondissement, prixBien, surface, pieces, statut, photo, chargement = 'lazy', sansPrix = false } = Astro.props;
---
<article class="group">
  <a href={`/bien/${id}`} class="block no-underline">
    <div class="relative aspect-[4/3] overflow-hidden bg-[color:var(--color-papier)]">
      {photo ? (
        <img
          src={jeuPhoto(photo.src).src}
          srcset={jeuPhoto(photo.src).srcset}
          sizes={TAILLES_CARTE}
          alt={photo.alt}
          width="800"
          height="600"
          loading={chargement}
          decoding="async"
          class="h-full w-full object-cover transition-opacity duration-200 group-hover:opacity-90"
        />
      ) : (
        <span class="flex h-full w-full items-center justify-center text-xs uppercase tracking-[0.2em] text-[color:var(--color-ardoise)]">
          Photographies à venir
        </span>
      )}
      {statut !== 'a-vendre' && (
        <span class="absolute left-0 top-0 bg-[color:var(--color-nuit)] px-3 py-2 text-[0.6875rem] font-semibold uppercase tracking-[0.16em] text-white">
          {libelleStatut[statut]}
        </span>
      )}
    </div>
    <p class="surtitre mt-5">{quartier} · {arrondissement}</p>
    <h3 class="titre-3 mt-2 text-[color:var(--color-encre)]">{titre}</h3>
    <p class="mt-3 text-sm text-[color:var(--color-ardoise)]">
      {nombre(surface)} m² · {pieces} {pieces > 1 ? 'pièces' : 'pièce'}
    </p>
    {sansPrix ? (
      <p class="mt-2 text-sm uppercase tracking-[0.14em] text-[color:var(--color-ardoise)]">
        {statut === 'vendu' ? 'Vendu' : 'Mandat présenté'}
      </p>
    ) : (
      <p class="mt-2 text-base font-semibold text-[color:var(--color-nuit)]">{prixAffiche(prixBien)}</p>
    )}
  </a>
</article>
