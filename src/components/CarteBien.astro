---
import { prixAffiche, libelleStatut, lieuBien, faitsBien } from '../lib/format';
import { jeuPhoto, TAILLES_CARTE, TAILLES_VITRINE } from '../lib/images';
interface Props {
  id: string;
  titre: string;
  quartier: string;
  arrondissement: string;
  ville?: string;
  prixBien: number;
  surface: number;
  pieces: number;
  chambres?: number;
  /** Accroche de vitrine : remplace le titre, qui répète pièces, surface et lieu. */
  accroche?: string;
  statut: string;
  photo?: { src: string; alt: string };
  chargement?: 'lazy' | 'eager';
  /** Vrai pour un mandat archivé : la carte ne porte alors aucun prix. */
  sansPrix?: boolean;
  /** Vrai dans la vitrine de l'accueil : image plus grande, format plus large. */
  vitrine?: boolean;

  /**
   * Portée de la page qui affiche la carte. Une page profonde, quartier ou
   * voie, reçoit l'AVIF ; une page de vitrine reçoit la plus grande
   * définition en WebP.
   */
  portee?: 'vitrine' | 'profonde';
  /** Nom d'événement (data-evt) du clic sur la carte. */
  evt?: string;
  /** Mention courte d'un bien à vendre, « Nouveau prix » par exemple. */
  mention?: string;
}
const { id, titre, quartier, arrondissement, ville = 'Paris', prixBien, surface, pieces, statut, photo, chargement = 'lazy', sansPrix = false, vitrine = false, portee = 'vitrine', evt, mention, chambres, accroche } = Astro.props;
const pastille = statut !== 'a-vendre' ? libelleStatut[statut] : sansPrix ? undefined : mention;
const jeu = photo ? jeuPhoto(photo.src, portee) : undefined;
const tailles = vitrine ? TAILLES_VITRINE : TAILLES_CARTE;
const cadre = vitrine ? 'aspect-[3/2]' : 'aspect-[4/3]';
const intitule = accroche ?? titre;
const faits = faitsBien({ pieces, chambres, surface }, accroche ? '' : titre);
---
<article class="group">
  <a href={`/bien/${id}`} data-evt={evt} class="block no-underline">
    <div class={`relative overflow-hidden bg-[color:var(--color-papier)] ${cadre}`}>
      {photo && jeu ? (
        <picture>
          {jeu.avif && <source type="image/avif" srcset={jeu.avif} sizes={tailles} />}
        <img
          src={jeu.src}
          srcset={jeu.srcset}
          sizes={tailles}
          alt={photo.alt}
          width={vitrine ? 1600 : 800}
          height={vitrine ? 1067 : 600}
          loading={chargement}
          decoding="async"
          class="h-full w-full object-cover transition-opacity duration-200 group-hover:opacity-90"
        />
        </picture>
      ) : (
        <span class="flex h-full w-full items-center justify-center text-xs uppercase tracking-[0.2em] text-[color:var(--color-ardoise)]">
          Photographies à venir
        </span>
      )}
      {pastille && (
        <span class="absolute left-0 top-0 bg-[color:var(--color-nuit)] px-3 py-2 text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-white">
          {pastille}
        </span>
      )}
    </div>
    <p class="surtitre mt-5">{quartier} · {lieuBien(arrondissement, ville)}</p>
    <h3 class={`titre-3 mt-2 text-[color:var(--color-encre)] ${vitrine ? 'text-[1.35rem] md:text-[1.6rem]' : ''}`}>{intitule}</h3>
    {faits && <p class="mt-3 text-sm text-[color:var(--color-ardoise)]">{faits}</p>}
    {sansPrix ? (
      <p class="mt-2 text-sm uppercase tracking-[0.14em] text-[color:var(--color-ardoise)]">
        {statut === 'vendu' ? 'Vendu' : 'Mandat présenté'}
      </p>
    ) : (
      <p class="mt-2 text-base font-semibold text-[color:var(--color-nuit)]">{prixAffiche(prixBien)}</p>
    )}
  </a>
</article>
