---
/**
 * Où part une annonce Trudaines : les supports de src/data/diffusion.ts, groupés par public.
 * Affiché sur /vendre ; l'article « diffusion » en donne le détail.
 */
import { diffusion, nombreSupports } from '../data/diffusion';
---
<section class="section filet" aria-labelledby="diffusion">
  <div class="conteneur">
    <p class="surtitre">Diffusion</p>
    <h2 id="diffusion" class="titre-2 mt-6 max-w-2xl">Votre bien présenté sur {nombreSupports} supports, en France et à l'international</h2>
    <p class="mt-6 max-w-2xl text-[color:var(--color-ardoise)]">
      Une seule annonce, écrite et photographiée par nous, part le même jour vers les grands portails, les sites du luxe
      et les réseaux étrangers. Les sites du luxe reçoivent les biens de prestige ; le reporting que vous recevez montre,
      support par support, ce que votre annonce a obtenu.
    </p>
    <div class="mt-12 grid gap-x-12 gap-y-14 md:grid-cols-2">
      {diffusion.map((g) => (
        <div>
          <h3 class="titre-3">{g.titre}</h3>
          <p class="mt-3 text-sm text-[color:var(--color-ardoise)]">{g.texte}</p>
          <dl class="mt-6 grid gap-4">
            {g.supports.map((s) => (
              <div>
                <dt class="font-medium text-[color:var(--color-encre)]">{s.nom}</dt>
                <dd class="mt-1 text-sm text-[color:var(--color-ardoise)]">{s.texte}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))}
    </div>
    <p class="mt-12"><a href="/panorama/diffusion-annonce-portails-france-international-luxe">Comment nous choisissons les supports de votre bien</a></p>
  </div>
</section>
