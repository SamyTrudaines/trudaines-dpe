---
/**
 * Logo de la marque, tracé depuis le fichier vectoriel de la charte : TRUD, AI
 * en orange, NES, puis IMMOBILIER en dessous.
 *
 * Le mot suit la couleur du texte qui l'entoure : encre sur fond clair, blanc
 * sur une photographie, sans second fichier. Le AI garde l'orange de la marque
 * en toutes circonstances. Un logotype échappe au critère de contraste des
 * WCAG ; le nom complet est donné aux lecteurs d'écran par le libellé.
 */
import { logo } from '../data/logo';

interface Props { taille?: 'normal' | 'grand'; sousTitre?: boolean; }
const { taille = 'normal', sousTitre = true } = Astro.props;
---
<span class={`logo ${taille === 'grand' ? 'logo-grand' : ''}`}>
  <svg
    viewBox={sousTitre ? logo.cadreTout : logo.cadreMot}
    role="img"
    aria-label="Trudaines Immobilier"
    focusable="false"
  >
    <path class="logo-mot" fill="currentColor" fill-rule="evenodd" d={logo.mot} />
    <path class="logo-ai" fill-rule="evenodd" d={logo.ai} />
    {sousTitre && <path class="logo-sous" fill="currentColor" fill-rule="evenodd" d={logo.sous} />}
  </svg>
</span>
