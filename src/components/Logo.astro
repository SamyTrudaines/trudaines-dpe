---
/**
 * Logo de la marque : TRUD, AI en orange, NES, puis IMMOBILIER en dessous.
 *
 * L'orange est celui du fichier de marque, sans correction de contraste : un
 * logotype échappe au critère de contraste des WCAG, et le mot reste entier et
 * lisible sans la couleur.
 *
 * Les deux lettres colorées se lisent « AI » par accident heureux du nom : c'est
 * le sens du logo, il est donc conservé tel quel. L'orange n'y porte pas
 * d'information, le mot reste entier et lisible sans lui, et l'attribut de
 * libellé accessible donne le nom complet aux lecteurs d'écran.
 */
interface Props { taille?: 'normal' | 'grand'; sousTitre?: boolean; }
const { taille = 'normal', sousTitre = true } = Astro.props;
const classeMot = taille === 'grand' ? 'text-3xl md:text-4xl' : 'text-xl md:text-[1.375rem]';
---
<span class="inline-flex flex-col leading-none" aria-label="Trudaines Immobilier" role="img">
  <span
    class={`font-[family-name:var(--font-texte)] font-semibold tracking-[0.2em] text-[color:var(--color-encre)] ${classeMot}`}
    aria-hidden="true"
  >TRUD<span class="text-[color:var(--color-or)]">AI</span>NES</span>
  {sousTitre && (
    <span
      class="mt-1.5 self-center text-[0.5rem] font-medium uppercase tracking-[0.42em] text-[color:var(--color-ardoise)] md:text-[0.5625rem]"
      aria-hidden="true"
    >
      Immobilier
    </span>
  )}
</span>
