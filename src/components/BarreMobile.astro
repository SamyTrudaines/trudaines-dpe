---
import { cabinet } from '../data/site';
---
<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-ligne bg-white lg:hidden">
  <a href="/estimation" class="flex min-h-14 items-center justify-center gap-2 border-r border-ligne text-sm no-underline">Estimer</a>
  <a href={`tel:${cabinet.telephoneLien}`} class="flex min-h-14 items-center justify-center gap-2 border-r border-ligne text-sm no-underline" data-evenement="clic_telephone">Appeler</a>
  <a
    href={`https://wa.me/${cabinet.whatsapp}`}
    class="flex min-h-14 items-center justify-center gap-2 text-sm no-underline"
    rel="noopener"
    target="_blank"
    data-evenement="clic_whatsapp"
  >WhatsApp</a>
</div>
<div class="h-14 lg:hidden" aria-hidden="true"></div>
