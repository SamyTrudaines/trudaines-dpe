---
import type { CollectionEntry } from 'astro:content';
import FormulaireGuide from './FormulaireGuide.astro';
import { moisAnnee } from '../lib/entonnoir';

/**
 * Le livre blanc le plus pertinent pour la page, avec sa date d'édition et la
 * promesse de la prochaine : l'inscription aux mises à jour se fait par la case
 * du formulaire, et se confirme par email quand le double opt-in est configuré
 * côté Brevo (functions/api/guide.js).
 */
interface Props {
  guide: CollectionEntry<'guides'>;
  /** Page d'où part le téléchargement, transmise au cabinet. */
  contexte: string;
  /** Noms d'événements (data-evt) de l'envoi réussi, séparés par une espace. */
  evt: string;
  identifiant: string;
}
const { guide, contexte, evt, identifiant } = Astro.props;
const { titre, chapo, sommaire, pages, edition, prochaineEdition, slug } = guide.data;
---
<section id="livre-blanc" class="section filet" aria-labelledby="titre-livre-blanc">
  <div class="conteneur grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-start">
    <div>
      <p class="surtitre marque-filet">Le livre blanc</p>
      <h2 id="titre-livre-blanc" class="titre-2 mt-6">{titre}</h2>
      <p class="mt-6 text-[color:var(--color-ardoise)]">{chapo}</p>
      {sommaire.length > 0 && (
        <ul class="mt-6 space-y-2 text-sm text-[color:var(--color-ardoise)]">
          {sommaire.map((s) => (
            <li class="flex gap-3"><span aria-hidden="true">·</span><span>{s}</span></li>
          ))}
        </ul>
      )}
      <p class="mt-6 text-xs font-semibold uppercase tracking-[0.12em] text-[color:var(--color-ardoise)]">
        {pages > 0 ? `${pages} pages · PDF` : 'PDF'}{edition ? ` · Édition de ${moisAnnee(edition)}` : ''}
      </p>
      <p class="mt-3 text-sm text-[color:var(--color-encre)]">
        {prochaineEdition ? `Prochaine édition : ${prochaineEdition}. ` : ''}Cochez la case du formulaire et vous la recevez dès sa parution.
      </p>
    </div>
    <FormulaireGuide guide={slug} titreGuide={titre} identifiant={identifiant} evt={evt} contexte={contexte} />
  </div>
</section>
