---
import { nombre } from '../lib/format';
import { termesDeRecherche, type Rue } from '../lib/rues';

/**
 * Les rues d'un quartier, une ligne par rue : nom, prix médian au mètre carré,
 * nombre de ventes, lien vers la page de la rue. Un tableau, parce que ce sont
 * trois mesures de la même rue ; le nom de rue en est l'en-tête de ligne.
 *
 * L'ordre est celui d'un annuaire de voies (rues déjà rangées par l'appelant).
 * Le champ de recherche et les boutons de tri sont branchés par
 * public/js/filtre-rues.js ; sans lui, la liste est complète et dans l'ordre.
 */
interface Props {
  rues: Rue[];
  identifiant: string;
  /** Nom d'événement (data-evt) du clic sur une rue. */
  evtRue: string;
  /** Légende lue par les lecteurs d'écran. */
  legende: string;
  /** Où chercher quand aucune rue de la liste ne correspond. */
  vers: { href: string; libelle: string };
}
const { rues, identifiant, evtRue, legende, vers } = Astro.props;
const euros = (valeur: number) => `${nombre(valeur)} €`;
---
<div id={identifiant}>
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
    <p class="text-sm text-[color:var(--color-ardoise)]" data-compte aria-live="polite">{rues.length} {rues.length > 1 ? 'rues' : 'rue'}</p>
    <div data-tris hidden aria-controls={identifiant} class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
      <span class="text-[color:var(--color-ardoise)]">Trier</span>
      <button type="button" data-tri="nom" aria-pressed="true" class="border-b border-transparent py-2 aria-pressed:border-[color:var(--color-encre)] aria-pressed:font-semibold">De A à Z</button>
      <button type="button" data-tri="prix" aria-pressed="false" class="border-b border-transparent py-2 aria-pressed:border-[color:var(--color-encre)] aria-pressed:font-semibold">Du plus cher au moins cher</button>
    </div>
  </div>

  <table class="mt-2 w-full border-collapse text-left tabular-nums">
    <caption class="sr-only">{legende}</caption>
    <thead>
      <tr class="border-b border-[color:var(--color-encre)] text-xs uppercase tracking-[0.08em] text-[color:var(--color-ardoise)] sm:tracking-[0.14em]">
        <th scope="col" class="py-2 pr-3 font-semibold">Rue</th>
        <th scope="col" class="py-2 pr-3 text-right font-semibold"><span class="sm:hidden">Médiane au m²</span><span class="hidden sm:inline">Prix médian au m²</span></th>
        <th scope="col" class="py-2 text-right font-semibold">Ventes</th>
      </tr>
    </thead>
    <tbody>
      {rues.map((r, rang) => (
        <tr
          data-rue
          data-nom={termesDeRecherche(r.nom)}
          data-ordre={rang}
          data-prix={r.mediane}
          class="border-b border-[color:var(--color-trait)] hover:bg-[color:var(--color-papier)] focus-within:bg-[color:var(--color-or-clair)]"
        >
          <th scope="row" class="p-0 text-base font-normal">
            <a
              href={`/prix-immobilier/${r.slug}`}
              data-evt={evtRue}
              class="block min-h-[3.25rem] py-1.5 pr-3 text-[color:var(--color-encre)] no-underline hover:underline"
            >{r.nom}</a>
          </th>
          <td class="whitespace-nowrap py-1.5 pr-3 text-right text-base font-semibold text-[color:var(--color-encre)]">{euros(r.mediane)}</td>
          <td class="py-1.5 text-right text-sm text-[color:var(--color-ardoise)]">{r.ventes}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <p data-vide hidden class="mt-4 border-t border-[color:var(--color-trait)] pt-4 text-[color:var(--color-ardoise)]">
    Aucune rue de cette liste ne porte ce nom.{' '}
    <a href={vers.href} class="lien-souligne">{vers.libelle}</a>.
  </p>
</div>
