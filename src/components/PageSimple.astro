---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

interface Props {
  identifiant: string;
  url: string;
  surtitre?: string;
  ariane?: { nom: string; url: string }[];
  sansCta?: boolean;
  large?: boolean;
}

const { identifiant, url, surtitre = '', ariane, sansCta = false, large = false } = Astro.props;
const page = await getEntry('pages', identifiant);
if (!page) throw new Error(`Page introuvable dans la collection pages : ${identifiant}`);
const { Content } = await render(page);
const d = page.data;
---
<Base
  title={d.titleSeo}
  description={d.metaDescription}
  ariane={ariane ?? [{ nom: d.titre, url }]}
  sansCta={sansCta}
  image={d.image}
>
  <section class="border-b border-ligne">
    <div class="conteneur py-16 lg:py-20">
      {surtitre && <p class="surtitre">{surtitre}</p>}
      <h1 class="mt-6 max-w-3xl text-3xl leading-tight lg:text-4xl">{d.titre}</h1>
      {d.chapo && <p class="mt-6 max-w-2xl text-lg text-gris">{d.chapo}</p>}
    </div>
  </section>

  {d.image && (
    <section class="conteneur pt-10">
      <img src={d.image} alt={d.imageAlt} width="1600" height="900" fetchpriority="high" decoding="async" class="aspect-[16/9] w-full object-cover" />
    </section>
  )}

  <section class={large ? 'conteneur py-16 lg:py-24' : 'conteneur-etroit py-16 lg:py-24'}>
    <div class="prose-trudaines max-w-none">
      <Content />
    </div>
  </section>

  <slot />
</Base>
