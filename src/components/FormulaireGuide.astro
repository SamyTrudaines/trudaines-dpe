---
import ConsentementRgpd from './ConsentementRgpd.astro';
import Confirmation from './Confirmation.astro';
interface Props { guide: string; titre: string; identifiant: string }
const { guide, titre, identifiant } = Astro.props;
---
<form
  action="/api/guide"
  method="post"
  data-formulaire="guide"
  data-evenement-succes="guide_telecharge"
  class="relative border border-ligne bg-white p-6"
>
  <input type="hidden" name="guide" value={guide} />
  <input type="hidden" name="titre" value={titre} />
  <div data-champs>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label class="etiquette" for={`guide-email-${identifiant}`}>Adresse email</label>
        <input class="champ" id={`guide-email-${identifiant}`} name="email" type="email" required autocomplete="email" />
      </div>
      <div>
        <label class="etiquette" for={`guide-tel-${identifiant}`}>Téléphone</label>
        <input class="champ" id={`guide-tel-${identifiant}`} name="telephone" type="tel" required autocomplete="tel" />
      </div>
    </div>
    <div class="mt-5"><ConsentementRgpd id={`consentement-guide-${identifiant}`} /></div>
    <button type="submit" class="bouton mt-6 w-full sm:w-auto">Recevoir le guide</button>
  </div>
  <Confirmation
    titre="Le guide vous attend dans votre boîte mail"
    texte="Vous pouvez répondre directement à cet email si une question reste ouverte."
  />
</form>
