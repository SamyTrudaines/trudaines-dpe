# Variables à créer dans Cloudflare Pages, onglet Settings puis Variables and Secrets.
# Ne jamais mettre ces valeurs dans le dépôt.

# --- Brevo : emails et CRM ---------------------------------------------------
BREVO_API_KEY=xkeysib-votre-cle
BREVO_SENDER_EMAIL=contact@trudaines.com
BREVO_SENDER_NOM=Trudaines Immobilier
NOTIFICATION_EMAIL=samy.santamarina@trudaines.com

# Identifiants numériques des listes Brevo (Contacts puis Listes)
BREVO_LISTE_VENDEURS=
BREVO_LISTE_ACHETEURS=
BREVO_LISTE_CANDIDATS=
BREVO_LISTE_TELECHARGEMENTS=

# --- Site --------------------------------------------------------------------
SITE_URL=https://www.trudaines.com

# --- Mesure d'audience, visible côté navigateur ------------------------------
PUBLIC_GA4_ID=

# --- Avis Google, utilisés seulement par scripts/importer-avis-google.mjs -----
# Clé Places API (New) restreinte à cette seule API, et identifiant de la fiche.
# L'identifiant se retrouve avec :
#   node scripts/importer-avis-google.mjs --recherche "Trudaines Immobilier Paris 18"
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- Connexion au back office /admin -----------------------------------------
GITHUB_OAUTH_ID=
GITHUB_OAUTH_SECRET=
