# En-têtes servis par Cloudflare Pages. Voir DEPLOIEMENT.md pour le reste de la
# configuration côté tableau de bord, limitation de débit comprise.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-site
  X-Permitted-Cross-Domain-Policies: none
  # La politique de sécurité du contenu des pages est posée par Astro dans un
  # meta http-equiv, avec l'empreinte de chaque script produit à la
  # construction : voir la clé security.csp de astro.config.mjs. La répéter ici
  # sans ces empreintes bloquerait les scripts du site, les deux politiques
  # s'appliquant par intersection.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000

/fiches/*
  Cache-Control: public, max-age=3600

/guides/*
  Cache-Control: public, max-age=3600

# Le back office charge Decap depuis un CDN et parle à l'API GitHub : sa
# politique est donc distincte de celle du site, et volontairement plus large.
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net; connect-src 'self' https://api.github.com https://unpkg.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; form-action 'self'

# Les réponses des fonctions /api ne passent pas par ce fichier : Cloudflare
# Pages ne l'applique qu'aux fichiers statiques. Leurs en-têtes, et le refus
# des envois venus d'un autre site, sont posés par functions/api/_middleware.js.
